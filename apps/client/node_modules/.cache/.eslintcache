span>\n                                              <h4\n                                                style={{\n                                                  textTransform: \"Capitalize\",\n                                                }}\n                                              >\n                                                {this.state\n                                                  .deal_regular_end_date\n                                                  ? moment(\n                                                      this.state\n                                                        .deal_regular_end_date\n                                                    ).format(\"MMM DD, YYYY\")\n                                                  : \"\"}\n                                              </h4>\n                                            </div>\n                                            <div className=\"info\">\n                                              <span> Min Investment</span>\n                                              <h4>₹ 1,00,000</h4>\n                                            </div>\n                                            <div className=\"info\">\n                                              <span>Pre-Money Valuation</span>\n                                              <h4>₹ 40 Cr.</h4>\n                                            </div>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                    <h1\n                                      style={{\n                                        paddingBottom: \"0px\",\n                                        marginTop: \"20px\",\n                                      }}\n                                    >\n                                      Company Details\n                                    </h1>\n                                    <section\n                                      className=\"deal-about-artment-section\"\n                                      style={{ marginTop: \"50px\" }}\n                                    >\n                                      <div className=\"container\">\n                                        <div className=\"row\">\n                                          <div className=\"col-lg-12\">\n                                            <div className=\"info\">\n                                              <span>Legal Name</span>\n                                              <h4>\n                                                Transbnk Solutions Pvt. Ltd.\n                                              </h4>\n                                            </div>\n                                            <div className=\"info\">\n                                              <span>Status</span>\n                                              <h4>Private - Active</h4>\n                                            </div>\n                                            <div className=\"info\">\n                                              <span>Employees</span>\n                                              <h4>16</h4>\n                                            </div>\n                                            <div className=\"info\">\n                                              <span>Website</span>\n                                              <h4>\n                                                <a\n                                                  style={{\n                                                    color: \"rgb(7, 211, 252)\",\n                                                  }}\n                                                  href=\"https://transbnk.co.in/\"\n                                                  target=\"_blank\"\n                                                >\n                          