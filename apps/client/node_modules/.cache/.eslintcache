                                                                 ) : (\n                                                                    <>\n                                                                      {item.user_paid ==\n                                                                        true && (\n                                                                        <img\n                                                                          src=\"./paid.png\"\n                                                                          style={{\n                                                                            maxWidth: 20,\n                                                                          }}\n                                                                        />\n                                                                      )}\n                                                                    </>\n                                                                  )}\n                                                                </>\n                                                              ) : (\n                                                                <>\n                                                                  {this.state\n                                                                    .check_membership_type ==\n                                                                    \"regular\" &&\n                                                                    item.regular_price !=\n                                                                      \"0\" &&\n                                                                    item.regular_price !=\n                                                                      \"\" &&\n                                                                    item.user_paid ==\n                                                                      false && (\n                                                                      <Checkbox\n                                                                        onChange={() =>\n                                                                          this.show_selected_checkbox(\n                                                                            item\n                                                                          )\n                                                                        }\n                                                                        value={\n                                                                          item.selected\n                                                                        }\n                                                                      ></Checkbox>\n                                                                    )}\n                                                                </>\n                                                              )}\n                                                            </>\n                                                          )}\n                                                        </td> */}\n                                                        <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {index + 1}\n                                                        </td>\n                                                        <td\n                                                          style={{ width: 140 }}\n                                                        >\n                                                          {item.docname}\n                                                        </td>\n                                                        <td\n                  