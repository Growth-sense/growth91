  marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/12.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/13.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/14.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/15.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/16.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/17.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/18.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/19.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/20.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/21.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/22.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                                <img\n                                  src=\"./assets/images/deals-details/TransBank/pitch/23.jpg\"\n                                  style={{\n                                    width: \"100%\",\n                                    marginBottom: \"40px\",\n                                    maxWidth: \"837px\",\n                                    display: \"flex\",\n                                    justifyContent: \"center\",\n                                    margin: \"0 auto 40px auto\",\n                                  }}\n                                />\n                              </div>\n                            </div>\n                            {/* start */}\n\n                            <div\n                              className=\"deals-page\"\n                              style={{\n                                marginTop: \"50px !important\",\n                              }}\n                            >\n                              <div className=\"tab-wrapper\">\n                                <div className=\"container\">\n                                  <div className=\"row\">\n                                    <div className=\"col-lg-12\">\n                                      <Tabs defaultActiveKey=\"1\" centered>\n                                        <TabPane tab=\"FAQ\" key=\"1\">\n                                          <section\n                                            className=\"faq-section\"\n                                            style={{\n                                              margin: \"0px\",\n                                              padding: \"0px\",\n                                              background: \"none\",\n                                            }}\n                                          >\n                                            <div className=\"\">\n                                              <div className=\"row\">\n                                                <div className=\"col-lg-12 col-md-12 col-sm-12 m-auto\">\n                                                  <h1 className=\"text-center mb-4\">\n                                                    About {this.state.deal_name}\n                                                  </h1>\n                                                  <Collapse\n                                                    // defaultActiveKey={['1']}\n                                                    onChange={this.callback1}\n                                                    expandIconPosition=\"left\"\n                                                    accordion\n                                                  >\n                                                    <Panel\n                                                      header=\"What is the Transbnk value proposition?\"\n                                                      key=\"1\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        B2B Lending Ecosystem\n                                                        relys on Manual\n                                                        activities, processes\n                                                        and traditional\n                                                        methodology from\n                                                        sanction to\n                                                        disbursement. Innovation\n                                                        in Payment space had\n                                                        reduced cash cycle for\n                                                        B2C transactions, but\n                                                        Transaction Banking &\n                                                        B2B Payment Automations\n                                                        had limited success. We\n                                                        are aiming solving the\n                                                        same with Domain\n                                                        expertise of 60+ years\n                                                        of cumulative experience\n                                                        in Transaction Banking.\n                                                        We are digitizing and\n                                                        taking a platform\n                                                        approach to ensure\n                                                        efficient and effective\n                                                        transaction Banking\n                                                        products.\n                                                      </div>\n                                                    </Panel>\n                                                    <Panel\n                                                      header=\"What is the target market for Transbnk?\"\n                                                      key=\"2\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        Presently a good number\n                                                        of clients are not using\n                                                        products owing to\n                                                        accessibility,\n                                                        complexity and time.\n                                                        With the platform\n                                                        approach will simplify\n                                                        the product and reduce\n                                                        timelines, this will\n                                                        enable a large number of\n                                                        new customers to use the\n                                                        products. Presently in\n                                                        tier2 & tier 3 cities\n                                                        organizations do not\n                                                        have access to a large\n                                                        number of transaction\n                                                        banking products\n                                                        (absence of quality bank\n                                                        personnel) and our\n                                                        product will allow\n                                                        access for these\n                                                        organizations to these\n                                                        products.\n                                                      </div>\n                                                    </Panel>\n                                                    <Panel\n                                                      header=\"What is the total addressable market (TAM)?\"\n                                                      key=\"7\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        Over ₹ 24 trillion GMV\n                                                        in India\n                                                      </div>\n                                                    </Panel>\n                                                    <Panel\n                                                      header=\"How does Transbnk generate Revenue?\"\n                                                      key=\"8\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        We generate revenues\n                                                        through Fee charged for\n                                                        Escrow services and\n                                                        Float Inclome generated\n                                                        from capital maintained.\n                                                      </div>\n                                                    </Panel>\n                                                    <Panel\n                                                      header=\"What are your moats?\"\n                                                      key=\"8\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        We have more than 60+\n                                                        years of collective\n                                                        Transaction Banking\n                                                        expertise. Founder\n                                                        experience of more than\n                                                        20 years in delivering\n                                                        software solutions for\n                                                        NBFCs. Strong business\n                                                        connects in banks and\n                                                        already in advanced\n                                                        discussions with IDFC,\n                                                        Federal, Yes bank, SBM\n                                                        while initial\n                                                        discussions also\n                                                        initiated with Kotak,\n                                                        HDFC, ICICI, Axis and\n                                                        SBM.\n                                                      </div>\n                                                    </Panel>\n                                                  </Collapse>\n                                                  <h1\n                                                    className=\"text-center mb-2 mt-4\"\n                                                    style={{ fontSize: \"2rem\" }}\n                                                  >\n                                                    Growth91 Investment FAQ\n                                                  </h1>\n                                                  <Collapse\n                                                    // defaultActiveKey={['10']}\n                                                    onChange={this.callback3}\n                                                    expandIconPosition=\"left\"\n                                                    accordion\n                                                  >\n                                                    <Panel\n                                                      header=\"What is the due diligence process followed by Growth91\"\n                                                      key=\"11\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        At Growth91, we follow\n                                                        stringent due-diligence\n                                                        process. We ask for\n                                                        detailed information\n                                                        about start-up and their\n                                                        team. After the scrutiny\n                                                        and if deemed fit,\n                                                        start-up would be listed\n                                                        on Growth91 platform.\n                                                        Independent investment\n                                                        opinion and\n                                                        due-diligence report\n                                                        prepared by external\n                                                        qualified experts are\n                                                        made available for\n                                                        investors.\n                                                      </div>\n                                                    </Panel>\n                                                    <Panel\n                                                      header=\"Do you offer any guarantee on returns?\"\n                                                      key=\"12\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        No, we do not guarantee\n                                                        any returns. The startup\n                                                        which is raising the\n                                                        money is also not\n                                                        guaranteeing any\n                                                        specific returns. In\n                                                        principle, it is not\n                                                        legally correct for the\n                                                        company to provide any\n                                                        guarantee about returns\n                                                        on equity linked\n                                                        securities.\n                                                      </div>\n                                                    </Panel>\n                                                    <Panel\n                                                      header=\"What is the refund process in case I don’t receive any allocation?\"\n                                                      key=\"13\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        If an investor doesn’t\n                                                        receive the allocation,\n                                                        the investment amount\n                                                        will be refunded to the\n                                                        bank account from which\n                                                        the investment has been\n                                                        made. As per Growth91\n                                                        policy, there will be no\n                                                        interest or compensation\n                                                        on these returned funds.\n                                                      </div>\n                                                    </Panel>\n                                                    <Panel\n                                                      header=\"What is the exit mechanism available for the investors\"\n                                                      key=\"14\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        The Company and the\n                                                        Promoters shall make all\n                                                        reasonable endeavours to\n                                                        provide exit to the\n                                                        Investors by any of the\n                                                        following ways: 1.\n                                                        Initial Public Offer\n                                                        (IPO) 2. Merger or\n                                                        Acquisition Event 3.\n                                                        Buyout Event 3.\n                                                        Compulsory Call Option\n                                                        with minimum assured\n                                                        returns. (Please refer\n                                                        to investor agreement\n                                                        for more details)\n                                                      </div>\n                                                    </Panel>\n\n                                                    <Panel\n                                                      header=\"In which account Investor’s money are transferred\"\n                                                      key=\"15\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        Money invested by the\n                                                        investor in all public\n                                                        deals are automatically\n                                                        transferred to separate\n                                                        and dedicated escrow\n                                                        account created for\n                                                        respective Startup. The\n                                                        escrow account is\n                                                        managed by authorized\n                                                        trustee. After the\n                                                        funding/deal and\n                                                        documentation\n                                                        formalities are\n                                                        completed, the fund will\n                                                        be transferred to\n                                                        respective startup bank\n                                                        account.\n                                                      </div>\n                                                    </Panel>\n\n                                                    <Panel\n                                                      header=\"I have more questions; how do I contact Growth91?\"\n                                                      key=\"16\"\n                                                      extra={genExtra()}\n                                                    >\n                                                      <div\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        You can always send your\n                                                        queries to{\" \"}\n                                                        <a href=\"mailto:contact@growth91.com\">\n                                                          contact@growth91.com\n                                                        </a>\n                                                        , we will respond to\n                                                        your queries in shortest\n                                                        possible time.\n                                                      </div>\n                                                    </Panel>\n                                                  </Collapse>\n                                                </div>\n                                              </div>\n                                            </div>\n                                          </section>\n                                        </TabPane>\n                                      </Tabs>\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n\n                            {/* stop */}\n                          </TabPane>\n                          <TabPane tab=\"Team\" key=\"3\">\n                            <div\n                              className=\"container meet-the-team-section\"\n                              style={{ maxWidth: 921 }}\n                            >\n                              <h2 className=\"text-center\">Meet the Team</h2>\n                              <div className=\"row\">\n                                <div className=\"col-lg-6\">\n                                  <div\n                                    className=\"single\"\n                                    style={{ paddingBottom: \"0px !important\" }}\n                                    // style={{  marginBottom: 0px !important}}\n                                  >\n                                    <div className=\"d-flex\">\n                                      <img\n                                        src=\"./assets/images/deals-details/TransBank/team/vaibhav.jpg\"\n                                        alt=\"\"\n                                      />\n                                      <div className=\"intro\">\n                                        <h3>Vaibhav Tambe</h3>\n                                        <span>Co-Founder & CEO</span>\n                                        <div\n                                          className=\"social-icons\"\n                                          style={{\n                                            marginTop: 4,\n                                            marginLeft: -6,\n                                          }}\n                                        >\n                                          <a\n                                            href=\"https://www.linkedin.com/in/vaibhav-tambe/\"\n                                            target=\"_blank\"\n                                          >\n                                            <i className=\"bx bxl-linkedin\"></i>\n                                          </a>\n                                          <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                            <i className=\"bx bxl-gmail\"></i>\n                                          </a>\n                                          {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                    <i className=\"bx bxl-gmail\"></i>\n                                    </a> */}\n                                        </div>\n                                      </div>\n                                    </div>\n                                    <p>\n                                      14+ Years | Ex IndusInd Bank, SBI, TCS,\n                                      iServeU | MBA- IMT, B.E\n                                      (Telecommunication) | Most Admired Fintech\n                                      Professional 2022 (ET Now, CMO, World BFSI\n                                      Congress) | 50 Most Influential Payment\n                                      Professional 2020 (ET Now, World Payments\n                                      Council)\n                                      <br></br>\n                                      Strategy, Product & Business\n                                    </p>\n                                  </div>\n                                </div>\n\n                                <div className=\"col-lg-6\">\n                                  <div className=\"single\">\n                                    <div className=\"d-flex\">\n                                      <img\n                                        src=\"./assets/images/deals-details/TransBank/team/pulak.jpg\"\n                                        alt=\"\"\n                                      />\n                                      <div className=\"intro\">\n                                        <h3>Pulak Jain</h3>\n                                        <span>Co-Founder & CBO </span>\n                                        <div\n                                          className=\"social-icons\"\n                                          style={{\n                                            marginTop: 4,\n                                            marginLeft: -6,\n                                          }}\n                                        >\n                                          <a\n                                            href=\"https://www.linkedin.com/in/pulak-jain-127776193/\"\n                                            target=\"_blank\"\n                                          >\n                                            <i className=\"bx bxl-linkedin\"></i>\n                                          </a>\n                                        </div>\n                                      </div>\n                                    </div>\n                                    <p>\n                                      15+ Years | Transaction Banker & Fintech\n                                      Consultant | Solution Architect in Product\n                                      Lifecycle through design modeling,\n                                      development & Implementation for\n                                      Transaction banking products Business\n                                      Development & Sales\n                                      <br></br>\n                                      <br></br>\n                                      <br></br>\n                                    </p>\n                                  </div>\n                                </div>\n                                <div className=\"col-lg-6\">\n                                  <div className=\"single\">\n                                    <div className=\"d-flex\">\n                                      <img\n                                        src=\"./assets/images/deals-details/TransBank/team/sachin.jpg\"\n                                        alt=\"\"\n                                      />\n                                      <div className=\"intro\">\n                                        <h3>Sachin Gupta</h3>\n                                        <span>Co-Founder & CPO </span>\n                                        <div\n                                          className=\"social-icons\"\n                                          style={{\n                                            marginTop: 4,\n                                            marginLeft: -6,\n                                          }}\n                                        >\n                                          <a\n                                            href=\"https://www.linkedin.com/in/sachin-gupta-6a014813/\"\n                                            target=\"_blank\"\n                                          >\n                                            <i className=\"bx bxl-linkedin\"></i>\n                                          </a>\n                                        </div>\n                                      </div>\n                                    </div>\n                                    <p>\n                                      IIM Calcutta ‘11 | Delhi College of\n                                      Engineering ’06 | 14+ years Transaction\n                                      Banking experience as Solution Architect\n                                      in Product Lifecycle Management through\n                                      design modeling, development &\n                                      Implementation\n                                      <br />\n                                      Products and Delivery\n                                    </p>\n                                  </div>\n                                </div>\n                                <div className=\"col-lg-6\">\n                                  <div className=\"single\">\n                                    <div className=\"d-flex\">\n                                      <img\n                                        src=\"./assets/images/deals-details/TransBank/team/lavin.jpg\"\n                                        alt=\"\"\n                                      />\n                                      <div className=\"intro\">\n                                        <h3>Lavin Kotian</h3>\n                                        <span>Co-Founder & CTO </span>\n                                        <div\n                                          className=\"social-icons\"\n                                          style={{\n                                            marginTop: 4,\n                                            marginLeft: -6,\n                                          }}\n                                        >\n                                          <a\n                                            href=\"https://www.linkedin.com/in/lavin-kotian-6a3b1520/\"\n                                            target=\"_blank\"\n                                          >\n                                            <i className=\"bx bxl-linkedin\"></i>\n                                          </a>\n                                        </div>\n                                      </div>\n                                    </div>\n                                    <p>\n                                      20+ years of experience in diverse\n                                      industries | Built expertise in Global\n                                      Turnkey Sales & Operations. Global &\n                                      Indian enterprise solutions | Former IT\n                                      head of Aditya Birla Finance | Product\n                                      Delivery & Technology Architecture\n                                      <br />\n                                      Technology & Architecture\n                                    </p>\n                                  </div>\n                                </div>\n                                <div className=\"col-lg-6\">\n                                  <div className=\"single\">\n                                    <div className=\"d-flex\">\n                                      <img\n                                        src=\"./assets/images/deals-details/TransBank/team/akshat.jpg\"\n                                        alt=\"\"\n                                      />\n                                      <div className=\"intro\">\n                                        <h3>Akshat Gupta</h3>\n                                        <span>Legal Counsel</span>\n                                        <div\n                                          className=\"social-icons\"\n                                          style={{\n                                            marginTop: 4,\n                                            marginLeft: -6,\n                                          }}\n                                        >\n                                          <a\n                                            href=\"https://www.linkedin.com/in/akshat-gupta-968b818/\"\n                                            target=\"_blank\"\n                                          >\n                                            <i className=\"bx bxl-linkedin\"></i>\n                                          </a>\n                                        </div>\n                                      </div>\n                                    </div>\n                                    <p>\n                                      12+ Years Experience in legal, compliance\n                                      & consulting | Supreme Court & High Court\n                                      Lawyer| Honorary advisor to BRICS | LLM –\n                                      Warwick University, England, UK,\n                                      BA.LLB(H), Amity Law School\n                                      <br />\n                                      Legal & Compliance\n                                    </p>\n                                  </div>\n                                </div>\n                                <h2 className=\"text-center pt-3\">Advisors</h2>\n                                <div className=\"col-lg-6\">\n                                  <div className=\"single\">\n                                    <div className=\"d-flex\">\n                                      <img\n                                        src=\"./assets/images/deals-details/TransBank/team/vasant.jpg\"\n                                        alt=\"\"\n                                      />\n                                      <div className=\"intro\">\n                                        <h3> Vasanth Jeypaul</h3>\n                                        <span>Management </span>\n                                        <div\n                                          className=\"social-icons\"\n                                          style={{\n                                            marginTop: 4,\n                                            marginLeft: -6,\n                                          }}\n                                        >\n                                          <a\n                                            href=\"https://www.linkedin.com/in/vasanth-jeyapaul/\"\n                                            target=\"_blank\"\n                                          >\n                                            <i className=\"bx bxl-linkedin\"></i>\n                                          </a>\n                                          {/* <a\n                                href=\"https://www.facebook.com/ramachandran.gopalakrishnan.3\"\n                                target=\"_blank\"\n                              >\n                                <i className=\"bx bxl-facebook\"></i>\n                              </a> */}\n                                        </div>\n                                      </div>\n                                    </div>\n                                    <p>\n                                      CEO CAMSPay | Key Mgmt professional |\n                                      Payments /Fintech/Digital Expert |\n                                      Certified Board Director | BFSI | The\n                                      University of Chicago Booth School of\n                                      Business | Global Volunteer | Ex-FSS\n                                    </p>\n                                  </div>\n                                </div>\n\n                                <div className=\"col-lg-6\">\n                                  <div className=\"single\">\n                                    <div className=\"d-flex\">\n                                      <img\n                                        src=\"./assets/images/deals-details/TransBank/team/lohar.jpg\"\n                                        alt=\"\"\n                                      />\n                                      <div className=\"intro\">\n                                        <h3> Prasanna Lohar</h3>\n                                        <span>Blockchain</span>\n                                        <div\n                                          className=\"social-icons\"\n                                          style={{\n                                            marginTop: 4,\n                                            marginLeft: -6,\n                                          }}\n                                        >\n                                          <a\n                                            href=\"https://www.linkedin.com/in/prasannalohar/\"\n                                            target=\"_blank\"