     item.paid ==\n                                                                  \"Free\") && (\n                                                                <a\n                                                                  href={\n                                                                    documentlink\n                                                                  }\n                                                                  target=\"_blank\"\n                                                                  style={{\n                                                                    width: 80,\n                                                                  }}\n                                                                >\n                                                                  <img\n                                                                    src=\"./download.ico\"\n                                                                    style={{\n                                                                      maxWidth: 50,\n                                                                    }}\n                                                                  />\n                                                                </a>\n                                                              )}\n                                                              {item.paid ==\n                                                                \"Paid\" &&\n                                                                this.state\n                                                                  .check_membership_type ==\n                                                                  \"premium\" &&\n                                                                (item.premium_price ==\n                                                                \"0\" ? (\n                                                                  <a\n                                                                    href={\n                                                                      documentlink\n                                                                    }\n                                                                    target=\"_blank\"\n                                                                    style={{\n                                                                      width: 80,\n                                                                    }}\n                                                                  >\n                                                                    <img\n                                                                      src=\"./download.ico\"\n                                                                      style={{\n                                                                        maxWidth: 50,\n                                                                      }}\n                                                                    />\n                                                                  </a>\n                                                                ) : (\n                                                                  \"\"\n                                                                ))}\n                                                            </center>\n                                                          )}\n                                                        </td>\n                                                      </tr>\n                                                    );\n                                                  }\n                                                )}\n                                            </table>\n                                          </div>\n                                        </>\n                                  