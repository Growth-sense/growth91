regular_end_date\n                                                ? moment(\n                                                    this.state\n                                                      .deal_regular_end_date\n                                                  ).format(\"MMM DD, YYYY\")\n                                                : \"\"}\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span> Min Investment</span>\n                                            <h4>₹ 5,000</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Valuation</span>\n                                            <h4>\n                                              Floor : 20 Crore <br></br> Cap : 30\n                                              Crore\n                                            </h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"0px\",\n                                      marginTop: \"20px\",\n                                    }}\n                                  >\n                                    Company Details\n                                  </h1>\n                                  <section\n                                    className=\"deal-about-artment-section\"\n                                    style={{ marginTop: \"50px\" }}\n                                  >\n                                    <div className=\"container\">\n              