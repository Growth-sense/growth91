     </button>\n            </center>\n\n            <img\n              src=\"./assets/images/founders/startup-instruction.png\"\n              alt=\"startup-instruction\"\n              style={{\n                maxWidth: \"60%\",\n                margin: \"0 auto\",\n                display: \"flex\",\n              }}\n            />\n\n            <center>\n              <br />\n              <button\n                onClick={() => {\n                  this.setState({ showInstruction: false });\n                  ReactGA.event({\n                    category: \"Startup Form\",\n                    action: \"Instruction\",\n                    label: \"Lets Start\",\n                  });\n                }}\n                className=\"small-button-dark prime-bg\"\n                style={{\n                  fontsize: 18,\n                  padding: \"0 0\",\n                }}\n              >\n                Lets start\n              </button>\n            </center>\n          </div>\n        ) : (\n          <section className=\"rfoundation-section\" style={{ marginTop: 100 }}>\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-lg-12\">\n                  <h1>Information about Startup</h1>\n                  <br />\n                  <p>\n                    Tell us a little about your company. This will help us\n                    understand your business better.\n                    <br />\n                    <span style={{ color: \"red\" }}>\n                      ( Instruction: Startup form and Assessment Forms are best\n                      viewed on PC/Laptop. )\n                    </span>\n                  </p>\n                </div>\n              </div>\n              <div className=\"row\">\n                <div className=\"col-lg-4\">\n                  <div className=\"multistep-form-icons\">\n                    <ul>\n                      <li onClick={() => this.activethistab(0)}>\n                        <div>\n                          <div\n                            className={\n                              this.state.activeform == 0\n                                ? \"circle active-tab\"\n                                : \"circle \" + this.state.class0\n                            }\n                          >\n                            {(this.state.activeform == 0 ||\n                              this.state.class0 == \"\") &&\n                              \"1\"}\n                            {this.state.activeform != 0 &&\n                              this.state.class0 == \" success-tab\" && (\n                                <i\n                                  style={{ fontSize: 28 }}\n                                  className=\"bx bx-check\"\n                                ></i>\n                              )}\n                            {this.state.activeform != 0 &&\n                              this.state.class0 == \" error-tab\" && (\n                                <i\n                                  style={{ fontSize: 28 }}\n                                  className=\"bx bx-x\"\n                                ></i>\n                              )}\n                          </div>\n                          <span>Basic Details</span>\n                          <div className=\"line\"></div>\n                        </div>\n                      </li>\n                      <li onClick={() => {this.activethistab(1); this.checkforvalidation()}}>\n                        <div>\n                          <div\n                            className={\n                              this.state.activeform == 1\n                                ? \"circle active-tab\"\n                                : \"circle \" + this.state.class1\n                            }\n                          >\n                            {(this.state.activeform == 1 ||\n                              this.state.class1 ==