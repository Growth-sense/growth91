-map-marker\"></i>Ahmedabad | Akola | Bangalore | Mumbai\n                                        </a>\n                                        <a href=\"mailto:contact@Growth91.com\">\n                                            <i class=\"fa fa-envelope\"></i>\n                                            contact@Growth91.com\n                                        </a>\n                                        <a className=\"mt-2 pb-0\" style={{ color: '#DFD8EC', pointerEvents: 'none' }}>\n                                            <i class=\"fa fa-building\" aria-hidden=\"true\"></i>\n                                            87, Toshniwal Layout, Akola 444004\n                                        </a>\n                                        <a className=\"mt-2 pb-0\" style={{ color: '#DFD8EC', pointerEvents: 'none' }}>\n                                            <i className=\"fa fa-phone fa-rotate-90\"></i>\n                                            +91 75885 44442\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n                <div className=\"footer-bottom mt-5\">\n                    <div className=\"container\">\n                        <div className=\"bottom-left\">\n                            <span>Copyright  <sup style={{fontSize:\"10px\"}}>&copy;</sup> <a href=\"#\">Growth91<sup style={{ fontSize: '0.5rem', position: 'relative', top: -6 }}>®</sup></a> {moment().format('YYYY')}. All Rights Reserved</span>\n                        </div>\n                    </div>\n                </div>\n            </footer>\n        )\n    }\n}\nexport default WebFooter;","/home/akc01/Desktop/projects/Growth91/apps/client/src/app/common/Footer.js",[],[],"/home/akc01/Desktop/projects/Growth91/apps/client/src/app/constants/Bridge.js",["9789"],["9790"],"import