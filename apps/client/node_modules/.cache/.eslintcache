assName=\"download-document-table\"\n                                              style={{ width: \"100%\" }}\n                                            >\n                                              <tr\n                                                style={{\n                                                  background: \"#29176f\",\n                                                  color: \"#fff\",\n                                                }}\n                                              >\n                                                <th>Sr no</th>\n                                                <th>Document</th>\n                                                <th>Type</th>\n                                                <th>Download</th>\n                                              </tr>\n                                              {this.state.documents.length >\n                                                0 &&\n                                                this.state.documents.map(\n                                                  (item, index) => {\n                                                    let documentlink = `${process.env.REACT_APP_BASE_URL}api/uploads/docs/${item.documentid}/${item.document}`;\n                                                    return (\n                                                      <tr\n                                                        key={index}\n                                                        style={{ height: 70 }}\n                                                      >\n                                                        {/* <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {item.paid ==\n                                                            \"Paid\" && (\n                                                       