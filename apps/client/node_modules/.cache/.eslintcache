idth: \"100%\",\n                                  marginBottom: \"40px\",\n                                  maxWidth: \"837px\",\n                                  display: \"flex\",\n                                  justifyContent: \"center\",\n                                  margin: \"0 auto 40px auto\",\n                                }}\n                              />\n                              <img\n                                src=\"./assets/images/deals-details/HumSafer/pitch/Pitch deck_page-0011.jpg\"\n                                style={{\n                                  width: \"100%\",\n                                  marginBottom: \"40px\",\n                                  maxWidth: \"837px\",\n                                  display: \"flex\",\n                                  justifyContent: \"center\",\n                                  margin: \"0 auto 40px auto\",\n                                }}\n                              />\n                              <img\n                                src=\"./assets/images/deals-details/HumSafer/pitch/Pitch deck_page-0012.jpg\"\n                                style={{\n                                  width: \"100%\",\n                                  marginBottom: \"40px\",\n                                  maxWidth: \"837px\",\n                                  display: \"flex\",\n                                  justifyContent: \"center\",\n                                  margin: \"0 auto 40px auto\",\n                                }}\n                              />\n                              <img\n                                src=\"./assets/images/deals-details/HumSafer/pitch/Pitch deck_page-0013.jpg\"\n                                style={{\n                                  width: \"100%\",\n                                  marginBottom: \"40px\",\n                                  maxWidth: \"837px\",\n                                  display: \