ult();\n   formsub()\n  };\nconst formsub=async()=>{\n  const res = await Bridge.contact_us_form({\n    contactName: name,\n    contactEmail: email,\n    contactMessage: msg,\n  });\n  console.log(res);\n  if (res.data.status == \"1\") {\n    notify();\n  }\n}\nuseEffect(() => {\n  window.scrollTo(0, 0)\n}, [])\n\n  return (\n    <>\n      <NewWebHeader newabout={\"newabout\"} />\n\n      <section class=\"contact_us\">\n        <div class=\"container\">\n          <div class=\"row\">\n            <div class=\"col-md-10 offset-md-1\">\n              <div class=\"contact_inner\">\n                <div class=\"row\">\n                  <div class=\"col-xxl-10 col-xl-10 col-lg-9 col-md-9 col-sm-12 col-12\">\n                    <div class=\"contact_form_inner\">\n                      <div class=\"contact_field\">\n                        <h3>Contact Us</h3>\n                        <p>\n                          Feel Free to contact us any time. We will get back to\n                          you as soon as we can!.\n                        </p>\n                        <form onSubmit={formsubmit}>\n                          <input\n                            type=\"text\"\n                            class=\"form-control form-group\"\n                            required\n                            placeholder=\"Name\"\n                            value={name}\n                            onChange={(e) => {\n                              setName(e.target.value);\n                            }}\n                          />\n                          <input\n                            type=\"email\"\n                            class=\"form-control form-group\"\n                            required\n                            placeholder=\"Email\"\n                            value={email}\n                            onChange={(e) => {\n                              setEmail(e.target.value);\n                            }}\n                          />\n                          <textarea\n                            class=\"form-control form-group\"\n                            placeholder=\"Message\"\n                            required\n                            value={msg}\n                            onChange={(e) => {\n                              setMsg(e.target.value);\n                            }}\n                          ></textarea>\n                          <input class=\"contact_form_submit \" type=\"submit\" />\n                        </form>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"col-xl-2 col-xxl-2 col-lg-3 col-md-3\">\n                    <div class=\"right_conatct_social_icon d-flex align-items-end\">\n                      <div class=\"socil_item_inner d-flex\">\n                        <li>\n                          <a\n                            href=\"https://www.facebook.com/MyGrowth91?mibextid=ZbWKwL\"\n                            target=\"_blank\"\n                          >\n                            <i class=\"fab fa-facebook-square\"></i>\n                          </a>\n                        </li>\n                        <li>\n                          <a\n                            href=\"https://www.instagram.com/growth.91/\"\n                            target=\"_blank\"\n                          >\n                            <i class=\"fab fa-instagram\"></i>\n                          </a>\n                        </li>\n                        <li>\n                          <a\n                            target=\"_blank\"\n                            href=\"https://x.com/Growth_91\"\n                          >\n                            <i class=\"fab fa-twitter\"></i>\n                          </a>\n                        </li>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div class=\"contact_info_sec\">\n                  <h4>Contact Info</h4>\n                  <div class=\"d-flex info_single align-items-center\">\n                    <i class=\"fas fa-headset\"></i>\n                    <a href=\"tel:+917588544442\">\n                      {\" \"}\n                      <span>+91 75885 44442</span>\n                    </a>\n                  </div>\n                  <div class=\"d-flex info_single align-items-center\">\n                    <i class=\"fas fa-envelope-open-text\"></i>\n                    <a href=\"mailto:contact@growth91.com\">\n                      <span>contact@growth91.com</span>\n                    </a>\n                  </div>\n                  <div class=\"d-flex info_single align-items-center\">\n                    <i class=\"fas fa-map-marked-alt\"></i>\n                    <span>\n                      87, Toshniwal Layout Akola 444001 Maharashtra - address\n                    </span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"map_sec\">\n        <div class=\"container\">\n          <div class=\"row\">\n            <div class=\"col-md-10 offset-md-1\">\n              <div class=\"map_inner\">\n                <h4>Find Us on Google Map</h4>\n                <p></p>\n                <div class=\"map_bind\">\n                  <iframe\n                    src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3732.2730278256986!2d77.01350587612328!3d20.699134799016743!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd72e0153248bb1%3A0xf9c3a56f6f450d26!2s87%2C%20Toshniwal%20Layout%2C%20Dwarka%20Nagri%2C%20Akola%2C%20Maharashtra%20444001!5e0!3m2!1sen!2sin!4v1716882397739!5m2!1sen!2sin\"\n                    width=\"100%\"\n                    height=\"450\"\n                    frameborder=\"0\"\n                    style={{ border: \"0\" }}\n                    allowfullscreen=\"\"\n                    aria-hidden=\"false\"\n                    tabindex=\"0\"\n                  ></iframe>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <ToastContainer />\n      <NewWebFooter />\n    </>\n  );\n};\n","/home/akc01/Desktop/projects/Growth91/apps/client/src/app/DashboardType.jsx",["2164","2165","2166","2167","2168"],[],"import React, { useEffect } from 'react'\nimport { NewWebFooter } from './common/NewWebFooter'\nimport Slider from 'react-slick'\nimport NewWebHeader from \"./common/NewWebHeader.jsx\";\nimport $ from \"jquery\";\nimport { Link } from 'react-router-dom';\n\nexport const DashboardType = () => {\n    useEffect(() => {\n        window.scrollTo(0, 0)\n    }, [])\n\n    $(window).scroll(function () {\n        if ($(this).scrollTop() > 30) {\n            $('body').addClass('newClass');\n        } else {\n            $('body').removeClass('newClass');\n        }\n    });\n    function SimpleNextArrow(props) {\n        const { onClick } = props;\n        return (\n            <>\n                <div className=\"nextArrow\" onClick={onClick}>\n                    <span class=\"next-arrows slick-arrow\">\n                        <i class=\"fa fa-angle-right\" aria-hidden=\"true\"></i>\n                    </span>\n                </div>\n            </>\n        );\n    }\n\n    function SimplePrevArrow(props) {\n        const { onClick } = props;\n        return (\n            <>\n                <div className=\"prevArrow\" onClick={onClick}>\n                    <span class=\"prev-arrows slick-arrow\">\n                        {\" \"}\n                        <i class=\"fa fa-angle-left\" aria-hidden=\"true\"></i>{\" \"}\n                    </span>\n                </div>\n            </>\n        );\n    }\n    const sliderSettings = {\n        dots: true,\n        infinite: true,\n        arrows: false,\n        speed: 2000,\n        slidesToShow: 1,\n        slidesToScroll: 1,\n        autoplaySpeed: 3000,\n        autoplay: true,\n\n        prevArrow: <SimplePrevArrow />,\n        nextArrow: <SimpleNextArrow />,\n\n\n        responsive: [{\n            breakpoint: 1200,\n            settings: {\n                autoplay: true,\n                slidesToShow: 1,\n                slidesToScroll: 1\n            }\n        }, {\n            breakpoint: 993,\n            settings: {\n                autoplay: true,\n                slidesToShow: 1,\n                slidesToScroll: 1\n            }\n        }, {\n            breakpoint: 600,\n            settings: {\n                autoplay: false,\n                speed: 100,\n                slidesToShow: 1,\n                slidesToScroll: 1\n            }\n        }, {\n            breakpoint: 400,\n            settings: {\n                arrows: false,\n                speed: 100,\n                slidesToShow: 1,\n                slidesToScroll: 1,\n                autoplay: false,\n            }\n        }]\n    }\n    return (\n        <div>\n            <div classname=\"newabout\">\n                <NewWebHeader newabout={\"newabout\"} />\n            </div>\n            <section class=\"about-page-section blog-section pb-0\" style={{ paddingBottom: \"0px !important\" }}>\n\n                <div class=\"container\">\n                    <div class=\"row\">\n                        <div class=\"col-lg-12 col-md-12 col-sm-12 d-flex justify-content-center align-items-center\" style={{ pointerEvents: \"none\" }}>\n                            <div class=\"heading-title m-sm-0\">\n                                <p>\n                                    <span></span>{\" \"}\n                                </p>\n                                <h2>Account Details</h2>\n                            </div>\n                        </div>\n\n                    </div>\n                    <div class=\"tabs-dashboard\">\n                        <div class=\"tabs-nav\">\n                            