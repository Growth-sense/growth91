                                                             )\n                                                                        }\n                                                                        value={\n                                                                          item.selected\n                                                                        }\n                                                                      ></Checkbox>\n                                                                    )}\n                                                                </>\n                                                              )}\n                                                            </>\n                                                          )}\n                                                        </td> */}\n                                                        <td style={{ width: 40 }}>{index + 1}</td>\n                                                        <td\n                                                          style={{ width: 140 }}\n                                                        >\n                                                          {item.docname}\n                                                        </td>\n                                                        <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {item.paid == \"Paid\"\n                                                            ? this.state\n                                                                .check_membership_type ==\n                                                              \"premium\"\n                                                              ? item.premium_price ==\n                                                                \"0\"\n           