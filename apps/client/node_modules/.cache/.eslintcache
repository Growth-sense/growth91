ight5.png\"\n                                style={{\n                                  width: \"100%\",\n                                  marginBottom: \"40px\",\n                                  maxWidth: \"837px\",\n                                  display: \"flex\",\n                                  justifyContent: \"center\",\n                                  margin: \"0 auto 40px auto\",\n                                }}\n                              />\n                            </div>\n                          </div>\n                          {/* start */}\n\n                          <div\n                            className=\"deals-page\"\n                            style={{\n                              marginTop: \"50px !important\",\n                            }}\n                          >\n                            <div className=\"tab-wrapper\">\n                              <div className=\"container\">\n                                <div className=\"row\">\n                                  <div className=\"col-lg-12\">\n                                    <Tabs defaultActiveKey=\"1\" centered>\n                                      <TabPane tab=\"FAQ\" key=\"1\">\n                                        <section\n                                          className=\"faq-section\"\n                                          style={{\n                                            margin: \"0px\",\n                                            padding: \"0px\",\n                                            background: \"none\",\n                                          }}\n                                        >\n                                          <div className=\"\">\n                                            <div className=\"row\">\n                                              <div className=\"col-lg-12 col-md-12 col-sm-12 m-auto\">\n                                                <h1 className=\"text-center mb-4\">\n                                                  About {this.state.deal_name}\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['1']}\n                                                  onChange={this.callback1}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"What is the TestDeal1's value proposition?\"\n                                                    key=\"1\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      Lorem ipsum dolor sit amet consectetur adipisicing elit. Labore delectus fugit consectetur cum vitae hic, iusto quidem illo tempora sit alias facilis sapiente illum ex omnis placeat exercitationem earum dolorum explicabo assumenda dolore porro! In autem dolorum accusamus et soluta reprehenderit molestiae placeat maxime laborum eveniet? Non dolorum aut ratione.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is primary GTM strategy of TestDeal1?\"\n                                                    key=\"2\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>1. Lorem, ipsum dolor sit amet consectetur adipisicing elit. Odit, ipsam. </p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>2. Lorem ipsum dolor sit amet consectetur adipisicing elit. Nobis, qui!</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>3. Lorem ipsum dolor sit amet consectetur adipisicing elit. Nobis, qui! </p>\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"What are your moats?\"\n                                                    key=\"7\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>1. Lorem ipsum, dolor sit amet consectetur adipisicing elit. Voluptates eveniet quod mollitia cum suscipit similique est rem totam fuga fugiat?</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>2. Lorem ipsum dolor sit, amet consectetur adipisicing elit. Aliquid, nam.</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>3. Lorem ipsum dolor sit amet consectetur adipisicing elit. Quae officiis assumenda laudantium a totam quibusdam, fugit voluptates neque iure at velit ipsum aut praesentium qui, iusto cupiditate nihil tenetur soluta architecto odio unde non! Iste, magnam reprehenderit voluptas dolores nihil delectus quod voluptate cupiditate fugiat quae ipsum perspiciatis? Eaque, necessitatibus?</p>\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"How's TestDeal1 different from competition?\"\n                                                    key=\"4\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>1. TestDeal1 Lorem ipsum dolor sit amet consectetur adipisicing elit. Fugit quod inventore qui culpa laboriosam quisquam iusto amet facere doloremque voluptate?</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>2. Lorem ipsum dolor sit amet, consectetur adipisicing elit. In ea veniam ducimus numquam impedit ratione, labore officiis cum quidem asperiores.</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>3. Lorem ipsum dolor sit amet consectetur adipisicing elit. Exercitationem, praesentium.</p>\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                                <h1 className=\"text-center mb-2 mt-4\">\n                                                  Growth91 Investment FAQ\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['10']}\n                                                  onChange={this.callback3}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"What is the due diligence process followed by Growth91\"\n                                                    key=\"11\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      At Growth91, we follow\n                                                      stringent due-diligence\n                                                      process. We ask for\n                                                      detailed information about\n                                                      start-up and their team.\n                                                      After the scrutiny and if\n                                                      deemed fit, start-up would\n                                                      be listed on Growth91\n                                                      platform. Independent\n                                                      investment opinion and\n                                                      due-diligence report\n                                                      prepared by external\n                                                      qualified experts are made\n                                                      available for investors.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"Do you offer any guarantee on returns?\"\n                                                    key=\"12\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      No, we do not guarantee\n                                                      any returns. The startup\n                                                      which is raising the money\n                                                      is also not guaranteeing\n                                                      any specific returns. In\n                                                      principle, it is not\n                                                      legally correct for the\n                                                      company to provide any\n                                                      guarantee about returns on\n                                                      equity linked securities.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the refund process in case I don’t receive any allocation?\"\n                                                    key=\"13\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      If an investor doesn’t\n                                                      receive the allocation,\n                                                      the investment amount will\n                                                      be refunded to the bank\n                                                      account from which the\n                                                      investment has been made.\n                                                      As per Growth91 policy,\n                                                      there will be no interest\n                                                      or compensation on these\n                                                      returned funds.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the exit mechanism available for the investors\"\n                                                    key=\"14\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      The Company and the\n                                                      Promoters shall make all\n                                                      reasonable endeavours to\n                                                      provide exit to the\n                                                      Investors by any of the\n                                                      following ways: 1. Initial\n                                                      Public Offer (IPO) 2.\n                                                      Merger or Acquisition\n                                                      Event 3. Buyout Event 3.\n                                                      Compulsory Call Option\n                                                      with minimum assured\n                                                      returns. (Please refer to\n                                                      investor agreement for\n                                                      more details)\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"In which account Investor’s money are transferred\"\n                                                    key=\"15\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      Money invested by the\n                                                      investor in all public\n                                                      deals are automatically\n                                                      transferred to separate\n                                                      and dedicated escrow\n                                                      account created for\n                                                      respective Startup. The\n                                                      escrow account is managed\n                                                      by authorized trustee.\n                                                      After the funding/deal and\n                                                      documentation formalities\n                                                      are completed, the fund\n                                                      will be transferred to\n                                                      respective startup bank\n                                                      account.\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"I have more questions; how do I contact Growth91?\"\n                                                    key=\"16\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      You can always send your\n                                                      queries to{\" \"}\n                                                      <a href=\"mailto:contact@growth91.com\">\n                                                        contact@growth91.com\n                                                      </a>\n                                                      , we will respond to your\n                                                      queries in shortest\n                                                      possible time.\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                              </div>\n                                            </div>\n                                          </div>\n                                        </section>\n                                      </TabPane>\n                                    </Tabs>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          {/* stop */}\n                        </TabPane>\n                        <TabPane tab=\"Team\" key=\"3\">\n                          <div\n                            className=\"container meet-the-team-section\"\n                            style={{ maxWidth: 921 }}\n                          >\n                            <h2 className=\"text-center\">Meet the Team</h2>\n                            <div className=\"row\">\n                              <div className=\"col-lg-6\">\n                                <div\n                                  className=\"single\"\n                                  style={{ paddingBottom: \"0px !important\" }}\n                                // style={{  marginBottom: 0px !important}}\n                                >\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/no.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>TestDeal1</h3>\n                                      <span>Founder & CEO</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                        {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                        <i className=\"bx bxl-gmail\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    He is responsible for Product market Fit, Fundraise and Growth.\n                                    <br />\n                                    TestDeal1 is an engineering graduate with specialization in computer science. This is his first enterpreneurial venture founded when he was in college in 2019.\n                                  </p>\n                                </div>\n                              </div>\n\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/no.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>TestDeal1</h3>\n                                      <span>Head</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a href=\"https://www.linkedin.com/in/\" target=\"_blank\">\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Et eligendi dolorum soluta, voluptatum possimus eaque aspernatur veritatis enim quisquam ducimus!\n                                    <br />\n                                    TestDeal1 Lorem ipsum dolor sit amet consectetur adipisicing elit. Explicabo, deleniti.\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/no.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>TestDeal1</h3>\n                                      <span>Head New Expansion</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    He is responsible for New Vertical Expansion at TestDeal1\n                                    <br />\n                                    TestDeal1 has 8 years of experience with 5 industries: Hospitality, Food & Beverages, Automobile InsureTech, Car Accessories and Exports in the Growth and Strategy vertical.\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/no.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Anshuman Singh</h3>\n                                      <span>Head of Marketing and Branding partnership</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        {/* <a\n                                          href=\"https://www.linkedin.com/in/devaashish/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    He is responsible for all the marketing campaigns and Branding partnership at TestDeal1\n                                    <br />\n                                    Anshuman posseses marketing skills and has previously worked for cleardekho where he was managing marketing and campaigns.\n                                  </p>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </TabPane>\n                      </Tabs>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <WebFooter />\n          </div>\n        ) : (\n          window.location.assign(\"/Deals\")\n        )}\n      </>\n    );\n  }\n}\n\nexport default TestDeal1;\n","/home/akc01/Desktop/projects/Growth91/apps/client/src/app/deal-pages/Invidata.js",["8807","8808","8809","8810","8811","8812","8813","8814","8815","8816","8817","8818","8819","8820","8821","8822","8823","8824","8825","8826","8827","8828","8829","8830","8831","8832","8833","8834","8835","8836","8837","8838","8839","8840","8841","8842","8843","8844","8845","8846","8847","8848","8849","8850","8851","8852","8853","8854","8855","8856","8857","8858","8859","8860","8861","8862","8863","8864","8865","8866","8867","8868","8869","8870","8871","8872","8873","8874","8875","8876","8877","8878","8879","8880","8881","8882","8883","8884","8885","8886","8887","8888","8889","8890","8891","8892","8893","8894","8895","8896","8897","8898","8899","8900","8901","8902","8903","8904","8905","8906","8907","8908"],[],"import React, { Component } from \"react\";\nimport WebHeader from \"../common/WebHeader\";\nimport WebFooter from \"../common/WebFooter\";\nimport {\n  Tabs,\n  Collapse,\n  message,\n  Modal,\n  Spin,\n  Checkbox,\n  Progress,\n  Alert,\n} from \"antd\";\nimport axios from \"axios\";\nimport { ExclamationCircleOutlined, PlusOutlined } from \"@ant-design/icons\";\nimport Slider from \"react-slick\";\nimport Lightbox from 'react-image-lightbox';\nimport Apis from \"../constants/Apis\";\nimport moment from \"moment\";\nimport Bridge from \"../constants/Bridge\";\nimport InvestmentMembershipmodal from \"../components/membership/InvestmentMembershipmodal\";\n\nconst { Panel } = Collapse;\nconst { TabPane } = Tabs;\nclass Invidata extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      deal_id: \"\",\n      investor_id: \"\",\n      interested_id: \"\",\n      deal_name: \"\",\n      created_at: \"\",\n      deal_description: \"\",\n      isPrivate: false,\n      isFunded: false,\n      isBlank: false,\n      tags: [],\n      logo: \"\",\n      youtube_url: \"\",\n      dealenddays: 0,\n      kycstatus: false,\n      bankstatus: false,\n      commaAmount: 0,\n      amount: 0,\n      minamount: 0,\n      captable_threshold_amount: 0,\n      maxamount: 0,\n      captable_multiple_amount: 0,\n      investmentmodal: false,\n      confirmmodalstatus: false,\n      deduct: false,\n      agree: \"\",\n      isInvested: false,\n      name: \"\",\n      email: \"\",\n      mobile: \"\",\n      conveniencefees: 100,\n      gst: 0,\n      amountplusgst: 0,\n      processingfees: 0.0,\n      totalamount: 0.0,\n      tdsstatus: false,\n      legalfee: 0.0,\n      legalplusprocessing: 0.0,\n      label: \"\",\n      percentage: 0,\n      check_membership_type: \"\",\n      tdsdeductedamount: 0,\n      order_token: \"\",\n      pdffile: \"\",\n      pitch_files: \"\",\n      pitch_list: [],\n      walletMoney: 0,\n      gstValue: 0,\n      walletDeductionMoney: 0,\n      checkWallet: false,\n      percentage_raised: 0,\n      documents: [],\n      button_status: true,\n      show_data: \"none\",\n      button_show_status: true,\n      amount_error: \"\",\n      amount_error_status: false,\n      multiples_of: 0,\n      founder_is_investor: 0,\n      user_type: \"\",\n      coming_soon_days: \"\",\n      deal_regular_end_date: \"\",\n      is_deal_visible: true,\n      deal_regular_end_date_status: 0,\n      invest_amt: \"\",\n      escrowact: \"\",\n      escrow_account_ifsc: \"\",\n      agreeCheck: false,\n      images: [\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0001.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0002.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0003.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0004.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0005.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0006.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0007.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0008.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0009.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0010.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0011.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0012.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0013.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0014.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0015.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0016.jpg',\n        './assets/images/deals-details/Invidata/pitch/PitchDeck_page-0017.jpg',\n      ],\n      current: '',\n    };\n  }\n  callback1 = (key) => { };\n  callback2 = (key) => { };\n  callback3 = (key) => { };\n\n  componentWillMount() {\n    document.title = \"Invidata - Growth91 - Startup Marketplace \";\n  }\n  componentDidMount() {\n    let deal_id = \"112\";\n    this.setState({ deal_id: deal_id }, () => {\n      this.get_pitch_list();\n    });\n\n    if (\n      localStorage.getItem(\"investor_id\") ||\n      localStorage.getItem(\"founder_id\")\n    ) {\n      if (localStorage.getItem(\"investor_id\")) {\n        let investor_id = localStorage.getItem(\"investor_id\");\n        this.setState(\n          { investor_id: investor_id, user_type: \"investor\" },\n          () => {\n            this.getstatusdata();\n            this.getinvestmentdetails();\n            this.check_for_membership_type();\n            this.getwallethistory();\n            this.get_invest_amt();\n          }\n        );\n      } else if (localStorage.getItem(\"founder_id\")) {\n        this.get_founder_details();\n        this.setState({ user_type: \"founder\" });\n      }\n    } else {\n      this.getDeals();\n    }\n    this.getordertoken();\n    this.getGst();\n    this.get_deal_doucments(deal_id);\n    console.log(\"hello\");\n  }\n  get_founder_details = () => {\n    let params = {\n      founder_id: localStorage.getItem(\"founder_id\"),\n    };\n    Bridge.founder.get_founder_profile_details(params).then((result) => {\n      if (result.status == \"1\") {\n        if (result.data.length > 0) {\n          let investor_id = localStorage.getItem(\"founder_id\");\n          this.setState({ investor_id: investor_id }, () =>\n            this.getwallethistory()\n          );\n          setTimeout(() => {\n            if (result.data[0].is_investor == \"1\") {\n              this.getstatusdata();\n              this.getinvestmentdetails();\n              this.check_for_membership_type();\n              this.setState({ founder_is_investor: \"1\" });\n            } else {\n              this.check_for_membership_type();\n              this.setState({ founder_is_investor: \"0\" });\n            }\n          }, 200);\n        }\n      } else {\n        this.setState({ formloader: false });\n      }\n    });\n  };\n  get_deal_doucments = (deal_id) => {\n    let params = {\n      deal_id: deal_id,\n    };\n    Bridge.get_deal_doucments(params).then((result) => {\n      if (result.status == \"1\") {\n        let arr = [];\n        for (let item of result.data) {\n          item.selected = false;\n          arr = [...arr, item];\n        }\n        this.setState({ documents: arr }, () =>\n          this.get_document_purchased_list()\n        );\n      }\n    });\n  };\n  show_selected_checkbox = (single) => {\n    let arr = [];\n    let docuemnts = this.state.documents;\n    for (let item of docuemnts) {\n      if (item.documentid == single.documentid) {\n        item.selected = item.selected == true ? false : true;\n      }\n      arr = [...arr, item];\n    }\n    this.setState({ docuemnts: arr });\n    let data = [];\n    for (let item2 of arr) {\n      data = [...data, item2.selected];\n    }\n    let status = data.includes(true);\n    this.setState({ button_status: !status });\n  };\n\n  getwallethistory() {\n    if (this.state.investor_id) {\n      let params = {\n        investor_id: this.state.investor_id,\n      };\n      Bridge.investor.get_wallet_history(params).then((result) => {\n        if (result.status == \"1\") {\n          let credit_amount = 0;\n          let debit_amount = 0;\n          for (let item of result.data) {\n            if (item.type == \"credited\") {\n              credit_amount = parseInt(credit_amount) + parseInt(item.amount);\n            }\n            if (item.type == \"debited\") {\n              debit_amount = parseInt(debit_amount) + parseInt(item.amount);\n            }\n          }\n          let total = parseInt(credit_amount - debit_amount);\n          this.setState({ walletMoney: Math.abs(total) });\n        } else {\n        }\n      });\n    }\n  }\n  //for getting gst from admin page\n  getGst = () => {\n    Bridge.admin.settings.getsettings().then((result) => {\n      if (result.status == \"1\") {\n        this.setState({ gst: result.data[0].taxation_percentage });\n      } else {\n        // console.log(\"gst can not be able to fetch\")\n      }\n    });\n  };\n  check_for_membership_type = () => {\n    this.setState({ formloader: true });\n    let params = {\n      investor_id: this.state.investor_id,\n    };\n    Bridge.check_for_membership_type(params).then((result) => {\n      if (result.status == 1) {\n        if (result.data.length > 0) {\n          this.setState({\n            check_membership_type: result.data[0].membership_type,\n          });\n          setTimeout(() => {\n            this.getDeals();\n          }, 500);\n        }\n      } else {\n        this.setState({ formloader: false });\n      }\n    });\n    setTimeout(() => {\n      this.getdealsettings();\n    }, 500);\n  };\n  getordertoken = () => {\n    Bridge.getcashfreetoken().then((result) => {\n      let orderToken = result.order_token;\n      // console.log(orderToken , \"Order Token\")\n      this.setState({ order_token: orderToken });\n    });\n  };\n  // get post list\n  getdealsettings = () => {\n    this.setState({ formloader: true });\n    Bridge.admin.settings.getdealsettings().then((result) => {\n      if (result.status == 1) {\n        // console.log('result',result.data);\n        this.setState({\n          label: result.data[0].label,\n        });\n        if (this.state.check_membership_type == \"premium\") {\n          this.setState({\n            percentage: result.data[0].premium_member_deal_percentage,\n          });\n        } else {\n          this.setState({\n            percentage: result.data[0].regular_member_deal_percentage,\n          });\n        }\n      } else {\n        // message.error(result.message);\n        this.setState({\n          formloader: false,\n        });\n      }\n    });\n  };\n\n  get_pitch_list = () => {\n    this.setState({ loading: true });\n    let params = {\n      deal_id: this.state.deal_id,\n    };\n    Bridge.deal.get_image_list_of_pitch(params).then((result) => {\n      if (result.status == 1) {\n        let arr = [];\n        for (let data of result.data) {\n          let pitchImg =\n            Apis.IMAGEURL +\n            \"deal/pitch_images/\" +\n            data.deal_id +\n            \"/\" +\n            data.image;\n          data.img = pitchImg;\n          arr = [...arr, data];\n        }\n        arr.sort((a, b) =>\n          a.pitch_order > b.pitch_order\n            ? 1\n            : b.pitch_order > a.pitch_order\n              ? -1\n              : 0\n        );\n        // console.log('arr',arr);\n        this.setState({ pitch_list: arr, loading: false });\n      } else {\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  getinvestmentdetails = () => {\n    this.setState({ loading: true });\n    let params = {\n      investor_id: this.state.investor_id,\n      deal_id: this.state.deal_id,\n    };\n    Bridge.investor.getinvestmentdetails(params).then((result) => {\n      if (result.status == 1) {\n        if (result.data != \"\") {\n          this.setState({ isInvested: true });\n        }\n      } else {\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  // get deal list\n  getstatusdata = () => {\n    this.setState({ loading: true });\n    let params = {\n      id: this.state.investor_id,\n    };\n    Bridge.users.getstatusdata(params).then((result) => {\n      if (result.status == 1) {\n        this.setState({\n          kycstatus: result.data[0].kycstatus,\n          bankstatus: result.data[0].ifsc_code ? true : false,\n          loading: false,\n          name: result.data[0].first_name + \" \" + result.data[0].last_name,\n          email: result.data[0].email,\n          mobile: result.data[0].mobile,\n        });\n      } else {\n        message.error(result.message);\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  // get deal list\n  getDeals = () => {\n    this.setState({ loading: true });\n    Bridge.deal.list().then((result) => {\n      console.log(result.data, \"data\");\n      if (result.status == 1) {\n        this.setState({\n          deals: result.data,\n          loading: false,\n        });\n        let current_date = moment();\n        for (let d of result.data) {\n          // console.log(d.deal_id , \"id\")\n          // console.log(this.state.deal_id , \"sid\")\n          if (d.deal_id == this.state.deal_id) {\n            //  console.log(d.deal_status)\n            let deal_regular_show_date = moment(d.regular_show_date);\n            let deal_premium_show_date = moment(d.premium_show_date);\n            let deal_start_dt_rg = moment(d.deal_st_date);\n            let deal_start_dt_prem = moment(d.deal_start_dt_prem);\n            if (this.state.check_membership_type == \"premium\") {\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_show_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({ show_data: \"block\" });\n              } else if (current_date > deal_premium_show_date) {\n                this.setState({ show_data: \"block\" });\n              } else {\n                this.setState({ show_data: \"none\" });\n                window.location.assign(\"/deals\");\n                return;\n              }\n            } else if (this.state.check_membership_type == \"regular\") {\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_show_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({ show_data: \"block\" });\n              } else if (current_date > deal_regular_show_date) {\n                this.setState({ show_data: \"block\" });\n              } else {\n                this.setState({ show_data: \"none\" });\n                window.location.assign(\"/deals\");\n                return;\n              }\n            }\n          }\n          // else{\n          //   // window.location.href = (\"/deals\")\n          //   // return;\n          //   console.log(d.deal_id , this.state.deal_id);\n          // }\n        }\n        for (let d of result.data) {\n          console.log(d);\n          if (d.deal_id == this.state.deal_id) {\n            if (d.show_status == \"0\") {\n              this.setState({ is_deal_visible: false });\n              // window.location.assign(\"/deals\")\n            } else {\n              this.setState({ is_deal_visible: true });\n            }\n            let investor_id = this.state.investor_id;\n            if (d.deal_t_type == \"Private\") {\n              if (\n                investor_id &&\n                d.invitations.length > 0 &&\n                d.invitations.includes(investor_id)\n              ) {\n              } else {\n                window.location.assign(\"/deals\");\n                return;\n              }\n            }\n            let logourl =\n              Apis.IMAGEURL + \"deal/logo/\" + d.deal_id + \"/\" + d.logo;\n\n            let pdffile = `${process.env.REACT_APP_BASE_URL}api/uploads/deal/pitch/${d.deal_id}/${d.pitch_file}`;\n            let pitchImg =\n              Apis.IMAGEURL +\n              \"deal/pitch_images/\" +\n              d.deal_id +\n              \"/\" +\n              d.pitch_files;\n            let percetage_raised = parseFloat(\n              (d.total_invested_amount / d.deal_fund_requested) * 100 +\n              parseInt(d.raiegap)\n            ).toFixed(0);\n            let deal_premium_start_date = moment(d.deal_start_dt_prem);\n            let deal_regular_start_date = moment(d.deal_st_date);\n            let deal_premium_end_date = moment(d.deal_end_dt_prem);\n            let deal_regular_end_date = moment(d.deal_deal_end_date);\n            this.setState({ deal_regular_end_date: deal_regular_end_date });\n            let button_show_status = false;\n\n            // console.log('this.state.check_membership_type',this.state.check_membership_type);\n            // console.log('deal_regular_start_date',deal_regular_start_date);\n            // console.log('deal_regular_end_date',deal_regular_end_date);\n            // console.log('current_date',current_date);\n            // deal changes\n            let differece = \"\";\n            let dealEndDate = \"\";\n            let currentDate = \"\";\n            this.setState({ coming_soon_days: \"\" });\n            if (this.state.check_membership_type == \"premium\") {\n              dealEndDate = moment(d.deal_end_dt_prem).format(\"YYYY-MM-DD\");\n              currentDate = moment().format(\"YYYY-MM-DD\");\n              let days = this.getDifferenceInDays(currentDate, dealEndDate);\n              differece = days;\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") >\n                deal_premium_start_date.format(\"YYYY-MM-DD\") &&\n                moment(current_date).format(\"YYYY-MM-DD\") <\n                moment(deal_premium_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else {\n                button_show_status = false;\n              }\n              //for deal start date\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") <=\n                moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({\n                  coming_soon_days: this.getDifferenceInDays(\n                    moment(current_date).format(\"YYYY-MM-DD\"),\n                    moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n                  ),\n                });\n              }\n            } else if (\n              this.state.check_membership_type == \"regular\" ||\n              this.state.check_membership_type == \"\"\n            ) {\n              dealEndDate = moment(d.deal_end_date).format(\"YYYY-MM-DD\");\n              currentDate = moment().format(\"YYYY-MM-DD\");\n              let days = this.getDifferenceInDays(currentDate, dealEndDate);\n              differece = days;\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") >\n                deal_regular_start_date.format(\"YYYY-MM-DD\") &&\n                moment(current_date).format(\"YYYY-MM-DD\") <\n                moment(deal_regular_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else {\n                button_show_status = false;\n              }\n              //for deal start date\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") <=\n                moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({\n                  coming_soon_days: this.getDifferenceInDays(\n                    moment(current_date).format(\"YYYY-MM-DD\"),\n                    moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n                  ),\n                });\n              }\n            }\n            // console.log('button_show_status',this.state.button_show_status);\n            this.setState(\n              {\n                deal_name: d.name,\n                deal_description: d.Muliples_of,\n                // isBlank:d.deal_status == \"Closed\" ? window.location.href = \"/\" : \"/\",\n                isPrivate: d.deal_t_type == \"Private\" ? true : false,\n                isFunded: d.deal_status == \"Closed\" ? true : false,\n                tags: d.deal_category ? JSON.parse(d.deal_category) : [],\n                logo: logourl,\n                youtube_url: d.youtubelink,\n                dealenddays: differece > 0 ? differece : 0,\n                minamount: Number(d.Min_inv_amt),\n                captable_threshold_amount: parseInt(parseFloat(d.captable_threshold_amount).toFixed(2), 10),\n                maxamount: d.Max_inv_amt,\n                captable_multiple_amount: parseInt(parseFloat(d.captable_multiple_amount).toFixed(2), 10),\n                amount: \"\", //d.Min_inv_amt\n                commaAmount: \"\", //d.Min_inv_amt\n                pdffile: pdffile,\n                pitch_files: pitchImg,\n                percentage_raised: percetage_raised,\n                button_show_status: button_show_status,\n                show_data: \"block\",\n                multiples_of: d.multiples_of,\n              },\n              () => this.calculategst()\n            );\n          }\n        }\n      } else {\n        message.error(result.message);\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  getDifferenceInDays = (date1, date2) => {\n    let diff = Math.floor((Date.parse(date2) - Date.parse(date1)) / 86400000);\n    let final = 0;\n    if (diff < 0) {\n      final = 0;\n      this.setState({\n        deal_regular_end_date_status: 1,\n      });\n    } else {\n      final = diff;\n      this.setState({\n        deal_regular_end_date_status: 0,\n      });\n    }\n    return final;\n  };\n\n  showalertmessage = () => {\n    // message.warning('Please complete your KYC process or bank details to access this deal.');\n  };\n\n  showModal1 = () => {\n    if (this.state.kycstatus == \"admin_rejected\") {\n      message.warning(\n        \"Your KYC is Rejected, Please Contact to contact@Growth91<sup>TM</sup>.com\"\n      );\n      return;\n    }\n    this.setState(\n      {\n        investmentmodal: true,\n      },\n      () => {\n        this.calculategst();\n      }\n    );\n  };\n\n  // post api hit on express\n  getpostData = () => {\n    const formData = new FormData();\n    formData.append(\"deal_id\", this.state.deal_id);\n    formData.append(\"investor_id\", this.state.investor_id);\n    axios\n      .post(\n        `${process.env.REACT_APP_BASE_URL}api/investors/InvestorCommitment/save_investor_interest_deal`,\n        formData,\n        {\n          headers: {\n            \"Content-Type\": \"multipart/form-data\",\n          },\n        }\n      )\n      .then((response) => {\n        this.setState({\n          interested_id: response.data.data,\n        });\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  };\n\n  handleOk1 = () => {\n    this.setState({\n      investmentmodal: false,\n    });\n  };\n\n  handleCancel1 = () => {\n    this.setState({\n      investmentmodal: false,\n    });\n  };\n\n  showModal2 = () => {\n    this.setState({\n      confirmmodalstatus: true,\n    });\n  };\n\n  handleOk2 = () => {\n    this.setState({\n      confirmmodalstatus: false,\n    });\n  };\n\n  handleCancel2 = () => {\n    this.setState({\n      confirmmodalstatus: false,\n    });\n  };\n  onChangeCheckbox = (e) => {\n    this.setState({\n      [e.target.name]: e.target.checked,\n      agreeCheck: e.target.checked,\n    });\n\n    if (e.target.name == \"deduct\") {\n      if (e.target.checked == true) {\n        let processingfees = parseFloat(\n          (this.state.amount / 100) * parseFloat(this.state.percentage)\n        );\n        let tdsamount = parseFloat(processingfees / 100) * 10;\n        let minusamt = parseFloat(processingfees - tdsamount);\n\n        this.setState({\n          processingfees: minusamt,\n          tdsdeductedamount: tdsamount,\n        });\n      } else {\n        let processingfees = parseFloat(\n          (this.state.amount / 100) * parseFloat(this.state.percentage)\n        );\n        this.setState({\n          processingfees: processingfees,\n          tdsdeductedamount: 0,\n        });\n      }\n    }\n  };\n\n  // investing your money\n  invest = () => {\n    let investor_id = this.state.investor_id;\n    let deal_id = this.state.deal_id;\n    let Investment_amt = this.state.totalamount;\n    let deductstatus = this.state.deduct == true ? \"1\" : \"0\";\n    let agreestatus = this.state.agree == true ? \"1\" : \"0\";\n    let payment_ref = this.state.order_token;\n    let tdsstatus = this.state.tdsstatus == true ? \"1\" : \"0\";\n    let processingfees = this.state.processingfees;\n    let gst = this.state.gst;\n    let legalfees = this.state.legalfee;\n    let order_id = \"order-01\";\n    let walletamt = this.state.walletDeductionMoney\n      ? this.state.walletDeductionMoney\n      : 0;\n\n    let url = `${process.env.REACT_APP_BASE_URL}cashfree/checkout.php?investor_id=${investor_id}&deal_id=${deal_id}&deductstatus=${deductstatus}&agreestatus=${agreestatus}&payment_ref=${payment_ref}&tdsstatus=${tdsstatus}&processingfees=${processingfees}&gst=${gst}&legalfees=${legalfees}&Investment_amt=${Investment_amt}&order_id=${order_id}&wallet=${walletamt}`;\n    // console.log('url',url);\n    window.location.assign(url);\n  };\n\n  loadScript = (src) => {\n    return new Promise((resolve) => {\n      const script = document.createElement(\"script\");\n      script.src = src;\n\n      script.onload = () => {\n        resolve(true);\n      };\n\n      script.onerror = () => {\n        resolve(false);\n      };\n\n      document.body.appendChild(script);\n    });\n  };\n\n  calculategst = () => {\n    let legalfee = parseFloat(\n      (this.state.amount / 100) * parseFloat(this.state.percentage)\n    );\n    let gst = this.state.gst;\n    let amt = parseFloat(this.state.amount);\n    let walletDeductionMoney;\n    if (this.state.checkWallet == false) {\n      walletDeductionMoney = 0;\n    } else {\n      walletDeductionMoney =\n        legalfee.toFixed(0) <= this.state.walletMoney\n          ? legalfee.toFixed(0)\n          : this.state.walletMoney;\n    }\n    let gstValue = ((legalfee.toFixed(0) - walletDeductionMoney) * gst) / 100;\n    this.setState({\n      gst: gst,\n      legalfee: this.state.amount ? legalfee.toFixed(0) : 0,\n      amountplusgst: this.state.amount ? amt.toFixed(0) : 0,\n      processingfees: this.state.amount ? legalfee.toFixed(0) : 0,\n      totalamount: this.state.amount\n        ? (amt + parseFloat(legalfee)).toFixed(0) -\n        walletDeductionMoney +\n        gstValue\n        : 0,\n      walletDeductionMoney: walletDeductionMoney,\n      gstValue: gstValue,\n    });\n    return gst;\n  };\n  documentPay = () => {\n    if (!this.state.investor_id) {\n      message.warning(\"Please login first to invest.\", 5);\n      return;\n    }\n    let documents = this.state.documents;\n    let paying_for_documents = [];\n    let totalamt = 0;\n    for (let item of documents) {\n      if (item.selected == true) {\n        totalamt +=\n          this.state.check_membership_type == \"premium\"\n            ? Number(item.premium_price)\n            : Number(item.regular_price);\n        paying_for_documents = [...paying_for_documents, item.documentid];\n      }\n    }\n    let order_id = \"order-01\";\n    let user_id = this.state.investor_id;\n    let amount = totalamt;\n    let docs = paying_for_documents.join(\"-\").toString();\n    let deal_id = this.state.deal_id;\n    let url = `${process.env.REACT_APP_BASE_URL}cashfree/buy_documents/checkout.php?user_id=${user_id}&order_id=${order_id}&amount=${amount}&docs=${docs}&deal_id=${deal_id}`;\n\n    window.location.href = url;\n  };\n  get_document_purchased_list = () => {\n    if (this.state.investor_id) {\n      let params = {\n        investor_id: this.state.investor_id,\n        deal_id: this.state.deal_id,\n      };\n      Bridge.deal.get_document_purchased_list(params).then((result) => {\n        if (result.status == 1) {\n          let arr = [];\n          let documents = this.state.documents;\n          for (let item of documents) {\n            let status = false;\n            item.user_paid = false;\n            for (let item2 of result.data) {\n              if (item2.document_id == item.documentid || item.paid == \"Free\") {\n                item.user_paid = true;\n              }\n            }\n            arr = [...arr, item];\n          }\n          this.setState({ documents: arr });\n        }\n      });\n    }\n  };\n  check_for_error = () => {\n    let error = \"\";\n    let multiple_of =\n      parseFloat(this.state.amount) / parseFloat(this.state.multiples_of);\n    if (Number(this.state.amount) < Number(this.state.minamount)) {\n      error = `Minimum investment amount is Rs. ${this.state.minamount}`;\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (Number(this.state.amount) > Number(this.state.maxamount)) {\n      error = `Maximum investment amount is Rs. ${this.state.maxamount}`;\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (Number(this.state.amount) < Number(this.state.captable_threshold_amount) && Number(this.state.amount) % Number(this.state.multiples_of) != 0) {\n      const roundedLowerAmount = Math.floor(Number(this.state.amount) / Number(this.state.multiples_of)) * Number(this.state.multiples_of);\n      const roundedHigherAmount = Math.ceil(Number(this.state.amount) / Number(this.state.multiples_of)) * Number(this.state.multiples_of);\n\n      error = `Please enter an amount in multiples of ${this.state.multiples_of}. You may choose Rs ${roundedLowerAmount}\n      or Rs ${roundedHigherAmount}.\n      If you would like to enter the Captable, commit an amount of Rs. ${this.state.captable_threshold_amount} or more.`;\n\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (Number(this.state.amount) > Number(this.state.captable_threshold_amount) && Number(this.state.amount) % Number(this.state.captable_multiple_amount) != 0) {\n      const roundedLowerAmount = Math.floor(Number(this.state.amount) / Number(this.state.captable_multiple_amount)) * Number(this.state.captable_multiple_amount);\n      const roundedHigherAmount = Math.ceil(Number(this.state.amount) / Number(this.state.captable_multiple_amount)) * Number(this.state.captable_multiple_amount);\n\n      error = `Please enter an amount in multiples of ${this.state.captable_multiple_amount}. You may choose Rs ${roundedLowerAmount}\n      or Rs ${roundedHigherAmount}.\n      If you would like to enter the Captable, commit an amount of Rs. ${this.state.captable_threshold_amount} or more.`;\n\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else {\n      this.setState({ amount_error: \"\", amount_error_status: false });\n    }\n  };\n  get_invest_amt = () => {\n    axios.get(`${process.env.REACT_APP_BASE_URL}api/investors/InvestorCommitment/get_investor_investment_for_deal`, {\n      params: {\n        deal_id: this.state.deal_id,\n        investor_id: this.state.investor_id\n      }\n    })\n      .then((response) => {\n        console.log(\"invest_amt : \", response.data.data[0].totalamount)\n        this.setState({ invest_amt: response.data.data[0].totalamount });\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  }\n\n  increase_commit = () => {\n    const {\n      amount,\n      captable_threshold_amount,\n      multiples_of,\n      maxamount,\n      captable_multiple_amount,\n      minamount\n    } = this.state;\n\n    let newAmount = Number(amount);\n    let changeAmount;\n\n    if (\n      newAmount < captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount > captable_threshold_amount &&\n      newAmount % captable_multiple_amount != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(captable_multiple_amount)) * Number(captable_multiple_amount);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (newAmount < Number(captable_threshold_amount)) {\n      changeAmount = Number(multiples_of);\n    } else {\n      changeAmount = Number(captable_multiple_amount);\n    }\n\n    newAmount += changeAmount;\n\n    if (newAmount > maxamount) {\n      newAmount = maxamount;\n    } else if (newAmount < minamount) {\n      newAmount = Number(minamount);\n    }\n\n    this.setState(\n      {\n        amount: newAmount,\n        commaAmount: this.formatNumberWithCommas(newAmount),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  decrease_commit = () => {\n    const {\n      amount,\n      captable_threshold_amount,\n      multiples_of,\n      minamount,\n      captable_multiple_amount,\n    } = this.state;\n\n    let newAmount = Number(amount);\n    let changeAmount;\n\n    if (\n      newAmount == captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount < captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedLowerAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount > captable_threshold_amount &&\n      newAmount % captable_multiple_amount != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(newAmount / Number(captable_multiple_amount)) * Number(captable_multiple_amount);\n      newAmount = roundedLowerAmount;\n      changeAmount = 0;\n    } else if (newAmount <= Number(captable_threshold_amount)) {\n      changeAmount = Number(multiples_of);\n    } else {\n      changeAmount = Number(captable_multiple_amount);\n    }\n\n    newAmount -= changeAmount;\n\n    if (newAmount < minamount) {\n      newAmount = minamount;\n    }\n\n    this.setState(\n      {\n        amount: newAmount,\n        commaAmount: this.formatNumberWithCommas(newAmount),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  handleCommitAmount = (value) => {\n    this.setState(\n      {\n        amount: value.replace(/,/g, ''),\n        commaAmount: this.formatNumberWithCommas(value)\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  }\n\n  formatNumberWithCommas = (number) => {\n    return number.toLocaleString('en-IN');\n  };\n\n  getSliderSettings() {\n    return {\n      dots: false,\n      infinite: false,\n      speed: 500,\n      slidesToShow: 1,\n      slidesToScroll: 1\n    };\n  }\n\n  handleClickImage = (image) => {\n    this.setState({\n      current: image,\n    });\n  }\n\n  handleCloseModal = () => {\n    this.setState({\n      current: '',\n    });\n  }\n\n  render() {\n    const myStyle = {\n      color: \"white\",\n      fontSize: \"17px\",\n      padding: \"50px\",\n      // justifyItem:\"center\"1\n    };\n    const genExtra = () => (\n      <>\n        {/* <PlusOutlined\n        onClick={event => {\n          // If you don't want click extra trigger collapse, you can prevent this:\n          event.stopPropagation();\n        }}\n      /> */}\n      </>\n    );\n    const settings = this.getSliderSettings();\n    const { images, current } = this.state;\n\n    return (\n      <>\n        {this.state.is_deal_visible == true ? (\n          <div style={{ display: this.state.show_data }}>\n            <WebHeader />\n            <section\n              className=\"deals-details-page\"\n              style={{ marginBottom: \"-50px\" }}\n            >\n              <div className=\"container main-section\">\n                <div className=\"row\">\n                  <div className=\"col-lg-5 col-md-5 col-sm-5\">\n                    <Spin spinning={this.state.loading}>\n                      <div className=\"d-flex justify-content-between align-items-center\">\n                        <div className=\"d-flex align-items-center\">\n                          {/* Image is static */}\n                          <img\n                            src=\"./assets/images/deals-details/Invidata/logo.png\"\n                            alt=\"\"\n                            className=\"img-fluid\"\n                            style={{\n                              marginRight: \"20px\",\n                              width: \"50%\",\n                              objectFit: \"contain\",\n                            }}\n                          />\n                          <h5 className=\"ml-5 mt-4\">Invidata</h5>\n                          {/* <h5>{this.state.logo}</h5> */}\n                        </div>\n                        {this.state.isPrivate == true && (\n                          <div\n                            className=\"private-tag\"\n                            style={{\n                              height: 38,\n                            }}\n                          >\n                            <span style={{ fontSize: 12 }}>Private</span>{\" \"}\n                          </div>\n                        )}\n                      </div>\n                      <div className=\"d-flex tags\">\n                        {this.state.tags.length > 0 &&\n                          this.state.tags.map((tag, index) => (\n                            <div\n                              className=\"hero-tag\"\n                              key={index}\n                              style={{\n                                background: \"rgb(41 23 111)\",\n                                color: \"#fff\",\n                              }}\n                            >\n                              {tag}\n                            </div>\n                          ))}\n                      </div>\n\n                      <p style={{ textAlign: \"justify\" }}>\n                        Invidata Private Ltd is a startup specializing in data security, particularly in cyber security. They have developed a unique technology called \"IUP\" or \"Invisible Unicode Programming\" Technology. This innovative technology converts data into Zero Byte, making it invisible even to RAM. Their aim is to provide comprehensive protection to data files by rendering them non-accessible, non-hackable, non-transferable, and non-corruptible. They target the untapped market of data security by offering a higher level of security compared to existing solutions.\n                      </p>\n                      <div className=\" percentage-container\">\n                        <div className=\"percentage-values\">\n                          {this.state.coming_soon_days ? (\n                            <>\n                              <div>\n                                <h3>{this.state.percentage_raised}%</h3>\n                                <span>RAISED</span>\n                              </div>\n                              <div style={{ textAlign: \"right\" }}>\n                                <h3>{this.state.coming_soon_days} Days</h3>\n                                <span>CAMPAIGN START IN</span>\n                              </div>\n                            </>\n                          ) : (\n                            <>\n                              <div>\n                                <h3>{this.state.percentage_raised}%</h3>\n                                <span>RAISED</span>\n                              </div>\n                              <div style={{ textAlign: \"right\" }}>\n                                <h3>{this.state.dealenddays} Days</h3>\n                                <span>CAMPAIGN ENDS IN</span>\n                              </div>\n                            </>\n                          )}\n                        </div>\n                        <Progress\n                          percent={this.state.percentage_raised}\n                          strokeColor={{\n                            \"0%\": \"rgb(255 156 26)\",\n                            \"100%\": \"rgb(255 156 26)\",\n                          }}\n                          showInfo={false}\n                        />\n                      </div>\n                      {!this.state.investor_id ? (\n                        <div className=\"button-group text-center\">\n                          <a className=\"prime-bg\" href=\"/Login\">\n                            Login\n                          </a>\n                          {/* <button className='share-button'>\n                        <i className='bx bxs-share'></i>\n                      </button> */}\n                        </div>\n                      ) : (\n                        <>\n                          {this.state.button_show_status == true ? (\n                            <>\n                              <div className=\"button-group\">\n                                {this.state.isFunded == true ? (\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg text-center\"\n                                  >\n                                    Deal is closed\n                                  </a>\n                                ) : this.state.user_type != \"founder\" &&\n                                  this.state.invest_amt !== null ? (\n                                  <div className=\"button-group\">\n                                    <p>{`You have committed Rs. ${this.state.invest_amt} to this deal so far. (Including platform fees)`}</p>\n                                    <a\n                                      href=\"#!\"\n                                      style={{ padding: \"13px 0\" }}\n                                      onClick={() => {\n                                        this.getpostData();\n                                        this.showModal1();\n                                      }}\n                                      className=\"black-button prime-bg text-center\"\n                                      id=\"btn-invest\"\n                                    >\n                                      Add more\n                                    </a>\n                                  </div>\n                                ) : this.state.isPrivate == true &&\n                                  this.state.user_type != \"founder\" ? (\n                                  <a\n                                    style={{ padding: \"13px 0\" }}\n                                    href=\"#\"\n                                    onClick={() => {\n                                      this.getpostData();\n                                      this.showModal1();\n                                    }}\n                                    className=\"black-button prime-bg text-center\"\n                                  >\n                                    Express Your Interest\n                                  </a>\n                                ) : this.state.user_type == \"founder\" ? (\n                                  <div>\n                                    {this.state.user_type == \"founder\" &&\n                                      this.state.founder_is_investor == \"1\" ? (\n                                      <a\n                                        href=\"#\"\n                                        style={{ padding: \"15px 0\" }}\n                                        className=\"black-button prime-bg text-center\"\n                                        onClick={() => {\n                                          this.getpostData();\n                                          this.showModal1();\n                                        }}\n                                      >\n                                        Express Your Interest\n                                      </a>\n                                    ) : (\n                                      <a\n                                        href=\"/founder-as-investor\"\n                                        className=\"black-button prime-bg text-center\"\n                                      >\n                                        Apply as investor\n                                      </a>\n                                    )}\n                                  </div>\n                                ) : (\n                                  <div>\n                                    {this.state.user_type == \"investor\" &&\n                                      this.state.invest_amt === null ? (\n                                      <a\n                                        href=\"#\"\n                                        className=\"black-button prime-bg text-center\"\n                                        onClick={() => {\n                                          this.getpostData();\n                                          this.showModal1();\n                                        }}\n                                        style={{ padding: \"13px 0\" }}\n                                      >\n                                        Express Your Interest\n                                      </a>\n                                    ) : null}\n                                  </div>\n                                )}\n                                {/* <button className='share-button'>\n                              <i className='bx bxs-share'></i>\n                            </button> */}\n                              </div>\n                            </>\n                          ) : (\n                            // <div className='button-group'>\n                            //   <a href=\"#\" className=\"black-button prime-bg\" style={{cursor:'default'}} >Coming soon..</a>\n                            // </div>\n                            <>\n                              {this.state.deal_regular_end_date_status == 0 ? (\n                                <div className=\"button-group\">\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg\"\n                                    style={{ cursor: \"default\" }}\n                                  >\n                                    Coming soon..\n                                  </a>\n                                </div>\n                              ) : (\n                                <div className=\"button-group\">\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg\"\n                                    style={{ cursor: \"default\" }}\n                                  >\n                                    Deal is closed\n                                  </a>\n                                </div>\n                              )}\n                            </>\n                          )}\n                        </>\n                      )}\n                    </Spin>\n                  </div>\n                  <Modal\n                    title={`Invest in ${this.state.deal_name}`}\n                    visible={this.state.investmentmodal}\n                    onOk={this.handleOk1}\n                    onCancel={this.handleCancel1}\n                    width={600}\n                    footer={false}\n                  >\n                    <div className=\"row modal-body\">\n                      <div className=\"login mt-3\">\n                        <label>\n                          <b>\n                            Amount: <br />\n                            Minimum investment Rs. {this.formatNumberWithCommas(this.state.minamount)} <br />\n                            Cap Table entry is Rs. {this.formatNumberWithCommas(this.state.captable_threshold_amount)}\n                          </b>\n                        </label>\n                        <input\n                          type=\"text\"\n                          name=\"amount\"\n                          className=\"form-input-field mt-4\"\n                          autofocus={true}\n                          placeholder=\"amount\"\n                          style={{\n                            border:\n                              this.state.amount_error_status == true &&\n                                this.state.amount\n                                ? \"1px solid red\"\n                                : \"1px solid transparent\",\n                          }}\n                          id=\"selected-field\"\n                          value={this.state.commaAmount}\n                          onChange={(e) => { this.handleCommitAmount(e.target.value) }}\n                        />\n                        <div className=\"d-flex justify-content-between mb-3\">\n                          <button className=\"commit-plus\" onClick={this.decrease_commit}>-</button>\n                          <button className=\"commit-minus\" onClick={this.increase_commit}>+</button>\n                        </div>\n                        {this.state.amount_error_status == true && (\n                          <p\n                            className=\"text-danger pb-0\"\n                            style={{ position: \"relative\", top: -19 }}\n                          >\n                            {this.state.amount_error}\n                          </p>\n                        )}\n                      </div>\n\n                      <div class=\"form-group form-check d-flex\">\n                        <Checkbox\n                          checked={this.state.checkWallet}\n                          onChange={(e) => {\n                            this.setState(\n                              { checkWallet: e.target.checked },\n                              () => this.calculategst()\n                            );\n                          }}\n                        >\n                          {\" \"}\n                        </Checkbox>\n                        <label className=\"form-check-label\">\n                          Use Your ₹ {this.state.walletMoney} Growth91\n                          <sup style={{ fontSize: \"0.6rem\" }}>\n                            TM\n                          </sup> Money{\" \"}\n                        </label>\n                      </div>\n                      <div className=\" d-flex justify-content-center modal-table\">\n                        <table\n                          className=\"col-12 m-5 investment-charge-table\"\n                          cellPadding={4}\n                        >\n                          <tr>\n                            <th>\n                              <strong>Particulars</strong>\n                            </th>\n                            <th>\n                              <strong>Amount</strong>\n                            </th>\n                          </tr>\n                          <tr>\n                            <td>Investment Amount</td>\n                            <td lassName=\"text-center\">\n                              ₹{\" \"}\n                              {this.state.amountplusgst\n                                ? this.state.amountplusgst\n                                : \"0\"}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>\n                              Convenience Fees\n                              <br />\n                              <span>{this.state.label}</span>\n                            </td>\n                            <td lassName=\"text-center\">\n                              ₹ {this.state.processingfees}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>Wallet Money</td>\n                            <td lassName=\"text-center\">\n                              - ₹ {this.state.walletDeductionMoney}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>Total</td>\n                            <td>\n                              ₹ {parseFloat(this.state.totalamount).toFixed(0)}\n                            </td>\n                          </tr>\n                        </table>\n                      </div>\n                      {this.state.invest_amt !== null ? (\n                        <div className=\"\">\n                          <Alert\n                            message={`You have committed Rs. ${this.state.invest_amt} to this deal so far. (Including platform fees)`}\n                            type=\"info\"\n                          />\n                        </div>\n                      ) : null}\n                      <div className=\"m-3\">\n                        <label className=\"container-check\">\n                          I Agree to Terms and Conditions and have read the\n                          Privacy Policy. And, I understand that I will be\n                          required to pay the full amount committed after the\n                          deal is closed.\n                          <input\n                            type=\"checkbox\"\n                            name=\"agree\"\n                            onChange={this.onChangeCheckbox}\n                          />\n                          <span className=\"checkmark\"></span>\n                        </label>\n\n                        {/* <label className=\"container-check\">I will deduct TDS on service charges and deposit to Income tax on time\n                      <input type=\"checkbox\" name=\"deduct\" onChange={this.onChangeCheckbox}  />\n                      <span className=\"checkmark\"></span>\n                    </label> */}\n                      </div>\n\n                      <div className=\"col-12\">\n                        {this.state.amount_error_status == true ? (\n                          <button\n                            type=\"button\"\n                            className=\"login-button text-center\"\n                            style={{\n                              border: \"1px solid #9a9a9a\",\n                              backgroundColor: \"#9a9a9a\",\n                              cursor: \"not-allowed\",\n                              padding: \"0.9em 0 \",\n                            }}\n                          >\n                            Express Your Interest\n                          </button>\n                        ) : (\n                          <InvestmentMembershipmodal\n                            processingfees={this.state.processingfees}\n                            deal_id={this.state.deal_id}\n                            membership_type={this.state.check_membership_type}\n                            invest={this.invest}\n                            amount={this.state.amount}\n                            agreecheck={this.state.agreeCheck}\n                            totalamount={this.state.totalamount}\n                            fee={this.state.legalfee}\n                            minamount={this.state.minamount}\n                            maxamount={this.state.maxamount}\n                            agree={this.state.agree}\n                            error_status={this.state.amount_error_status}\n                            investor_id={this.state.investor_id}\n                            deduct={this.state.deduct}\n                            tdsstatus={this.state.tdsstatus}\n                            gst={this.state.gst}\n                            order_token={this.state.order_token}\n                            legalfee={this.state.legalfee}\n                            walletDeductionMoney={\n                              this.state.walletDeductionMoney\n                            }\n                            user_id={this.state.investor_id}\n                            escrow_account_ifsc={this.state.escrow_account_ifsc}\n                            escrowact={this.state.escrowact}\n                            interested_id={this.state.interested_id}\n                            invest_amt={this.state.invest_amt}\n                          />\n                        )}\n                      </div>\n                    </div>\n                  </Modal>\n                  <Modal\n                    title=\"Deduct TDS\"\n                    visible={this.state.confirmmodalstatus}\n                    onOk={this.handleOk2}\n                    onCancel={this.handleCancel2}\n                    width={700}\n                    footer={false}\n                  >\n                    <div className=\"row\">\n                      <div style={{ width: \"100%\" }}>\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          TDS is applicable according to Section-194j of the\n                          income Tex act, 1961.\n                        </p>\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          Rate: 10%\n                        </p>{\" \"}\n                        <br />\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          <b>Do you want to Deduct TDS?</b>\n                        </p>\n                      </div>\n\n                      <div className=\"col-11\">\n                        <button\n                          type=\"button\"\n                          className=\"login-button bg-primary mt-4 mx-4\"\n                          onClick={() => this.invest()}\n                        >\n                          Yes\n                        </button>\n                        <input\n                          type=\"button\"\n                          value=\"No Thanks\"\n                          onClick={() => this.invest()}\n                          className=\"login-button mx-4 my-3\"\n                        ></input>\n                      </div>\n                    </div>\n                  </Modal>\n                  <div className=\"col-lg-7 deal-banner\">\n                    {this.state.youtube_url && (\n                      <iframe\n                        style={{\n                          boxShadow: \"0px 0px 2rem -0.5rem rgb(0 0 0 / 40%)\",\n                          borderRadius: 3,\n                          // marginLeft: 65,\n                        }}\n                        width=\"100%\"\n                        height=\"335\"\n                        src={this.state.youtube_url}\n                        title=\"YouTube video player\"\n                        frameBorder=\"0\"\n                        allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                        allowFullScreen\n                      ></iframe>\n                    )}\n                    {!this.state.youtube_url && (\n                      <img\n                        src=\"./assets/images/deals-details/Invidata/pitch/PitchDeck_page-0001.jpg\"\n                        width=\"100%\"\n                        style={{ height: \"auto\" }}\n                      />\n                      // <video controls width=\"100%\" style={{ height: \"auto\" }}>\n                      //   <source\n                      //     src=\"./assets/videos/deals-details/Invidata/Invidata.mp4\"\n                      //     type=\"video/mp4\"\n                      //   />\n                      //   Sorry, your browser doesn't support videos.\n                      // </video>\n                    )}\n                  </div>\n\n                  <div\n                    className=\"container highlight-section\"\n                    style={{\n                      marginBottom: \"-80px !important\",\n                      padding: \"0px !important\",\n                    }}\n                  >\n                    <h1 style={{ fontSize: \"2rem\", marginBottom: \"30px\" }}>\n                      Highlights\n                    </h1>\n                    <div className=\"row\">\n                      <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/Petmojo/highlight01.jpg\" />\n                          <p style={{ padding: \"1px !important\" }}>\n                            Invidata's goal is to establish their IUP Technology as the go-to solution for data security, leveraging their innovative concept and unique approach to protection.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/highlight2.jfif\" />\n                          <p style={{ padding: \"0px !important\" }}>\n                            With a focus on both domestic and international markets, Invidata aims to leverage the popularity of Windows-based systems, which constitute a significant portion of the global market.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/highlight3.jpg\" />\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            The startup's approach to data security, involving zero-byte INVI-layer protection and the concept of making data invisible to RAM, sets it apart from traditional methods.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/Petmojo/highlight4.jpg\" />\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            Invidata has the potential to revolutionize how organizations and individuals safeguard their sensitive information.\n                          </p>\n                        </div>\n                      </div>\n                      {/* <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/Petmojo/highlight5.png\" />\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            Positioned for success with a scalable revenue model and strong value proposition.\n                          </p>\n                        </div>\n                      </div> */}\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </section>\n            <div className=\"deals-page\">\n              <div className=\"tab-wrapper\">\n                <div className=\"container\">\n                  <div className=\"row\">\n                    <div\n                      className=\"col-lg-12 col-md-12 col-sm-12\"\n                      style={{\n                        marginTop: 110,\n                      }}\n                    >\n                      <Tabs\n                        defaultActiveKey=\"1\"\n                        centered\n                        style={{ marginBottom: \"30px !important\" }}\n                      >\n                        <TabPane tab=\"Details\" key=\"2\">\n                          <div className=\"deal-terms-section\">\n                            <div\n                              className=\"container\"\n                              style={{ marginTop: \"1px !important\" }}\n                            >\n                              <div className=\"row\">\n                                <div className=\"col-lg-10 m-auto\">\n                                  <h1>Documents</h1>\n                                  <div className=\"row document-section\">\n                                    <div className=\"col-lg-2\"></div>\n                                    <div className=\"col-lg-8\">\n                                      <div\n                                        className=\"download-section\"\n                                        style={{\n                                          backgroundColor: \"white\",\n                                          padding: \"4rem 19px\",\n                                        }}\n                                      >\n                                        <>\n                                          <div>\n                                            <table\n                                              className=\"download-document-table\"\n                                              style={{ width: \"100%\" }}\n                                            >\n                                              <tr\n                                                style={{\n                                                  background: \"#29176f\",\n                                                  color: \"#fff\",\n                                                }}\n                                              >\n                                                <th>Sr no</th>\n                                                <th>Document</th>\n                                                <th>Type</th>\n                                                <th>Download</th>\n                                              </tr>\n                                              {this.state.documents.length >\n                                                0 &&\n                                                this.state.documents.map(\n                                                  (item, index) => {\n                                                    let documentlink = `${process.env.REACT_APP_BASE_URL}api/uploads/docs/${item.documentid}/${item.document}`;\n                                                    return (\n                                                      <tr\n                                                        key={index}\n                                                        style={{ height: 70 }}\n                                                      >\n                                                        {/* <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {item.paid ==\n                                                            \"Paid\" && (\n                                                            <>\n                                                              {this.state\n                                                                .check_membership_type ==\n                                                                \"premium\" &&\n                                                              item.premium_price !=\n                                                                \"0\" &&\n                                                              item.premium_price !=\n                                                                \"\" ? (\n                                                                <>\n                                                                  {item.user_paid ==\n                                                                  false ? (\n                                                                    <Checkbox\n                                                                      onChange={() =>\n                                                                        this.show_selected_checkbox(\n                                                                          item\n                                                                        )\n                                                                      }\n                                                                      value={\n                                                                        item.selected\n                                                                      }\n                                                                    ></Checkbox>\n                                                                  ) : (\n                                                                    <>\n                                                                      {item.user_paid ==\n                                                                        true && (\n                                                                        <img\n                                                                          src=\"./paid.png\"\n                                                                          style={{\n                                                                            maxWidth: 20,\n                                                                          }}\n                                                                        />\n                                                                      )}\n                                                                    </>\n                                                                  )}\n                                                                </>\n                                                              ) : (\n                                                                <>\n                                                                  {this.state\n                                                                    .check_membership_type ==\n                                                                    \"regular\" &&\n                                                                    item.regular_price !=\n                                                                      \"0\" &&\n                                                                    item.regular_price !=\n                                                                      \"\" &&\n                                                                    item.user_paid ==\n                                                                      false && (\n                                                                      <Checkbox\n                                                                        onChange={() =>\n                                                                          this.show_selected_checkbox(\n                                                                            item\n                                                                          )\n                                                                        }\n                                                                        value={\n                                                                          item.selected\n                                                                        }\n                                                                      ></Checkbox>\n                                                                    )}\n                                                                </>\n                                                              )}\n                                                            </>\n                                                          )}\n                                                        </td> */}\n                                                        <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {index + 1}\n                                                        </td>\n                                                        <td\n                                                          style={{ width: 140 }}\n                                                        >\n                                                          {item.docname}\n                                                        </td>\n                                                        <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {item.paid == \"Paid\"\n                                                            ? this.state\n                                                              .check_membership_type ==\n                                                              \"premium\"\n                                                              ? item.premium_price ==\n                                                                \"0\"\n                                                                ? \"Free\"\n                                                                : \"₹\" +\n                                                                item.premium_price\n                                                              : item.regular_price ==\n                                                                \"0\"\n                                                                ? \"Free\"\n                                                                : \"₹\" +\n                                                                item.regular_price\n                                                            : \"Free\"}\n                                                        </td>\n                                                        <td\n                                                          style={{ width: 50 }}\n                                                        >\n                                                          {this.state\n                                                            .investor_id && (\n                                                              <center>\n                                                                {(item.user_paid ==\n                                                                  true ||\n                                                                  item.paid ==\n                                                                  \"Free\") && (\n                                                                    <a\n                                                                      href={\n                                                                        documentlink\n                                                                      }\n                                                                      target=\"_blank\"\n                                                                      style={{\n                                                                        width: 80,\n                                                                      }}\n                                                                    >\n                                                                      <img\n                                                                        src=\"./download.ico\"\n                                                                        style={{\n                                                                          maxWidth: 50,\n                                                                        }}\n                                                                      />\n                                                                    </a>\n                                                                  )}\n                                                                {item.paid ==\n                                                                  \"Paid\" &&\n                                                                  this.state\n                                                                    .check_membership_type ==\n                                                                  \"premium\" &&\n                                                                  (item.premium_price ==\n                                                                    \"0\" ? (\n                                                                    <a\n                                                                      href={\n                                                                        documentlink\n                                                                      }\n                                                                      target=\"_blank\"\n                                                                      style={{\n                                                                        width: 80,\n                                                                      }}\n                                                                    >\n                                                                      <img\n                                                                        src=\"./download.ico\"\n                                                                        style={{\n                                                                          maxWidth: 50,\n                                                                        }}\n                                                                      />\n                                                                    </a>\n                                                                  ) : (\n                                                                    \"\"\n                                                                  ))}\n                                                              </center>\n                                                            )}\n                                                        </td>\n                                                      </tr>\n                                                    );\n                                                  }\n                                                )}\n                                            </table>\n                                          </div>\n                                        </>\n                                        {this.state.button_status == false && (\n                                          <button\n                                            className=\"download-button\"\n                                            onClick={() => this.documentPay()}\n                                          >\n                                            Pay\n                                          </button>\n                                        )}\n                                        {!this.state.investor_id && (\n                                          <>\n                                            <button\n                                              className=\"download-button\"\n                                              style={{\n                                                background: \"rgb(41 23 111)\",\n                                              }}\n                                              onClick={() =>\n                                                window.location.assign(\"/login\")\n                                              }\n                                            >\n                                              Login to View\n                                            </button>\n                                            {/* <em\n                                            style={{\n                                              fontSize: 14,\n                                              fontWeight: \"700\",\n                                            }}\n                                          >\n                                            Become Growth91\n                                            <sup style={{ fontSize: \"0.6rem\" }}>\n                                              TM\n                                            </sup>{\" \"}\n                                            member to access the document{\" \"}\n                                          </em> */}\n                                          </>\n                                        )}\n                                      </div>\n                                    </div>\n                                    <div className=\"col-lg-2\"></div>\n                                  </div>\n\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"-30px !important\",\n                                      marginTop: \"30px\",\n                                    }}\n                                  >\n                                    Deal Terms\n                                  </h1>\n                                  <div\n                                    className=\"\"\n                                    style={{ marginTop: \"0px !important\" }}\n                                  >\n                                    <div className=\"container\">\n                                      <div className=\"row\">\n                                        <div className=\"col-lg-12\">\n                                          <div className=\"info\">\n                                            <span>End Date</span>\n                                            <h4\n                                              style={{\n                                                textTransform: \"Capitalize\",\n                                              }}\n                                            >\n                                              {this.state.deal_regular_end_date\n                                                ? moment(\n                                                  this.state\n                                                    .deal_regular_end_date\n                                                ).format(\"MMM DD, YYYY\")\n                                                : \"\"}\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span> Min Investment</span>\n                                            <h4>₹ 3 Lakhs</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Valuation</span>\n                                            <h4>\n                                              ₹ 40 Cr\n                                            </h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"0px\",\n                                      marginTop: \"20px\",\n                                    }}\n                                  >\n                                    Company Details\n                                  </h1>\n                                  <section\n                                    className=\"deal-about-artment-section\"\n                                    style={{ marginTop: \"50px\" }}\n                                  >\n                                    <div className=\"container\">\n                                      <div className=\"row\">\n                                        <div className=\"col-lg-12\">\n                                          <div className=\"info\">\n                                            <span>Legal Name</span>\n                                            <h4>Invidata Private Limited</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Founded</span>\n                                            <h4>29th November 2021</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Status</span>\n                                            <h4>Private Limited Company</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Employees</span>\n                                            <h4>7</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Website</span>\n                                            <h4>\n                                              <a\n                                                style={{\n                                                  color: \"rgb(7, 211, 252)\",\n                                                }}\n                                                href=\"www.invidata.tech\"\n                                                target=\"_blank\"\n                                              >\n                                                www.invidata.tech\n                                              </a>\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Social Links</span>\n                                            <div className=\"social-icons\">\n                                              <a href=\"https://www.facebook.com/invidata\">\n                                                <i className=\"bx bxl-facebook fs-19\"></i>\n                                              </a>\n                                              <a href=\"https://www.linkedin.com/company/invidatatechnology/\">\n                                                <i className=\"bx bxl-linkedin fs-19\"></i>\n                                              </a>\n                                              <a href=\"https://instagram.com/invidata?igshid=MzRlODBiNWFlZA==\">\n                                                <i className=\"bx bxl-instagram fs-19\"></i>\n                                              </a>\n                                              {/* <a href=\"https://www.youtube.com/channel/UCGSO5fKYSUCBtiDpc2lSoLA\">\n                                              <i className=\"bx bxl-youtube fs-19\"></i>\n                                            </a> */}\n                                            </div>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Address</span>\n                                            <h4>87,Shakun,  Toshnival Layout, Akola- 444001.</h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </section>\n                                </div>\n                              </div>\n                            </div>\n\n                            <div\n                              className=\"container home-decor-section mt-0\"\n                              style={{ marginTop: \"3px !important\" }}\n                            >\n                              <h1\n                                className=\"text-center\"\n                                style={{\n                                  marginBottom: \"20px\",\n                                  marginTop: \"0px !important\",\n                                }}\n                              >\n                                Market Overview\n                              </h1>\n                              <div className=\"row\">\n                                <div className=\"col-lg-4\">\n                                  <div className=\"single text-center h-lg\">\n                                    {/* <h2 style={{paddingBottom:\"20px\"}}>$1 Tn </h2> */}\n                                    <p\n                                      style={{\n                                        color: \"white\",\n                                        fontSize: \"21px\",\n                                        padding: \"2px\",\n                                        margin: \"48px 0px\",\n                                      }}\n                                    >\n                                      End-user spending for the information security and risk management market will grow to $188.1 billion in current USD in 2023, with a constant currency growth of 13.9%. The market will reach $288.5 billion in 2027, with a CAGR of 11.0% (2022 to 2027) in constant currency.\n                                    </p>\n                                  </div>\n                                </div>\n                                <div className=\"col-lg-4\">\n                                  <div className=\"single text-center h-lg\">\n                                    {/* <h2 style={{paddingBottom:\"20px\"}}>$200 Bn</h2> */}\n                                    <p\n                                      style={{\n                                        color: \"white\",\n                                        fontSize: \"21px\",\n                                        padding: \"2px\",\n                                        margin: \"63px 0px\",\n                                      }}\n                                    >\n                                      Data Security Market global growth trends:\n                                      2021: Growth: 6.0%, Spending: $ 3,193 million\n                                      2022: Growth: 9.6%, Spending: $ 3,500 million\n                                      2023: Growth: 14.2% Spending: $ 3,997 million\n                                    </p>\n                                  </div>\n                                </div>\n\n                                <div className=\"col-lg-4\">\n                                  <div className=\"single text-center h-lg\">\n                                    {/* <h2 style={{paddingBottom:\"20px\"}}>$200 Bn</h2> */}\n                                    <p\n                                      style={{\n                                        color: \"white\",\n                                        fontSize: \"21px\",\n                                        padding: \"2px\",\n                                        margin: \"51px 0px\",\n                                      }}\n                                    >\n                                      {\" \"}\n                                      By 2025, $10.5 Trillion per year is the estimated cost to businesses worldwide by cybercrime.\n                                    </p>\n                                  </div>\n                                </div>\n                              </div>\n                              <div className=\"text-center fs-4\">\n                                <span style={{ color: \"#000\" }}>Source: </span>\n                                <span style={{ color: \"rgb(127, 119, 118)\" }}>\n                                  Multiple publicly available research and\n                                  survey reports\n                                </span>\n                              </div>\n                              <p className=\"\"> </p>\n                              <div className=\"text-center fluid-container\"></div>\n                            </div>\n\n                            <div\n                              className=\"\"\n                              style={{\n                                backgroundColor: \"white\",\n                                marginTop: \"1px !important\",\n                              }}\n                            >\n                              <h1\n                                style={{\n                                  fontSize: 32,\n                                  marginBottom: 30,\n                                  textAlign: \"center\",\n                                  marginTop: \"-10px !important\",\n                                }}\n                              >\n                                Investor Presentation\n                              </h1>\n                              <Slider {...settings} className=\"mb-5 pitch-slider\">\n                                {images.map((image, index) => (\n                                  <img\n                                    key={index}\n                                    src={image}\n                                    onClick={() => this.handleClickImage(image)}\n                                  />\n                                ))}\n                              </Slider>\n                              {current && (\n                                <Lightbox\n                                  mainSrc={current}\n                                  onCloseRequest={this.handleCloseModal}\n                                />\n                              )}\n                            </div>\n                          </div>\n                          {/* start */}\n\n                          <div\n                            className=\"deals-page\"\n                            style={{\n                              marginTop: \"50px !important\",\n                            }}\n                          >\n                            <div className=\"tab-wrapper\">\n                              <div className=\"container\">\n                                <div className=\"row\">\n                                  <div className=\"col-lg-12\">\n                                    <Tabs defaultActiveKey=\"1\" centered>\n                                      <TabPane tab=\"FAQ\" key=\"1\">\n                                        <section\n                                          className=\"faq-section\"\n                                          style={{\n                                            margin: \"0px\",\n                                            padding: \"0px\",\n                                            background: \"none\",\n                                          }}\n                                        >\n                                          <div className=\"\">\n                                            <div className=\"row\">\n                                              <div className=\"col-lg-12 col-md-12 col-sm-12 m-auto\">\n                                                <h1 className=\"text-center mb-4\">\n                                                  About {this.state.deal_name}\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['1']}\n                                                  onChange={this.callback1}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"Are you focused on product or service?\"\n                                                    key=\"1\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        Invidata offers a unique data security concept called IUP (Invisible Unicode Programming) Technology, which is a product. However, their focus is on providing a comprehensive solution that combines this technology with associated services for effective data protection.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"what are the challanges for scale up and how these will be managed?\"\n                                                    key=\"2\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        Challenges in scaling up Invidata include raising awareness about their IUP Technology, convincing potential customers of its effectiveness, and establishing their brand in a competitive market. To tackle this, targeted marketing, proofs of concept, early adopter engagement, and partnerships will be key strategies.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"Are you targeting new untapped market?Justify\"\n                                                    key=\"7\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        1. Yes, Invidata is targeting an untapped market with their innovative IUP (Invisible Unicode Programming) Technology.\n                                                      </p>\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        2. They aim to provide a unique and advanced data security solution that addresses the limitations of existing methods.\n                                                      </p>\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        3. By offering a higher level of protection for data files through their technology, Invidata is aiming to capture a segment of the market that seeks more effective and comprehensive data security solutions.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"what are your moats?\"\n                                                    key=\"4\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                        }}\n                                                      >\n                                                        Invidata's moats include their unique IUP Technology, innovative concept, patent application, early mover advantage, system-level innovation, and strong focus on comprehensive services. These factors set them apart and create a competitive advantage in the data security market.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                                <h1 className=\"text-center mb-2 mt-4\">\n                                                  Growth91 Investment FAQ\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['10']}\n                                                  onChange={this.callback3}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"What is the due diligence process followed by Growth91\"\n                                                    key=\"11\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      At Growth91, we follow\n                                                      stringent due-diligence\n                                                      process. We ask for\n                                                      detailed information about\n                                                      start-up and their team.\n                                                      After the scrutiny and if\n                                                      deemed fit, start-up would\n                                                      be listed on Growth91\n                                                      platform. Independent\n                                                      investment opinion and\n                                                      due-diligence report\n                                                      prepared by external\n                                                      qualified experts are made\n                                                      available for investors.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"Do you offer any guarantee on returns?\"\n                                                    key=\"12\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      No, we do not guarantee\n                                                      any returns. The startup\n                                                      which is raising the money\n                                                      is also not guaranteeing\n                                                      any specific returns. In\n                                                      principle, it is not\n                                                      legally correct for the\n                                                      company to provide any\n                                                      guarantee about returns on\n                                                      equity linked securities.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the refund process in case I don’t receive any allocation?\"\n                                                    key=\"13\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      If an investor doesn’t\n                                                      receive the allocation,\n                                                      the investment amount will\n                                                      be refunded to the bank\n                                                      account from which the\n                                                      investment has been made.\n                                                      As per Growth91 policy,\n                                                      there will be no interest\n                                                      or compensation on these\n                                                      returned funds.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the exit mechanism available for the investors\"\n                                                    key=\"14\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      The Company and the\n                                                      Promoters shall make all\n                                                      reasonable endeavours to\n                                                      provide exit to the\n                                                      Investors by any of the\n                                                      following ways: 1. Initial\n                                                      Public Offer (IPO) 2.\n                                                      Merger or Acquisition\n                                                      Event 3. Buyout Event 3.\n                                                      Compulsory Call Option\n                                                      with minimum assured\n                                                      returns. (Please refer to\n                                                      investor agreement for\n                                                      more details)\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"In which account Investor’s money are transferred\"\n                                                    key=\"15\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      Money invested by the\n                                                      investor in all public\n                                                      deals are automatically\n                                                      transferred to separate\n                                                      and dedicated escrow\n                                                      account created for\n                                                      respective Startup. The\n                                                      escrow account is managed\n                                                      by authorized trustee.\n                                                      After the funding/deal and\n                                                      documentation formalities\n                                                      are completed, the fund\n                                                      will be transferred to\n                                                      respective startup bank\n                                                      account.\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"I have more questions; how do I contact Growth91?\"\n                                                    key=\"16\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      You can always send your\n                                                      queries to{\" \"}\n                                                      <a href=\"mailto:contact@growth91.com\">\n                                                        contact@growth91.com\n                                                      </a>\n                                                      , we will respond to your\n                                                      queries in shortest\n                                                      possible time.\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                              </div>\n                                            </div>\n                                          </div>\n                                        </section>\n                                      </TabPane>\n                                    </Tabs>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          {/* stop */}\n                        </TabPane>\n                        <TabPane tab=\"Team\" key=\"3\">\n                          <div\n                            className=\"container meet-the-team-section\"\n                            style={{ maxWidth: 921 }}\n                          >\n                            <h2 className=\"text-center\">Meet the Team</h2>\n                            <div className=\"row\">\n                              <div className=\"col-lg-6\">\n                                <div\n                                  className=\"single\"\n                                  style={{ paddingBottom: \"0px !important\" }}\n                                // style={{  marginBottom: 0px !important}}\n                                >\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Invidata/team/Dilip Rai.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Dilip Rai</h3>\n                                      <span>Founder and Director</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        {/* <a\n                                          href=\"https://www.linkedin.com/in/ca-mikdadmerchant/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a> */}\n                                        {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                        <i className=\"bx bxl-gmail\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    Dr. Dilip Rai, a visionary researcher has PHD in psychology, bridges psychology, and computer science.\n                                    <br />\n                                    Invented \"Invisible Unicode Programming\"\n                                    <br />\n                                    published  findings in the esteemed International Journal of Scientific and Engineering Research (IJSER)\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Invidata/team/Ravi Saxena.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Ravi Saxena</h3>\n                                      <span>Director and  Advisor</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        {/* <a\n                                          href=\"https://www.linkedin.com/in/neerajchaporkar\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    Ravi is an alumnus of  I.I.M Ahmedabad,\n                                    <br />\n                                    EX AVERY INDIA, EICHER Tractors, Mahindra & Mahindra, GEI HAMON, MP UNI MagnaTech Ltd.etc\n                                    <br />\n                                    He has worked in MARKETING / OPERATIONS/ HRD functions in different capacities including senior positions like GM(Marketing), GM(Operations), GM(Corporate-HRD), Deputy Chief Executive etc\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Invidata/team/Sanjay Sarda.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Sanjay Sarda</h3>\n                                      <span>Director and Advisor</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        {/* <a\n                                          href=\"https://www.linkedin.com/in/sanmesh-patwa-8553b9162/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    A renowned Business Management Consultant and Strategic Advisor,\n                                    <br />\n                                    Mr. Sanjay Sarda is an alumnus of IIT Kharagpur and IIM Ahmedabad.\n                                    <br />\n                                    His expertise has shaped the success of many startups, making him a respected figure in the industry.\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Invidata/team/Chaitanya Dhareshwar.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Chaitanya Dhareshwar</h3>\n                                      <span>Advisor</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        {/* <a\n                                          href=\"https://www.linkedin.com/in/sanmesh-patwa-8553b9162/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    Entrepreneur and Tech advisor,\n                                    <br />\n                                    14+ years of experience\n                                    known for building successful companies and advising on technology and strategy.\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Invidata/team/Jimish Kapadia.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Jimish Kapadia</h3>\n                                      <span>Advisor</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        {/* <a\n                                          href=\"https://www.linkedin.com/in/sanmesh-patwa-8553b9162/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    19+ experience in Cash Management, Capital Market, Digital Banking, Trade Finance products, Cross Border sales, and Business Development.\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Invidata/team/Dhaval Shah.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Dhaval Shah</h3>\n                                      <span>Advisor</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        {/* <a\n                                          href=\"https://www.linkedin.com/in/sanmesh-patwa-8553b9162/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    18 years of experience in designing/Developing software products, Mobile applications, Enterprise Solutions, IoT, AI, and Blockchain solutions.\n                                  </p>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </TabPane>\n                      </Tabs>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <WebFooter />\n          </div>\n        ) : (\n          window.location.assign(\"/Deals\")\n        )}\n      </>\n    );\n  }\n}\n\nexport default Invidata;\n","/home/akc01/Desktop/projects/Growth91/apps/client/src/app/deal-pages/TestDeal2.js",["8909","8910","8911","8912","8913","8914","8915","8916","8917","8918","8919","8920","8921","8922","8923","8924","8925","8926","8927","8928","8929","8930","8931","8932","8933","8934","8935","8936","8937","8938","8939","8940","8941","8942","8943","8944","8945","8946","8947","8948","8949","8950","8951","8952","8953","8954","8955","8956","8957","8958","8959","8960","8961","8962","8963","8964","8965","8966","8967","8968","8969","8970","8971","8972","8973","8974","8975","8976","8977","8978","8979","8980","8981","8982","8983","8984","8985","8986","8987","8988","8989","8990","8991","8992","8993","8994","8995","8996","8997","8998","8999","9000","9001","9002","9003","9004","9005","9006","9007","9008","9009","9010","9011","9012","9013"],[],"import React, { Component } from \"react\";\nimport WebHeader from \"../common/WebHeader\";\nimport WebFooter from \"../common/WebFooter\";\nimport {\n  Tabs,\n  Collapse,\n  message,\n  Modal,\n  Spin,\n  Checkbox,\n  Progress,\n  Alert,\n} from \"antd\";\nimport axios from \"axios\";\nimport { ExclamationCircleOutlined, PlusOutlined } from \"@ant-design/icons\";\nimport Slider from \"react-slick\";\nimport Lightbox from 'react-image-lightbox';\nimport Apis from \"../constants/Apis\";\nimport moment from \"moment\";\nimport Bridge from \"../constants/Bridge\";\nimport InvestmentMembershipmodal from \"../components/membership/InvestmentMembershipmodal\";\nimport ReactGA from \"react-ga4\";\nimport { TRACKING_ID } from \"../constants/data\";\nReactGA.initialize(TRACKING_ID);\n\nconst { Panel } = Collapse;\nconst { TabPane } = Tabs;\nclass TestDeal2 extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      deal_id: \"\",\n      investor_id: \"\",\n      interested_id: \"\",\n      deal_name: \"\",\n      created_at: \"\",\n      deal_description: \"\",\n      isPrivate: false,\n      isFunded: false,\n      isBlank: false,\n      tags: [],\n      logo: \"\",\n      youtube_url: \"\",\n      dealenddays: 0,\n      kycstatus: false,\n      bankstatus: false,\n      commaAmount: 0,\n      amount: 0,\n      minamount: 0,\n      captable_threshold_amount: 0,\n      maxamount: 0,\n      captable_multiple_amount: 0,\n      investmentmodal: false,\n      confirmmodalstatus: false,\n      deduct: false,\n      agree: \"\",\n      isInvested: false,\n      name: \"\",\n      email: \"\",\n      mobile: \"\",\n      conveniencefees: 100,\n      gst: 0,\n      amountplusgst: 0,\n      processingfees: 0.0,\n      totalamount: 0.0,\n      tdsstatus: false,\n      legalfee: 0.0,\n      legalplusprocessing: 0.0,\n      label: \"\",\n      percentage: 0,\n      check_membership_type: \"\",\n      tdsdeductedamount: 0,\n      order_token: \"\",\n      pdffile: \"\",\n      pitch_files: \"\",\n      pitch_list: [],\n      walletMoney: 0,\n      gstValue: 0,\n      walletDeductionMoney: 0,\n      checkWallet: false,\n      checkDiscount: false,\n      DiscountedMoney: 0,\n      percentage_raised: 0,\n      documents: [],\n      button_status: true,\n      show_data: \"none\",\n      button_show_status: true,\n      amount_error: \"\",\n      amount_error_status: false,\n      multiples_of: 0,\n      founder_is_investor: 0,\n      user_type: \"\",\n      coming_soon_days: \"\",\n      deal_regular_end_date: \"\",\n      is_deal_visible: true,\n      deal_regular_end_date_status: 0,\n      invest_amt: \"\",\n      escrowact: \"\",\n      escrow_account_ifsc: \"\",\n      agreeCheck: false,\n      enable_special_offer: false,\n      special_offer_text: \"\",\n      default_special_offer_text: \"\",\n      offer_discount: \"\",\n      images: [\n        './assets/images/slider/1.png',\n        './assets/images/slider/2.png',\n      ],\n      current: '',\n    };\n  }\n  callback1 = (key) => { };\n  callback2 = (key) => { };\n  callback3 = (key) => { };\n\n  componentWillMount() {\n    document.title = \"TestDeal2 - Growth91 - Startup Marketplace \";\n  }\n  componentDidMount() {\n    let deal_id = \"102\";\n    this.setState({ deal_id: deal_id }, () => {\n      this.get_pitch_list();\n    });\n\n\n    if (\n      localStorage.getItem(\"investor_id\") ||\n      localStorage.getItem(\"founder_id\")\n    ) {\n      if (localStorage.getItem(\"investor_id\")) {\n        let investor_id = localStorage.getItem(\"investor_id\");\n        this.setState(\n          { investor_id: investor_id, user_type: \"investor\" },\n          () => {\n            this.getstatusdata();\n            this.getinvestmentdetails();\n            this.check_for_membership_type();\n            this.getwallethistory();\n            this.get_invest_amt();\n          }\n        );\n      } else if (localStorage.getItem(\"founder_id\")) {\n        this.get_founder_details();\n        this.setState({ user_type: \"founder\" });\n      }\n    } else {\n      this.getDeals();\n    }\n    this.getordertoken();\n    this.getGst();\n    this.get_deal_doucments(deal_id);\n    console.log(\"hello\")\n  }\n  get_founder_details = () => {\n    let params = {\n      founder_id: localStorage.getItem(\"founder_id\"),\n    };\n    Bridge.founder.get_founder_profile_details(params).then((result) => {\n      if (result.status == \"1\") {\n        if (result.data.length > 0) {\n          let investor_id = localStorage.getItem(\"founder_id\");\n          this.setState({ investor_id: investor_id }, () =>\n            this.getwallethistory()\n          );\n          setTimeout(() => {\n            if (result.data[0].is_investor == \"1\") {\n              this.getstatusdata();\n              this.getinvestmentdetails();\n              this.check_for_membership_type();\n              this.setState({ founder_is_investor: \"1\" });\n            } else {\n              this.check_for_membership_type();\n              this.setState({ founder_is_investor: \"0\" });\n            }\n          }, 200);\n        }\n      } else {\n        this.setState({ formloader: false });\n      }\n    });\n  };\n  get_deal_doucments = (deal_id) => {\n    let params = {\n      deal_id: deal_id,\n    };\n    Bridge.get_deal_doucments(params).then((result) => {\n      if (result.status == \"1\") {\n        let arr = [];\n        for (let item of result.data) {\n          item.selected = false;\n          arr = [...arr, item];\n        }\n        this.setState({ documents: arr }, () =>\n          this.get_document_purchased_list()\n        );\n      }\n    });\n  };\n  show_selected_checkbox = (single) => {\n    let arr = [];\n    let docuemnts = this.state.documents;\n    for (let item of docuemnts) {\n      if (item.documentid == single.documentid) {\n        item.selected = item.selected == true ? false : true;\n      }\n      arr = [...arr, item];\n    }\n    this.setState({ docuemnts: arr });\n    let data = [];\n    for (let item2 of arr) {\n      data = [...data, item2.selected];\n    }\n    let status = data.includes(true);\n    this.setState({ button_status: !status });\n  };\n\n  getwallethistory() {\n    if (this.state.investor_id) {\n      let params = {\n        investor_id: this.state.investor_id,\n      };\n      Bridge.investor.get_wallet_history(params).then((result) => {\n        if (result.status == \"1\") {\n          let credit_amount = 0;\n          let debit_amount = 0;\n          for (let item of result.data) {\n            if (item.type == \"credited\") {\n              credit_amount = parseInt(credit_amount) + parseInt(item.amount);\n            }\n            if (item.type == \"debited\") {\n              debit_amount = parseInt(debit_amount) + parseInt(item.amount);\n            }\n          }\n          let total = parseInt(credit_amount - debit_amount);\n          this.setState({ walletMoney: Math.abs(total) });\n        } else {\n        }\n      });\n    }\n  }\n  //for getting gst from admin page\n  getGst = () => {\n    Bridge.admin.settings.getsettings().then((result) => {\n      if (result.status == \"1\") {\n        this.setState({ gst: result.data[0].taxation_percentage });\n      } else {\n        // console.log(\"gst can not be able to fetch\")\n      }\n    });\n  };\n  check_for_membership_type = () => {\n    this.setState({ formloader: true });\n    let params = {\n      investor_id: this.state.investor_id,\n    };\n    Bridge.check_for_membership_type(params).then((result) => {\n      if (result.status == 1) {\n        if (result.data.length > 0) {\n          this.setState({\n            check_membership_type: result.data[0].membership_type,\n          });\n          setTimeout(() => {\n            this.getDeals();\n          }, 500);\n        }\n      } else {\n        this.setState({ formloader: false });\n      }\n    });\n    setTimeout(() => {\n      this.getdealsettings();\n    }, 500);\n  };\n  getordertoken = () => {\n    Bridge.getcashfreetoken().then((result) => {\n      let orderToken = result.order_token;\n      // console.log(orderToken , \"Order Token\")\n      this.setState({ order_token: orderToken });\n    });\n  };\n  // get post list\n  getdealsettings = () => {\n    this.setState({ formloader: true });\n    Bridge.admin.settings.getdealsettings().then((result) => {\n      if (result.status == 1) {\n        // console.log('result',result.data);\n        this.setState({\n          label: result.data[0].label,\n        });\n        if (this.state.check_membership_type == \"premium\") {\n          this.setState({\n            percentage: result.data[0].premium_member_deal_percentage,\n          });\n        } else {\n          this.setState({\n            percentage: result.data[0].regular_member_deal_percentage,\n          });\n        }\n      } else {\n        // message.error(result.message);\n        this.setState({\n          formloader: false,\n        });\n      }\n    });\n  };\n\n  get_pitch_list = () => {\n    this.setState({ loading: true });\n    let params = {\n      deal_id: this.state.deal_id,\n    };\n    Bridge.deal.get_image_list_of_pitch(params).then((result) => {\n      if (result.status == 1) {\n        let arr = [];\n        for (let data of result.data) {\n          let pitchImg =\n            Apis.IMAGEURL +\n            \"deal/pitch_images/\" +\n            data.deal_id +\n            \"/\" +\n            data.image;\n          data.img = pitchImg;\n          arr = [...arr, data];\n        }\n        arr.sort((a, b) =>\n          a.pitch_order > b.pitch_order\n            ? 1\n            : b.pitch_order > a.pitch_order\n              ? -1\n              : 0\n        );\n        // console.log('arr',arr);\n        this.setState({ pitch_list: arr, loading: false });\n      } else {\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  getinvestmentdetails = () => {\n    this.setState({ loading: true });\n    let params = {\n      investor_id: this.state.investor_id,\n      deal_id: this.state.deal_id,\n    };\n    Bridge.investor.getinvestmentdetails(params).then((result) => {\n      if (result.status == 1) {\n        if (result.data != \"\") {\n          this.setState({ isInvested: true });\n        }\n      } else {\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  // get deal list\n  getstatusdata = () => {\n    this.setState({ loading: true });\n    let params = {\n      id: this.state.investor_id,\n    };\n    Bridge.users.getstatusdata(params).then((result) => {\n      if (result.status == 1) {\n        this.setState({\n          kycstatus: result.data[0].kycstatus,\n          bankstatus: result.data[0].ifsc_code ? true : false,\n          loading: false,\n          name: result.data[0].first_name + \" \" + result.data[0].last_name,\n          email: result.data[0].email,\n          mobile: result.data[0].mobile,\n        });\n      } else {\n        message.error(result.message);\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  // get deal list\n  getDeals = () => {\n    this.setState({ loading: true });\n    Bridge.deal.list().then((result) => {\n      console.log(result.data, \"data\")\n      if (result.status == 1) {\n        this.setState({\n          deals: result.data,\n          loading: false,\n        });\n        let current_date = moment();\n        for (let d of result.data) {\n          // console.log(d.deal_id , \"id\")\n          // console.log(this.state.deal_id , \"sid\")\n          if (d.deal_id == this.state.deal_id) {\n            //  console.log(d.deal_status)\n            let deal_regular_show_date = moment(d.regular_show_date);\n            let deal_premium_show_date = moment(d.premium_show_date);\n            let deal_start_dt_rg = moment(d.deal_st_date);\n            let deal_start_dt_prem = moment(d.deal_start_dt_prem);\n            if (this.state.check_membership_type == \"premium\") {\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_show_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({ show_data: \"block\" });\n              } else if (current_date > deal_premium_show_date) {\n                this.setState({ show_data: \"block\" });\n              } else {\n                this.setState({ show_data: \"none\" });\n                window.location.assign(\"/deals\");\n                return;\n              }\n            } else if (this.state.check_membership_type == \"regular\") {\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_show_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({ show_data: \"block\" });\n              } else if (current_date > deal_regular_show_date) {\n                this.setState({ show_data: \"block\" });\n              } else {\n                this.setState({ show_data: \"none\" });\n                window.location.assign(\"/deals\");\n                return;\n              }\n            }\n          }\n          // else{\n          //   // window.location.href = (\"/deals\")\n          //   // return;\n          //   console.log(d.deal_id , this.state.deal_id);\n          // }\n        }\n        for (let d of result.data) {\n          console.log(d)\n          if (d.deal_id == this.state.deal_id) {\n            if (d.show_status == \"0\") {\n              this.setState({ is_deal_visible: false });\n              // window.location.assign(\"/deals\")\n            } else {\n              this.setState({ is_deal_visible: true });\n            }\n            let investor_id = this.state.investor_id;\n            if (d.deal_t_type == \"Private\") {\n              if (\n                investor_id &&\n                d.invitations.length > 0 &&\n                d.invitations.includes(investor_id)\n              ) {\n              } else {\n                window.location.assign(\"/deals\");\n                return;\n              }\n            }\n            let logourl =\n              Apis.IMAGEURL + \"deal/logo/\" + d.deal_id + \"/\" + d.logo;\n\n            let pdffile = `${process.env.REACT_APP_BASE_URL}api/uploads/deal/pitch/${d.deal_id}/${d.pitch_file}`;\n            let pitchImg =\n              Apis.IMAGEURL +\n              \"deal/pitch_images/\" +\n              d.deal_id +\n              \"/\" +\n              d.pitch_files;\n            let percetage_raised = parseFloat(\n              (d.total_invested_amount / d.deal_fund_requested) * 100 +\n              parseInt(d.raiegap)\n            ).toFixed(0);\n            let deal_premium_start_date = moment(d.deal_start_dt_prem);\n            let deal_regular_start_date = moment(d.deal_st_date);\n            let deal_premium_end_date = moment(d.deal_end_dt_prem);\n            let deal_regular_end_date = moment(d.deal_deal_end_date);\n            this.setState({ deal_regular_end_date: deal_regular_end_date });\n            let button_show_status = false;\n\n            // console.log('this.state.check_membership_type',this.state.check_membership_type);\n            // console.log('deal_regular_start_date',deal_regular_start_date);\n            // console.log('deal_regular_end_date',deal_regular_end_date);\n            // console.log('current_date',current_date);\n            // deal changes\n            let differece = \"\";\n            let dealEndDate = \"\";\n            let currentDate = \"\";\n            this.setState({ coming_soon_days: \"\" });\n            if (this.state.check_membership_type == \"premium\") {\n              dealEndDate = moment(d.deal_end_dt_prem).format(\"YYYY-MM-DD\");\n              currentDate = moment().format(\"YYYY-MM-DD\");\n              let days = this.getDifferenceInDays(currentDate, dealEndDate);\n              differece = days;\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") >\n                deal_premium_start_date.format(\"YYYY-MM-DD\") &&\n                moment(current_date).format(\"YYYY-MM-DD\") <\n                moment(deal_premium_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else {\n                button_show_status = false;\n              }\n              //for deal start date\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") <=\n                moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({\n                  coming_soon_days: this.getDifferenceInDays(\n                    moment(current_date).format(\"YYYY-MM-DD\"),\n                    moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n                  ),\n                });\n              }\n            } else if (\n              this.state.check_membership_type == \"regular\" ||\n              this.state.check_membership_type == \"\"\n            ) {\n              dealEndDate = moment(d.deal_end_date).format(\"YYYY-MM-DD\");\n              currentDate = moment().format(\"YYYY-MM-DD\");\n              let days = this.getDifferenceInDays(currentDate, dealEndDate);\n              differece = days;\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") >\n                deal_regular_start_date.format(\"YYYY-MM-DD\") &&\n                moment(current_date).format(\"YYYY-MM-DD\") <\n                moment(deal_regular_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else {\n                button_show_status = false;\n              }\n              //for deal start date\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") <=\n                moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({\n                  coming_soon_days: this.getDifferenceInDays(\n                    moment(current_date).format(\"YYYY-MM-DD\"),\n                    moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n                  ),\n                });\n              }\n            }\n            // console.log('button_show_status',this.state.button_show_status);\n            this.setState(\n              {\n                deal_name: d.name,\n                deal_description: d.Muliples_of,\n                // isBlank:d.deal_status == \"Closed\" ? window.location.href = \"/\" : \"/\",\n                isPrivate: d.deal_t_type == \"Private\" ? true : false,\n                isFunded: d.deal_status == \"Closed\" ? true : false,\n                tags: d.deal_category ? JSON.parse(d.deal_category) : [],\n                logo: logourl,\n                youtube_url: d.youtubelink,\n                dealenddays: differece > 0 ? differece : 0,\n                minamount: Number(d.Min_inv_amt),\n                captable_threshold_amount: parseInt(parseFloat(d.captable_threshold_amount).toFixed(2), 10),\n                maxamount: d.Max_inv_amt,\n                captable_multiple_amount: parseInt(parseFloat(d.captable_multiple_amount).toFixed(2), 10),\n                enable_special_offer: d.enable_special_offer == 'Yes' ? true : false,\n                special_offer_text: d.special_offer_text,\n                default_special_offer_text: d.default_special_offer_text,\n                offer_discount: d.offer_discount,\n                amount: \"\", //d.Min_inv_amt\n                commaAmount: \"\", //d.Min_inv_amt\n                pdffile: pdffile,\n                pitch_files: pitchImg,\n                percentage_raised: percetage_raised,\n                button_show_status: button_show_status,\n                show_data: \"block\",\n                multiples_of: d.multiples_of,\n              },\n              () => this.calculategst()\n            );\n          }\n        }\n      } else {\n        message.error(result.message);\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  getDifferenceInDays = (date1, date2) => {\n    let diff = Math.floor((Date.parse(date2) - Date.parse(date1)) / 86400000);\n    let final = 0;\n    if (diff < 0) {\n      final = 0;\n      this.setState({\n        deal_regular_end_date_status: 1,\n      });\n    } else {\n      final = diff;\n      this.setState({\n        deal_regular_end_date_status: 0,\n      });\n    }\n    return final;\n  };\n\n  showalertmessage = () => {\n    // message.warning('Please complete your KYC process or bank details to access this deal.');\n  };\n\n  showModal1 = () => {\n    if (this.state.kycstatus == \"admin_rejected\") {\n      message.warning(\n        \"Your KYC is Rejected, Please Contact to contact@Growth91<sup>TM</sup>.com\"\n      );\n      return;\n    }\n    this.setState(\n      {\n        investmentmodal: true,\n      },\n      () => {\n        this.calculategst();\n      }\n    );\n  };\n\n  // post api hit on express\n  getpostData = () => {\n    ReactGA.event({\n      category: \"Deal Item Page\",\n      action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, Interest button clicked`,\n    });\n    const formData = new FormData();\n    formData.append('deal_id', this.state.deal_id);\n    formData.append('investor_id', this.state.investor_id);\n    axios.post(`${process.env.REACT_APP_BASE_URL}api/investors/InvestorCommitment/save_investor_interest_deal`, formData, {\n      headers: {\n        'Content-Type': 'multipart/form-data'\n      }\n    })\n      .then((response) => {\n        this.setState({\n          interested_id: response.data.data,\n        })\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  };\n\n  handleOk1 = () => {\n    this.setState({\n      investmentmodal: false,\n    });\n  };\n\n  handleCancel1 = () => {\n    this.setState({\n      investmentmodal: false,\n    });\n  };\n\n  showModal2 = () => {\n    this.setState({\n      confirmmodalstatus: true,\n    });\n  };\n\n  handleOk2 = () => {\n    this.setState({\n      confirmmodalstatus: false,\n    });\n  };\n\n  handleCancel2 = () => {\n    this.setState({\n      confirmmodalstatus: false,\n    });\n  };\n  onChangeCheckbox = (e) => {\n    ReactGA.event({\n      category: \"Deal Item Page\",\n      action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, TnC checkbox clicked. CheckBoxStatus:${e.target.checked}`,\n    });\n    this.setState({\n      [e.target.name]: e.target.checked,\n      agreeCheck: e.target.checked,\n    });\n\n    if (e.target.name == \"deduct\") {\n      if (e.target.checked == true) {\n        let processingfees = parseFloat(\n          (this.state.amount / 100) * parseFloat(this.state.percentage)\n        );\n        let tdsamount = parseFloat(processingfees / 100) * 10;\n        let minusamt = parseFloat(processingfees - tdsamount);\n\n        this.setState({\n          processingfees: minusamt,\n          tdsdeductedamount: tdsamount,\n        });\n      } else {\n        let processingfees = parseFloat(\n          (this.state.amount / 100) * parseFloat(this.state.percentage)\n        );\n        this.setState({\n          processingfees: processingfees,\n          tdsdeductedamount: 0,\n        });\n      }\n    }\n  };\n\n  // investing your money\n  invest = () => {\n    let investor_id = this.state.investor_id;\n    let deal_id = this.state.deal_id;\n    let Investment_amt = this.state.totalamount;\n    let deductstatus = this.state.deduct == true ? \"1\" : \"0\";\n    let agreestatus = this.state.agree == true ? \"1\" : \"0\";\n    let payment_ref = this.state.order_token;\n    let tdsstatus = this.state.tdsstatus == true ? \"1\" : \"0\";\n    let processingfees = this.state.processingfees;\n    let gst = this.state.gst;\n    let legalfees = this.state.legalfee;\n    let order_id = \"order-01\";\n    let walletamt = this.state.walletDeductionMoney\n      ? this.state.walletDeductionMoney\n      : 0;\n\n    let url = `${process.env.REACT_APP_BASE_URL}cashfree/checkout.php?investor_id=${investor_id}&deal_id=${deal_id}&deductstatus=${deductstatus}&agreestatus=${agreestatus}&payment_ref=${payment_ref}&tdsstatus=${tdsstatus}&processingfees=${processingfees}&gst=${gst}&legalfees=${legalfees}&Investment_amt=${Investment_amt}&order_id=${order_id}&wallet=${walletamt}`;\n    // console.log('url',url);\n    window.location.assign(url);\n  };\n\n  loadScript = (src) => {\n    return new Promise((resolve) => {\n      const script = document.createElement(\"script\");\n      script.src = src;\n\n      script.onload = () => {\n        resolve(true);\n      };\n\n      script.onerror = () => {\n        resolve(false);\n      };\n\n      document.body.appendChild(script);\n    });\n  };\n\n  calculategst = () => {\n    let legalfee = parseFloat((this.state.amount / 100) * parseFloat(this.state.percentage));\n    let gst = this.state.gst;\n    let amt = parseFloat(this.state.amount);\n    let walletDeductionMoney;\n\n    let discountedMoney = 0;\n    if (this.state.checkDiscount) {\n      let offerDiscount = parseFloat(this.state.offer_discount);\n      discountedMoney = (legalfee * offerDiscount) / 100;\n    }\n\n    if (this.state.checkWallet == false) {\n      walletDeductionMoney = 0;\n    } else {\n      walletDeductionMoney =\n        legalfee.toFixed(0) <= this.state.walletMoney\n          ? legalfee.toFixed(0)\n          : this.state.walletMoney;\n    }\n\n    let gstValue = ((legalfee.toFixed(0) - walletDeductionMoney) * gst) / 100;\n    let totalAmount = (amt + parseFloat(legalfee)).toFixed(0) - walletDeductionMoney + gstValue;\n\n    legalfee -= discountedMoney;\n\n    this.setState({\n      gst: gst,\n      legalfee: this.state.amount ? legalfee.toFixed(0) : 0,\n      amountplusgst: this.state.amount ? amt.toFixed(0) : 0,\n      processingfees: this.state.amount ? legalfee.toFixed(0) : 0,\n      totalamount: this.state.amount ? totalAmount.toFixed(0) : 0,\n      walletDeductionMoney: walletDeductionMoney,\n      gstValue: gstValue,\n      DiscountedMoney: discountedMoney\n    });\n\n    return gst;\n  };\n  documentPay = () => {\n    ReactGA.event({\n      category: \"Deal Item Page\",\n      action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, Download document Pay button clicked.`,\n    });\n    if (!this.state.investor_id) {\n      message.warning(\"Please login first to invest.\", 5);\n      return;\n    }\n    let documents = this.state.documents;\n    let paying_for_documents = [];\n    let totalamt = 0;\n    for (let item of documents) {\n      if (item.selected == true) {\n        totalamt +=\n          this.state.check_membership_type == \"premium\"\n            ? Number(item.premium_price)\n            : Number(item.regular_price);\n        paying_for_documents = [...paying_for_documents, item.documentid];\n      }\n    }\n    let order_id = \"order-01\";\n    let user_id = this.state.investor_id;\n    let amount = totalamt;\n    let docs = paying_for_documents.join(\"-\").toString();\n    let deal_id = this.state.deal_id;\n    let url = `${process.env.REACT_APP_BASE_URL}cashfree/buy_documents/checkout.php?user_id=${user_id}&order_id=${order_id}&amount=${amount}&docs=${docs}&deal_id=${deal_id}`;\n\n    window.location.href = url;\n  };\n  get_document_purchased_list = () => {\n    if (this.state.investor_id) {\n      let params = {\n        investor_id: this.state.investor_id,\n        deal_id: this.state.deal_id,\n      };\n      Bridge.deal.get_document_purchased_list(params).then((result) => {\n        if (result.status == 1) {\n          let arr = [];\n          let documents = this.state.documents;\n          for (let item of documents) {\n            let status = false;\n            item.user_paid = false;\n            for (let item2 of result.data) {\n              if (item2.document_id == item.documentid || item.paid == \"Free\") {\n                item.user_paid = true;\n              }\n            }\n            arr = [...arr, item];\n          }\n          this.setState({ documents: arr });\n        }\n      });\n    }\n  };\n  check_for_error = () => {\n    let error = \"\";\n    let multiple_of =\n      parseFloat(this.state.amount) / parseFloat(this.state.multiples_of);\n    if (Number(this.state.amount) < Number(this.state.minamount)) {\n      error = `Minimum investment amount is Rs. ${this.state.minamount}`;\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (Number(this.state.amount) > Number(this.state.maxamount)) {\n      error = `Maximum investment amount is Rs. ${this.state.maxamount}`;\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (Number(this.state.amount) < Number(this.state.captable_threshold_amount) && Number(this.state.amount) % Number(this.state.multiples_of) != 0) {\n      const roundedLowerAmount = Math.floor(Number(this.state.amount) / Number(this.state.multiples_of)) * Number(this.state.multiples_of);\n      const roundedHigherAmount = Math.ceil(Number(this.state.amount) / Number(this.state.multiples_of)) * Number(this.state.multiples_of);\n\n      error = `Please enter an amount in multiples of ${this.state.multiples_of}. You may choose Rs ${roundedLowerAmount}\n      or Rs ${roundedHigherAmount}.\n      If you would like to enter the Captable, commit an amount of Rs. ${this.state.captable_threshold_amount} or more.`;\n\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (Number(this.state.amount) > Number(this.state.captable_threshold_amount) && Number(this.state.amount) % Number(this.state.captable_multiple_amount) != 0) {\n      const roundedLowerAmount = Math.floor(Number(this.state.amount) / Number(this.state.captable_multiple_amount)) * Number(this.state.captable_multiple_amount);\n      const roundedHigherAmount = Math.ceil(Number(this.state.amount) / Number(this.state.captable_multiple_amount)) * Number(this.state.captable_multiple_amount);\n\n      error = `Please enter an amount in multiples of ${this.state.captable_multiple_amount}. You may choose Rs ${roundedLowerAmount}\n      or Rs ${roundedHigherAmount}.\n      If you would like to enter the Captable, commit an amount of Rs. ${this.state.captable_threshold_amount} or more.`;\n\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else {\n      this.setState({ amount_error: \"\", amount_error_status: false });\n    }\n  };\n  get_invest_amt = () => {\n    axios.get(`${process.env.REACT_APP_BASE_URL}api/investors/InvestorCommitment/get_investor_investment_for_deal`, {\n      params: {\n        deal_id: this.state.deal_id,\n        investor_id: this.state.investor_id\n      }\n    })\n      .then((response) => {\n        console.log(\"invest_amt : \", response.data.data[0].totalamount)\n        this.setState({ invest_amt: response.data.data[0].totalamount });\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  }\n\n  increase_commit = () => {\n    ReactGA.event({\n      category: \"Deal Item Page\",\n      action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, Increment button clicked.`,\n    });\n    const {\n      amount,\n      captable_threshold_amount,\n      multiples_of,\n      maxamount,\n      captable_multiple_amount,\n      minamount\n    } = this.state;\n\n    let newAmount = Number(amount);\n    let changeAmount;\n\n    if (\n      newAmount < captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount > captable_threshold_amount &&\n      newAmount % captable_multiple_amount != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(captable_multiple_amount)) * Number(captable_multiple_amount);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (newAmount < Number(captable_threshold_amount)) {\n      changeAmount = Number(multiples_of);\n    } else {\n      changeAmount = Number(captable_multiple_amount);\n    }\n\n    newAmount += changeAmount;\n\n    if (newAmount > maxamount) {\n      newAmount = maxamount;\n    } else if (newAmount < minamount) {\n      newAmount = Number(minamount);\n    }\n\n    this.setState(\n      {\n        amount: newAmount,\n        commaAmount: this.formatNumberWithCommas(newAmount),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  decrease_commit = () => {\n    ReactGA.event({\n      category: \"Deal Item Page\",\n      action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, Decrement button clicked.`,\n    });\n    const {\n      amount,\n      captable_threshold_amount,\n      multiples_of,\n      minamount,\n      captable_multiple_amount,\n    } = this.state;\n\n    let newAmount = Number(amount);\n    let changeAmount;\n\n    if (\n      newAmount == captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount < captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedLowerAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount > captable_threshold_amount &&\n      newAmount % captable_multiple_amount != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(newAmount / Number(captable_multiple_amount)) * Number(captable_multiple_amount);\n      newAmount = roundedLowerAmount;\n      changeAmount = 0;\n    } else if (newAmount <= Number(captable_threshold_amount)) {\n      changeAmount = Number(multiples_of);\n    } else {\n      changeAmount = Number(captable_multiple_amount);\n    }\n\n    newAmount -= changeAmount;\n\n    if (newAmount < minamount) {\n      newAmount = minamount;\n    }\n\n    this.setState(\n      {\n        amount: newAmount,\n        commaAmount: this.formatNumberWithCommas(newAmount),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  handleCommitAmount = (value) => {\n    this.setState(\n      {\n        amount: value.replace(/,/g, ''),\n        commaAmount: this.formatNumberWithCommas(value)\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  }\n\n  formatNumberWithCommas = (number) => {\n    return number.toLocaleString('en-IN');\n  };\n\n  getSliderSettings() {\n    return {\n      dots: false,\n      infinite: false,\n      speed: 500,\n      slidesToShow: 1,\n      slidesToScroll: 1\n    };\n  }\n\n  handleClickImage = (image) => {\n    this.setState({\n      current: image,\n    });\n  }\n\n  handleCloseModal = () => {\n    this.setState({\n      current: '',\n    });\n  }\n\n  render() {\n    const myStyle = {\n      color: \"white\",\n      fontSize: \"17px\",\n      padding: \"50px\",\n      // justifyItem:\"center\"1\n    };\n    const genExtra = () => (\n      <>\n        {/* <PlusOutlined\n        onClick={event => {\n          // If you don't want click extra trigger collapse, you can prevent this:\n          event.stopPropagation();\n        }}\n      /> */}\n      </>\n    );\n\n    const settings = this.getSliderSettings();\n    const { images, current } = this.state;\n\n    return (\n      <>\n        {this.state.is_deal_visible == true ? (\n          <div style={{ display: this.state.show_data }}>\n            <WebHeader />\n            <section\n              className=\"deals-details-page\"\n              style={{ marginBottom: \"-50px\" }}\n            >\n              <div className=\"container main-section\">\n                <div className=\"row\">\n                  <div className=\"col-lg-5 col-md-5 col-sm-5\">\n                    <Spin spinning={this.state.loading}>\n                      <div className=\"d-flex justify-content-between align-items-center\">\n                        <div className=\"d-flex align-items-center\">\n                          {/* Image is static */}\n                          <img\n                            src=\"./assets/images/deals-details/save.jpg\"\n                            alt=\"\"\n                            className=\"img-fluid\"\n                            style={{\n                              marginRight: \"20px\",\n                              width: \"50%\",\n                              objectFit: \"contain\",\n                            }}\n                          />\n                          <h5 className=\"ml-5 mt-4\">TestDeal2</h5>\n                          {/* <h5>{this.state.logo}</h5> */}\n                        </div>\n                        {this.state.isPrivate == true && (\n                          <div\n                            className=\"private-tag\"\n                            style={{\n                              height: 38,\n                            }}\n                          >\n                            <span style={{ fontSize: 12 }}>Private</span>{\" \"}\n                          </div>\n                        )}\n                      </div>\n                      <div className=\"d-flex tags\">\n                        {this.state.tags.length > 0 &&\n                          this.state.tags.map((tag, index) => (\n                            <div\n                              className=\"hero-tag\"\n                              key={index}\n                              style={{\n                                background: \"rgb(41 23 111)\",\n                                color: \"#fff\",\n                              }}\n                            >\n                              {tag}\n                            </div>\n                          ))}\n                      </div>\n\n                      <p style={{ textAlign: \"justify\" }}>\n                        TestDeal2 Lorem ipsum dolor sit amet consectetur adipisicing elit. Obcaecati dolore hic doloribus accusamus soluta illo voluptas quas repudiandae, harum, facilis perferendis tempora iure.\n                      </p>\n                      <div className=\" percentage-container\">\n                        <div className=\"percentage-values\">\n                          {this.state.coming_soon_days ? (\n                            <>\n                              <div>\n                                <h3>{this.state.percentage_raised}%</h3>\n                                <span>RAISED</span>\n                              </div>\n                              <div style={{ textAlign: \"right\" }}>\n                                <h3>{this.state.coming_soon_days} Days</h3>\n                                <span>CAMPAIGN START IN</span>\n                              </div>\n                            </>\n                          ) : (\n                            <>\n                              <div>\n                                <h3>{this.state.percentage_raised}%</h3>\n                                <span>RAISED</span>\n                              </div>\n                              <div style={{ textAlign: \"right\" }}>\n                                <h3>{this.state.dealenddays} Days</h3>\n                                <span>CAMPAIGN ENDS IN</span>\n                              </div>\n                            </>\n                          )}\n                        </div>\n                        <Progress\n                          percent={this.state.percentage_raised}\n                          strokeColor={{\n                            \"0%\": \"rgb(255 156 26)\",\n                            \"100%\": \"rgb(255 156 26)\",\n                          }}\n                          showInfo={false}\n                        />\n                      </div>\n                      {!this.state.investor_id ? (\n                        <div className=\"button-group text-center\">\n                          <a className=\"prime-bg\" href=\"/Login\">\n                            Login\n                          </a>\n                          {/* <button className='share-button'>\n                        <i className='bx bxs-share'></i>\n                      </button> */}\n                        </div>\n                      ) : (\n                        <>\n                          {this.state.button_show_status == true ? (\n                            <>\n                              <div className=\"button-group\">\n                                {this.state.isFunded == true ? (\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg text-center\"\n                                  >\n                                    Deal is closed\n                                  </a>\n                                ) : this.state.user_type != \"founder\" && this.state.invest_amt !== null ? (\n                                  <div className=\"button-group\">\n                                    <p>{`You have committed Rs. ${this.state.invest_amt} to this deal so far. (Including platform fees)`}</p>\n                                    <a href=\"#!\" style={{ padding: \"13px 0\" }} onClick={() => { this.getpostData(); this.showModal1() }} className=\"black-button prime-bg text-center\" id=\"btn-invest\">\n                                      Add more\n                                    </a>\n                                  </div>\n                                ) : this.state.isPrivate == true &&\n                                  this.state.user_type != \"founder\" ? (\n                                  <a\n                                    style={{ padding: \"13px 0\" }}\n                                    href=\"#\"\n                                    onClick={() => {\n                                      this.getpostData();\n                                      this.showModal1()\n                                    }\n                                    }\n                                    className=\"black-button prime-bg text-center\"\n                                  >\n                                    Express Your Intest\n                                  </a>\n                                ) : this.state.user_type == \"founder\" ? (\n                                  <div>\n                                    {this.state.user_type == \"founder\" &&\n                                      this.state.founder_is_investor == \"1\" ? (\n                                      <a\n                                        href=\"#\"\n                                        style={{ padding: \"15px 0\" }}\n                                        className=\"black-button prime-bg text-center\"\n                                        onClick={() => {\n                                          this.getpostData();\n                                          this.showModal1()\n                                        }\n                                        }\n                                      >\n                                        Express Your Interest\n                                      </a>\n                                    ) : (\n                                      <a\n                                        href=\"/founder-as-investor\"\n                                        className=\"black-button prime-bg text-center\"\n                                      >\n                                        Apply as investor\n                                      </a>\n                                    )}\n                                  </div>\n                                ) : (\n                                  <div>\n                                    {this.state.user_type == \"investor\" && this.state.invest_amt === null ? (\n                                      <a\n                                        href=\"#\"\n                                        className=\"black-button prime-bg text-center\"\n                                        onClick={() => {\n                                          this.getpostData();\n                                          this.showModal1()\n                                        }\n                                        }\n                                        style={{ padding: \"13px 0\" }}\n                                      >\n                                        Express Your Interest\n                                      </a>\n                                    ) : null}\n                                  </div>\n                                )}\n                                {/* <button className='share-button'>\n                              <i className='bx bxs-share'></i>\n                            </button> */}\n                              </div>\n                            </>\n                          ) : (\n                            // <div className='button-group'>\n                            //   <a href=\"#\" className=\"black-button prime-bg\" style={{cursor:'default'}} >Coming soon..</a>\n                            // </div>\n                            <>\n                              {this.state.deal_regular_end_date_status == 0 ? (\n                                <div className=\"button-group\">\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg\"\n                                    style={{ cursor: \"default\" }}\n                                  >\n                                    Coming soon..\n                                  </a>\n                                </div>\n                              ) : (\n                                <div className=\"button-group\">\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg\"\n                                    style={{ cursor: \"default\" }}\n                                  >\n                                    Deal is closed\n                                  </a>\n                                </div>\n                              )}\n                            </>\n                          )}\n                        </>\n                      )}\n                    </Spin>\n                  </div>\n                  <Modal\n                    title={`Invest in ${this.state.deal_name}`}\n                    visible={this.state.investmentmodal}\n                    onOk={this.handleOk1}\n                    onCancel={this.handleCancel1}\n                    width={600}\n                    footer={false}\n                  >\n                    <div className=\"row modal-body\">\n                      <div className=\"login mt-3\">\n                        <label>\n                          <b>\n                            Amount: <br />\n                            Minimum investment Rs. {this.formatNumberWithCommas(this.state.minamount)} <br />\n                            Cap Table entry is Rs. {this.formatNumberWithCommas(this.state.captable_threshold_amount)}\n                          </b>\n                        </label>\n                        <input\n                          type=\"text\"\n                          name=\"amount\"\n                          className=\"form-input-field mt-4\"\n                          autofocus={true}\n                          placeholder=\"amount\"\n                          style={{\n                            border:\n                              this.state.amount_error_status == true &&\n                                this.state.amount\n                                ? \"1px solid red\"\n                                : \"1px solid transparent\",\n                          }}\n                          id=\"selected-field\"\n                          value={this.state.commaAmount}\n                          onChange={(e) => { this.handleCommitAmount(e.target.value) }}\n                        />\n                        <div className=\"d-flex justify-content-between mb-3\">\n                          <button className=\"commit-plus\" onClick={this.decrease_commit}>-</button>\n                          <button className=\"commit-minus\" onClick={this.increase_commit}>+</button>\n                        </div>\n                        {this.state.amount_error_status == true && (\n                          <p\n                            className=\"text-danger pb-0\"\n                            style={{ position: \"relative\", top: -19 }}\n                          >\n                            {this.state.amount_error}\n                          </p>\n                        )}\n                      </div>\n                      <div class=\"form-group form-check d-flex\">\n                        <Checkbox\n                          checked={this.state.checkWallet}\n                          onChange={(e) => {\n                            this.setState(\n                              { checkWallet: e.target.checked },\n                              () => this.calculategst()\n                            );\n                          }}\n                        >\n                          {\" \"}\n                        </Checkbox>\n                        <label className=\"form-check-label\">\n                          Use Your ₹ {this.state.walletMoney} Growth91\n                          <sup style={{ fontSize: \"0.6rem\" }}>\n                            TM\n                          </sup> Money{\" \"}\n                        </label>\n                      </div>\n                      {\n                        this.state.enable_special_offer && this.state.special_offer_text != null ? (\n                          <>\n                            <div class=\"form-group form-check d-flex\">\n                              <Checkbox\n                                checked={this.state.checkDiscount}\n                                onChange={(e) => {\n                                  this.setState(\n                                    { checkDiscount: e.target.checked },\n                                    () => this.calculategst()\n                                  );\n                                }}\n                              >\n                                {\" \"}\n                              </Checkbox>\n                              <label className=\"form-check-label\">\n                                {this.state.special_offer_text}\n                              </label>\n                            </div>\n                          </>\n                        ) : null\n                      }\n                      {\n                        this.state.checkDiscount ? (\n                          <div className=\"login mt-3\">\n                            <input\n                              type=\"text\"\n                              className=\"form-input-field mb-0\"\n                              autofocus={true}\n                              placeholder={this.state.default_special_offer_text}\n                            />\n                          </div>\n                        ) : null\n                      }\n                      <div className=\" d-flex justify-content-center modal-table\">\n                        <table\n                          className=\"col-12 m-5 investment-charge-table\"\n                          cellPadding={4}\n                        >\n                          <tr>\n                            <th>\n                              <strong>Particulars</strong>\n                            </th>\n                            <th>\n                              <strong>Amount</strong>\n                            </th>\n                          </tr>\n                          <tr>\n                            <td>Investment Amount</td>\n                            <td lassName=\"text-center\">\n                              ₹{\" \"}\n                              {this.state.amountplusgst\n                                ? this.state.amountplusgst\n                                : \"0\"}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>\n                              Convenience Fees\n                              <br />\n                              <span>{this.state.label}</span>\n                            </td>\n                            <td lassName=\"text-center\">\n                              ₹ {this.state.processingfees}\n                            </td>\n                          </tr>\n                          {\n                            this.state.checkDiscount ? (\n                              <tr>\n                                <td>Special Discount</td>\n                                <td lassName=\"text-center\">\n                                  - ₹{\" \"}\n                                  {this.state.DiscountedMoney\n                                    ? this.state.DiscountedMoney\n                                    : \"0\"}\n                                </td>\n                              </tr>\n                            ) : null\n                          }\n                          <tr>\n                            <td>Wallet Money</td>\n                            <td lassName=\"text-center\">\n                              - ₹ {this.state.walletDeductionMoney}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>Total</td>\n                            <td>\n                              ₹ {parseFloat(this.state.totalamount).toFixed(0)}\n                            </td>\n                          </tr>\n                        </table>\n                      </div>\n                      {\n                        this.state.invest_amt !== null ?\n                          (\n                            <div className=\"\">\n                              <Alert\n                                message={`You have committed Rs. ${this.state.invest_amt} to this deal so far. (Including platform fees)`}\n                                type=\"info\"\n                              />\n                            </div>\n                          ) : null\n                      }\n                      <div className=\"m-3\">\n                        <label className=\"container-check\">\n                          I Agree to Terms and Conditions and have read the Privacy Policy. And, I understand that I will be required to pay the full amount committed after the deal is closed.\n                          <input\n                            type=\"checkbox\"\n                            name=\"agree\"\n                            onChange={this.onChangeCheckbox}\n                          />\n                          <span className=\"checkmark\"></span>\n                        </label>\n\n                        {/* <label className=\"container-check\">I will deduct TDS on service charges and deposit to Income tax on time\n                      <input type=\"checkbox\" name=\"deduct\" onChange={this.onChangeCheckbox}  />\n                      <span className=\"checkmark\"></span>\n                    </label> */}\n                      </div>\n\n                      <div className=\"col-12\">\n                        {this.state.amount_error_status == true ? (\n                          <button\n                            type=\"button\"\n                            className=\"login-button text-center\"\n                            style={{\n                              border: \"1px solid #9a9a9a\",\n                              backgroundColor: \"#9a9a9a\",\n                              cursor: \"not-allowed\",\n                              padding: \"0.9em 0 \",\n                            }}\n                          >\n                            Express Your Interest\n                          </button>\n                        ) : (\n                          <InvestmentMembershipmodal\n                            processingfees={this.state.processingfees}\n                            deal_id={this.state.deal_id}\n                            membership_type={this.state.check_membership_type}\n                            invest={this.invest}\n                            amount={this.state.amount}\n                            agreecheck={this.state.agreeCheck}\n                            totalamount={this.state.totalamount}\n                            fee={this.state.legalfee}\n                            minamount={this.state.minamount}\n                            maxamount={this.state.maxamount}\n                            agree={this.state.agree}\n                            error_status={this.state.amount_error_status}\n                            investor_id={this.state.investor_id}\n                            deduct={this.state.deduct}\n                            tdsstatus={this.state.tdsstatus}\n                            gst={this.state.gst}\n                            order_token={this.state.order_token}\n                            legalfee={this.state.legalfee}\n                            walletDeductionMoney={this.state.walletDeductionMoney}\n                            user_id={this.state.investor_id}\n                            escrow_account_ifsc={this.state.escrow_account_ifsc}\n                            escrowact={this.state.escrowact}\n                            interested_id={this.state.interested_id}\n                            invest_amt={this.state.invest_amt}\n                          />\n                        )}\n                      </div>\n                    </div>\n                  </Modal>\n                  <Modal\n                    title=\"Deduct TDS\"\n                    visible={this.state.confirmmodalstatus}\n                    onOk={this.handleOk2}\n                    onCancel={this.handleCancel2}\n                    width={700}\n                    footer={false}\n                  >\n                    <div className=\"row\">\n                      <div style={{ width: \"100%\" }}>\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          TDS is applicable according to Section-194j of the\n                          income Tex act, 1961.\n                        </p>\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          Rate: 10%\n                        </p>{\" \"}\n                        <br />\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          <b>Do you want to Deduct TDS?</b>\n                        </p>\n                      </div>\n\n                      <div className=\"col-11\">\n                        <button\n                          type=\"button\"\n                          className=\"login-button bg-primary mt-4 mx-4\"\n                          onClick={() => this.invest()}\n                        >\n                          Yes\n                        </button>\n                        <input\n                          type=\"button\"\n                          value=\"No Thanks\"\n                          onClick={() => this.invest()}\n                          className=\"login-button mx-4 my-3\"\n                        ></input>\n                      </div>\n                    </div>\n                  </Modal>\n                  <div className=\"col-lg-7 deal-banner\">\n                    {this.state.youtube_url && (\n                      <iframe\n                        style={{\n                          boxShadow: \"0px 0px 2rem -0.5rem rgb(0 0 0 / 40%)\",\n                          borderRadius: 3,\n                          // marginLeft: 65,\n                        }}\n                        width=\"100%\"\n                        height=\"335\"\n                        src={this.state.youtube_url}\n                        title=\"YouTube video player\"\n                        frameBorder=\"0\"\n                        allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                        allowFullScreen\n                      ></iframe>\n                    )}\n                    {!this.state.youtube_url && (\n                      //   <img\n                      //     src=\"./assets/images/deals-details/TestDeal2/pitch/TestDeal2 2023_page-0001.jpg\"\n                      //     width=\"100%\"\n                      //     style={{ height: \"auto\" }}\n                      //   />\n                      <video controls width=\"100%\" style={{ height: \"auto\" }}>\n                        <source src=\"./assets/videos/deals-details/TestDeal2/TestDeal2.mp4\" type=\"video/mp4\" />\n                        Sorry, your browser doesn't support videos.\n                      </video>\n                    )}\n                  </div>\n\n                  <div\n                    className=\"container highlight-section\"\n                    style={{\n                      marginBottom: \"-80px !important\",\n                      padding: \"0px !important\",\n                    }}\n                  >\n                    <h1 style={{ fontSize: \"2rem\", marginBottom: \"30px\" }}>\n                      Highlights\n                    </h1>\n                    <div className=\"row\">\n                      <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/Petmojo/highlight01.jpg\" />\n                          <p style={{ padding: \"1px !important\" }}>\n                            TestDeal2 Lorem ipsum dolor sit amet consectetur adipisicing elit. Sit debitis harum nulla sequi amet optio deserunt repudiandae sunt ea vel?\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/highlight2.jfif\" />\n                          <p style={{ padding: \"0px !important\" }}>\n                            Lorem ipsum dolor sit amet consectetur adipisicing elit. Amet magni cumque eaque! Doloribus tempore corporis id animi iusto explicabo omnis.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/highlight3.jpg\" />\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            TestDeal2 Lorem ipsum dolor sit amet consectetur adipisicing elit.\n                          </p>\n                        </div>\n                      </div>\n                      {/* <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/Petmojo/highlight4.jpg\" />\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            Net profitable in first 6 months of growth\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                        <div className=\"single text-left\">\n                          <img src=\"./assets/images/deals-details/Petmojo/highlight5.png\" />\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            Incubated and backed by BITS Pilani\n                          </p>\n                        </div>\n                      </div> */}\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </section>\n            <div className=\"deals-page\">\n              <div className=\"tab-wrapper\">\n                <div className=\"container\">\n                  <div className=\"row\">\n                    <div\n                      className=\"col-lg-12 col-md-12 col-sm-12\"\n                      style={{\n                        marginTop: 110,\n                      }}\n                    >\n                      <Tabs\n                        defaultActiveKey=\"1\"\n                        centered\n                        style={{ marginBottom: \"30px !important\" }}\n                      >\n                        <TabPane tab=\"Details\" key=\"2\" onClick={() => {\n                          ReactGA.event({\n                            category: \"Deal Item Page\",\n                            action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, Details button clicked`,\n                          });\n                        }}>\n                          <div className=\"deal-terms-section\">\n                            <div\n                              className=\"container\"\n                              style={{ marginTop: \"1px !important\" }}\n                            >\n                              <div className=\"row\">\n                                <div className=\"col-lg-10 m-auto\">\n                                  <h1>Documents</h1>\n                                  <div className=\"row document-section\">\n                                    <div className=\"col-lg-2\"></div>\n                                    <div className=\"col-lg-8\">\n                                      <div\n                                        className=\"download-section\"\n                                        style={{\n                                          backgroundColor: \"white\",\n                                          padding: \"4rem 19px\",\n                                        }}\n                                      >\n                                        <>\n                                          <div>\n                                            <table\n                                              className=\"download-document-table\"\n                                              style={{ width: \"100%\" }}\n                                            >\n                                              <tr\n                                                style={{\n                                                  background: \"#29176f\",\n                                                  color: \"#fff\",\n                                                }}\n                                              >\n                                                <th>Sr no</th>\n                                                <th>Document</th>\n                                                <th>Type</th>\n                                                <th>Download</th>\n                                              </tr>\n                                              {this.state.documents.length >\n                                                0 &&\n                                                this.state.documents.map(\n                                                  (item, index) => {\n                                                    let documentlink = `${process.env.REACT_APP_BASE_URL}api/uploads/docs/${item.documentid}/${item.document}`;\n                                                    return (\n                                                      <tr\n                                                        key={index}\n                                                        style={{ height: 70 }}\n                                                      >\n                                                        {/* <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {item.paid ==\n                                                            \"Paid\" && (\n                                                            <>\n                                                              {this.state\n                                                                .check_membership_type ==\n                                                                \"premium\" &&\n                                                              item.premium_price !=\n                                                                \"0\" &&\n                                                              item.premium_price !=\n                                                                \"\" ? (\n                                                                <>\n                                                                  {item.user_paid ==\n                                                                  false ? (\n                                                                    <Checkbox\n                                                                      onChange={() =>\n                                                                        this.show_selected_checkbox(\n                                                                          item\n                                                                        )\n                                                                      }\n                                                                      value={\n                                                                        item.selected\n                                                                      }\n                                                                    ></Checkbox>\n                                                                  ) : (\n                                                                    <>\n                                                                      {item.user_paid ==\n                                                                        true && (\n                                                                        <img\n                                                                          src=\"./paid.png\"\n                                                                          style={{\n                                                                            maxWidth: 20,\n                                                                          }}\n                                                                        />\n                                                                      )}\n                                                                    </>\n                                                                  )}\n                                                                </>\n                                                              ) : (\n                                                                <>\n                                                                  {this.state\n                                                                    .check_membership_type ==\n                                                                    \"regular\" &&\n                                                                    item.regular_price !=\n                                                                      \"0\" &&\n                                                                    item.regular_price !=\n                                                                      \"\" &&\n                                                                    item.user_paid ==\n                                                                      false && (\n                                                                      <Checkbox\n                                                                        onChange={() =>\n                                                                          this.show_selected_checkbox(\n                                                                            item\n                                                                          )\n                                                                        }\n                                                                        value={\n                                                                          item.selected\n                                                                        }\n                                                                      ></Checkbox>\n                                                                    )}\n                                                                </>\n                                                              )}\n                                                            </>\n                                                          )}\n                                                        </td> */}\n                                                        <td style={{ width: 40 }}>{index + 1}</td>\n                                                        <td\n                                                          style={{ width: 140 }}\n                                                        >\n                                                          {item.docname}\n                                                        </td>\n                                                        <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {item.paid == \"Paid\"\n                                                            ? this.state\n                                                              .check_membership_type ==\n                                                              \"premium\"\n                                                              ? item.premium_price ==\n                                                                \"0\"\n                                                                ? \"Free\"\n                                                                : \"₹\" +\n                                                                item.premium_price\n                                                              : item.regular_price ==\n                                                                \"0\"\n                                                                ? \"Free\"\n                                                                : \"₹\" +\n                                                                item.regular_price\n                                                            : \"Free\"}\n                                                        </td>\n                                                        <td\n                                                          style={{ width: 50 }}\n                                                        >\n                                                          {this.state\n                                                            .investor_id && (\n                                                              <center>\n                                                                {(item.user_paid ==\n                                                                  true ||\n                                                                  item.paid ==\n                                                                  \"Free\") && (\n                                                                    <a\n                                                                      href={\n                                                                        documentlink\n                                                                      }\n                                                                      target=\"_blank\"\n                                                                      style={{\n                                                                        width: 80,\n                                                                      }}\n                                                                      onClick={() => {\n                                                                        ReactGA.event({\n                                                                          category: \"Deal Item Page\",\n                                                                          action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, Download document Download button clicked. ${item.docname}`,\n                                                                        });\n                                                                      }}\n                                                                    >\n                                                                      <img\n                                                                        src=\"./download.ico\"\n                                                                        style={{\n                                                                          maxWidth: 50,\n                                                                        }}\n                                                                      />\n                                                                    </a>\n                                                                  )}\n                                                                {item.paid ==\n                                                                  \"Paid\" &&\n                                                                  this.state\n                                                                    .check_membership_type ==\n                                                                  \"premium\" &&\n                                                                  (item.premium_price ==\n                                                                    \"0\" ? (\n                                                                    <a\n                                                                      href={\n                                                                        documentlink\n                                                                      }\n                                                                      target=\"_blank\"\n                                                                      style={{\n                                                                        width: 80,\n                                                                      }}\n                                                                    >\n                                                                      <img\n                                                                        src=\"./download.ico\"\n                                                                        style={{\n                                                                          maxWidth: 50,\n                                                                        }}\n                                                                      />\n                                                                    </a>\n                                                                  ) : (\n                                                                    \"\"\n                                                                  ))}\n                                                              </center>\n                                                            )}\n                                                        </td>\n                                                      </tr>\n                                                    );\n                                                  }\n                                                )}\n                                            </table>\n                                          </div>\n                                        </>\n                                        {this.state.button_status == false && (\n                                          <button\n                                            className=\"download-button\"\n                                            onClick={() => this.documentPay()}\n                                          >\n                                            Pay\n                                          </button>\n                                        )}\n                                        {!this.state.investor_id && (\n                                          <>\n                                            <button\n                                              className=\"download-button\"\n                                              style={{\n                                                background: \"rgb(41 23 111)\",\n                                              }}\n                                              onClick={() =>\n                                                window.location.assign(\"/login\")\n                                              }\n                                            >\n                                              Login to View\n                                            </button>\n                                            {/* <em\n                                            style={{\n                                              fontSize: 14,\n                                              fontWeight: \"700\",\n                                            }}\n                                          >\n                                            Become Growth91\n                                            <sup style={{ fontSize: \"0.6rem\" }}>\n                                              TM\n                                            </sup>{\" \"}\n                                            member to access the document{\" \"}\n                                          </em> */}\n                                          </>\n                                        )}\n                                      </div>\n                                    </div>\n                                    <div className=\"col-lg-2\"></div>\n                                  </div>\n\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"-30px !important\",\n                                      marginTop: \"30px\",\n                                    }}\n                                  >\n                                    Deal Terms\n                                  </h1>\n                                  <div\n                                    className=\"\"\n                                    style={{ marginTop: \"0px !important\" }}\n                                  >\n                                    <div className=\"container\">\n                                      <div className=\"row\">\n                                        <div className=\"col-lg-12\">\n                                          <div className=\"info\">\n                                            <span>End Date</span>\n                                            <h4\n                                              style={{\n                                                textTransform: \"Capitalize\",\n                                              }}\n                                            >\n                                              {this.state.deal_regular_end_date\n                                                ? moment(\n                                                  this.state\n                                                    .deal_regular_end_date\n                                                ).format(\"MMM DD, YYYY\")\n                                                : \"\"}\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span> Min Investment</span>\n                                            <h4>₹ 5,000</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Valuation</span>\n                                            <h4>\n                                              Floor : 97 Crore <br></br> Cap : 55\n                                              Crore\n                                            </h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"0px\",\n                                      marginTop: \"20px\",\n                                    }}\n                                  >\n                                    Company Details\n                                  </h1>\n                                  <section\n                                    className=\"deal-about-artment-section\"\n                                    style={{ marginTop: \"50px\" }}\n                                  >\n                                    <div className=\"container\">\n                                      <div className=\"row\">\n                                        <div className=\"col-lg-12\">\n                                          <div className=\"info\">\n                                            <span>Legal Name</span>\n                                            <h4>\n                                              Test Company Pvt. Ltd.{\" \"}\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Founded</span>\n                                            <h4>22nd June 2001</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Status</span>\n                                            <h4>Private</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Employees</span>\n                                            <h4>50</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Website</span>\n                                            <h4>\n                                              <a\n                                                style={{\n                                                  color: \"rgb(7, 211, 252)\",\n                                                }}\n                                                href=\"https://www.TestDeal2.com\"\n                                                target=\"_blank\"\n                                              >\n                                                TestDeal2.com\n                                              </a>\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Social Links</span>\n                                            <div className=\"social-icons\">\n                                              <a href=\"https://www.facebook.com/TestDeal2hostels/\">\n                                                <i className=\"bx bxl-facebook fs-19\"></i>\n                                              </a>\n                                              <a\n                                                href=\"https://www.linkedin.com/company/\"\n                                              >\n                                                <i className=\"bx bxl-linkedin fs-19\"></i>\n                                              </a>\n                                              <a\n                                                href=\"https://www.instagram.com/TestDeal2/\"\n                                              >\n                                                <i className=\"bx bxl-instagram fs-19\"></i>\n                                              </a>\n                                              {/* <a href=\"https://www.youtube.com/channel/UCGSO5fKYSUCBtiDpc2lSoLA\">\n                                              <i className=\"bx bxl-youtube fs-19\"></i>\n                                            </a> */}\n                                            </div>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Address</span>\n                                            <h4>\n                                              Lorem, ipsum dolor sit amet consectetur adipisicing elit. Rem, porro!\n                                            </h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </section>\n                                </div>\n                              </div>\n                            </div>\n\n                            <div\n                              className=\"container home-decor-section mt-0\"\n                              style={{ marginTop: \"3px !important\" }}\n                            >\n                              <h1\n                                className=\"text-center\"\n                                style={{\n                                  marginBottom: \"20px\",\n                                  marginTop: \"0px !important\",\n                                }}\n                              >\n                                Market Overview\n                              </h1>\n                              <div className=\"row\">\n                                <div className=\"col-lg-4\">\n                                  <div className=\"single text-center\">\n                                    {/* <h2 style={{paddingBottom:\"20px\"}}>$1 Tn </h2> */}\n                                    <p\n                                      style={{\n                                        color: \"white\",\n                                        fontSize: \"21px\",\n                                        padding: \"2px\",\n                                        margin: \"48px 0px\",\n                                      }}\n                                    >\n                                      Lorem ipsum dolor, sit amet consectetur adipisicing elit. Distinctio nostrum fugiat doloremque ducimus, veritatis quas aspernatur ipsa nihil delectus aut!\n                                    </p>\n                                  </div>\n                                </div>\n                                <div className=\"col-lg-4\">\n                                  <div className=\"single text-center\">\n                                    {/* <h2 style={{paddingBottom:\"20px\"}}>$200 Bn</h2> */}\n                                    <p\n                                      style={{\n                                        color: \"white\",\n                                        fontSize: \"21px\",\n                                        padding: \"2px\",\n                                        margin: \"63px 0px\",\n                                      }}\n                                    >\n                                      Lorem ipsum dolor sit amet, consectetur adipisicing elit. Recusandae cum error sunt dicta porro impedit?\n                                    </p>\n                                  </div>\n                                </div>\n\n                                <div className=\"col-lg-4\">\n                                  <div className=\"single text-center\">\n                                    {/* <h2 style={{paddingBottom:\"20px\"}}>$200 Bn</h2> */}\n                                    <p\n                                      style={{\n                                        color: \"white\",\n                                        fontSize: \"21px\",\n                                        padding: \"2px\",\n                                        margin: \"51px 0px\",\n                                      }}\n                                    >\n                                      {\" \"}\n                                      Lorem ipsum dolor sit amet consectetur adipisicing elit. Ducimus eum magnam reprehenderit quisquam aliquam. Ex ea tempora suscipit doloremque distinctio.\n                                    </p>\n                                  </div>\n                                </div>\n\n                                {/* <div className=\"col-lg-4\">\n                                <div className=\"single text-center\">\n                                  <h2 style={{paddingBottom:\"20px\"}}>21 </h2>\n                                  \n                                  <p style={myStyle}>\n                                  fintech unicorns in 2022\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-4\">\n                                <div className=\"single text-center\">\n                                  <h2 style={{paddingBottom:\"20px\"}}>5X </h2>\n                                  <p style={myStyle}>\n                                  growth in digital tech talent\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-4\">\n                                <div className=\"single text-center\">\n                                  <h2 style={{paddingBottom:\"20px\"}}></h2>\n                                  <p style={myStyle}>\n                                  Regulators actively encouraging innovation\n                                  </p>\n                                </div>\n                              </div> */}\n                              </div>\n                              <div className=\"text-center fs-4\">\n                                <span style={{ color: \"#000\" }}>Source: </span>\n                                <span style={{ color: \"rgb(127, 119, 118)\" }}>\n                                  Multiple publicly available research and\n                                  survey reports\n                                </span>\n                              </div>\n                              <p className=\"\"> </p>\n                              <div className=\"text-center fluid-container\"></div>\n                            </div>\n\n                            <div\n                              className=\"\"\n                              style={{\n                                backgroundColor: \"white\",\n                                marginTop: \"1px !important\",\n                              }}\n                            >\n                              <h1\n                                style={{\n                                  fontSize: 32,\n                                  marginBottom: 30,\n                                  textAlign: \"center\",\n                                  marginTop: \"-10px !important\",\n                                }}\n                              >\n                                Investor Presentation\n                              </h1>\n                              <Slider {...settings} className=\"mb-5 pitch-slider\">\n                                {images.map((image, index) => (\n                                  <img\n                                    key={index}\n                                    src={image}\n                                    onClick={() => this.handleClickImage(image)}\n                                  />\n                                ))}\n                              </Slider>\n                              {current && (\n                                <Lightbox\n                                  mainSrc={current}\n                                  onCloseRequest={this.handleCloseModal}\n                                />\n                              )}\n                            </div>\n                          </div>\n                          {/* start */}\n\n                          <div\n                            className=\"deals-page\"\n                            style={{\n                              marginTop: \"50px !important\",\n                            }}\n                          >\n                            <div className=\"tab-wrapper\">\n                              <div className=\"container\">\n                                <div className=\"row\">\n                                  <div className=\"col-lg-12\">\n                                    <Tabs defaultActiveKey=\"1\" centered>\n                                      <TabPane tab=\"FAQ\" key=\"1\">\n                                        <section\n                                          className=\"faq-section\"\n                                          style={{\n                                            margin: \"0px\",\n                                            padding: \"0px\",\n                                            background: \"none\",\n                                          }}\n                                        >\n                                          <div className=\"\">\n                                            <div className=\"row\">\n                                              <div className=\"col-lg-12 col-md-12 col-sm-12 m-auto\">\n                                                <h1 className=\"text-center mb-4\">\n                                                  About {this.state.deal_name}\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['1']}\n                                                  onChange={this.callback1}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"What is the TestDeal2's value proposition?\"\n                                                    key=\"1\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      Lorem ipsum dolor sit amet consectetur adipisicing elit. Labore delectus fugit consectetur cum vitae hic, iusto quidem illo tempora sit alias facilis sapiente illum ex omnis placeat exercitationem earum dolorum explicabo assumenda dolore porro! In autem dolorum accusamus et soluta reprehenderit molestiae placeat maxime laborum eveniet? Non dolorum aut ratione.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is primary GTM strategy of TestDeal2?\"\n                                                    key=\"2\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>1. Lorem, ipsum dolor sit amet consectetur adipisicing elit. Odit, ipsam. </p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>2. Lorem ipsum dolor sit amet consectetur adipisicing elit. Nobis, qui!</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>3. Lorem ipsum dolor sit amet consectetur adipisicing elit. Nobis, qui! </p>\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"What are your moats?\"\n                                                    key=\"7\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>1. Lorem ipsum, dolor sit amet consectetur adipisicing elit. Voluptates eveniet quod mollitia cum suscipit similique est rem totam fuga fugiat?</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>2. Lorem ipsum dolor sit, amet consectetur adipisicing elit. Aliquid, nam.</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>3. Lorem ipsum dolor sit amet consectetur adipisicing elit. Quae officiis assumenda laudantium a totam quibusdam, fugit voluptates neque iure at velit ipsum aut praesentium qui, iusto cupiditate nihil tenetur soluta architecto odio unde non! Iste, magnam reprehenderit voluptas dolores nihil delectus quod voluptate cupiditate fugiat quae ipsum perspiciatis? Eaque, necessitatibus?</p>\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"How's TestDeal2 different from competition?\"\n                                                    key=\"4\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>1. TestDeal2 Lorem ipsum dolor sit amet consectetur adipisicing elit. Fugit quod inventore qui culpa laboriosam quisquam iusto amet facere doloremque voluptate?</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>2. Lorem ipsum dolor sit amet, consectetur adipisicing elit. In ea veniam ducimus numquam impedit ratione, labore officiis cum quidem asperiores.</p>\n                                                      <p style={{\n                                                        color: \"#7f7776\",\n                                                      }}>3. Lorem ipsum dolor sit amet consectetur adipisicing elit. Exercitationem, praesentium.</p>\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                                <h1 className=\"text-center mb-2 mt-4\">\n                                                  Growth91 Investment FAQ\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['10']}\n                                                  onChange={this.callback3}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"What is the due diligence process followed by Growth91\"\n                                                    key=\"11\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      At Growth91, we follow\n                                                      stringent due-diligence\n                                                      process. We ask for\n                                                      detailed information about\n                                                      start-up and their team.\n                                                      After the scrutiny and if\n                                                      deemed fit, start-up would\n                                                      be listed on Growth91\n                                                      platform. Independent\n                                                      investment opinion and\n                                                      due-diligence report\n                                                      prepared by external\n                                                      qualified experts are made\n                                                      available for investors.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"Do you offer any guarantee on returns?\"\n                                                    key=\"12\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      No, we do not guarantee\n                                                      any returns. The startup\n                                                      which is raising the money\n                                                      is also not guaranteeing\n                                                      any specific returns. In\n                                                      principle, it is not\n                                                      legally correct for the\n                                                      company to provide any\n                                                      guarantee about returns on\n                                                      equity linked securities.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the refund process in case I don’t receive any allocation?\"\n                                                    key=\"13\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      If an investor doesn’t\n                                                      receive the allocation,\n                                                      the investment amount will\n                                                      be refunded to the bank\n                                                      account from which the\n                                                      investment has been made.\n                                                      As per Growth91 policy,\n                                                      there will be no interest\n                                                      or compensation on these\n                                                      returned funds.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the exit mechanism available for the investors\"\n                                                    key=\"14\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      The Company and the\n                                                      Promoters shall make all\n                                                      reasonable endeavours to\n                                                      provide exit to the\n                                                      Investors by any of the\n                                                      following ways: 1. Initial\n                                                      Public Offer (IPO) 2.\n                                                      Merger or Acquisition\n                                                      Event 3. Buyout Event 3.\n                                                      Compulsory Call Option\n                                                      with minimum assured\n                                                      returns. (Please refer to\n                                                      investor agreement for\n                                                      more details)\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"In which account Investor’s money are transferred\"\n                                                    key=\"15\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      Money invested by the\n                                                      investor in all public\n                                                      deals are automatically\n                                                      transferred to separate\n                                                      and dedicated escrow\n                                                      account created for\n                                                      respective Startup. The\n                                                      escrow account is managed\n                                                      by authorized trustee.\n                                                      After the funding/deal and\n                                                      documentation formalities\n                                                      are completed, the fund\n                                                      will be transferred to\n                                                      respective startup bank\n                                                      account.\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"I have more questions; how do I contact Growth91?\"\n                                                    key=\"16\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      You can always send your\n                                                      queries to{\" \"}\n                                                      <a href=\"mailto:contact@growth91.com\">\n                                                        contact@growth91.com\n                                                      </a>\n                                                      , we will respond to your\n                                                      queries in shortest\n                                                      possible time.\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                              </div>\n                                            </div>\n                                          </div>\n                                        </section>\n                                      </TabPane>\n                                    </Tabs>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          {/* stop */}\n                        </TabPane>\n                        <TabPane tab=\"Team\" key=\"3\" onClick={() => {\n                          ReactGA.event({\n                            category: \"Deal Item Page\",\n                            action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, Team button clicked`,\n                          });\n                        }}>\n                          <div\n                            className=\"container meet-the-team-section\"\n                            style={{ maxWidth: 921 }}\n                          >\n                            <h2 className=\"text-center\">Meet the Team</h2>\n                            <div className=\"row\">\n                              <div className=\"col-lg-6\">\n                                <div\n                                  className=\"single\"\n                                  style={{ paddingBottom: \"0px !important\" }}\n                                // style={{  marginBottom: 0px !important}}\n                                >\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/no.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>TestDeal2</h3>\n                                      <span>Founder & CEO</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/\"\n                                          target=\"_blank\"\n                                          onClick={() => {\n                                            ReactGA.event({\n                                              category: \"Deal Item Page\",\n                                              action: `DealId:${this.state.deal_id} InvestorId:${this.state.investor_id}, Founder LinkedIn button clicked`,\n                                            });\n                                          }}\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                        {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                        <i className=\"bx bxl-gmail\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    He is responsible for Product market Fit, Fundraise and Growth.\n                                    <br />\n                                    TestDeal2 is an engineering graduate with specialization in computer science. This is his first enterpreneurial venture founded when he was in college in 2019.\n                                  </p>\n                                </div>\n                              </div>\n\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/no.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>TestDeal2</h3>\n                                      <span>Head</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a href=\"https://www.linkedin.com/in/\" target=\"_blank\">\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Et eligendi dolorum soluta, voluptatum possimus eaque aspernatur veritatis enim quisquam ducimus!\n                                    <br />\n                                    TestDeal2 Lorem ipsum dolor sit amet consectetur adipisicing elit. Explicabo, deleniti.\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/no.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>TestDeal2</h3>\n                                      <span>Head New Expansion</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    He is responsible for New Vertical Expansion at TestDeal2\n                                    <br />\n                                    TestDeal2 has 8 years of experience with 5 industries: Hospitality, Food & Beverages, Automobile InsureTech, Car Accessories and Exports in the Growth and Strategy vertical.\n                                  </p>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/no.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Anshuman Singh</h3>\n                                      <span>Head of Marketing and Branding partnership</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        {/* <a\n                                          href=\"https://www.linkedin.com/in/devaashish/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    He is responsible for all the marketing campaigns and Branding partnership at TestDeal2\n                                    <br />\n                                    Anshuman posseses marketing skills and has previously worked for cleardekho where he was managing marketing and campaigns.\n                                  </p>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </TabPane>\n                      </Tabs>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <WebFooter />\n          </div>\n        ) : (\n          window.location.assign(\"/Deals\")\n        )}\n      </>\n    );\n  }\n}\n\nexport default TestDeal2;\n","/home/akc01/Desktop/projects/Growth91/apps/client/src/app/deal-pages/Innoserv.jsx",["9014","9015","9016","9017","9018","9019","9020","9021","9022","9023","9024","9025","9026","9027","9028","9029","9030","9031","9032","9033","9034","9035","9036","9037","9038","9039","9040","9041","9042","9043","9044","9045","9046","9047","9048","9049","9050","9051","9052","9053","9054","9055","9056","9057","9058","9059","9060","9061","9062","9063","9064","9065","9066","9067","9068","9069","9070","9071","9072","9073","9074","9075","9076","9077","9078","9079","9080","9081","9082","9083","9084","9085","9086","9087","9088","9089","9090","9091","9092","9093","9094","9095","9096","9097","9098","9099","9100","9101","9102","9103","9104","9105","9106","9107","9108","9109","9110","9111","9112","9113","9114","9115","9116","9117","9118","9119","9120","9121","9122","9123","9124","9125"],[],"import React, { Component } from \"react\";\nimport WebHeader from \"../common/WebHeader\";\nimport WebFooter from \"../common/WebFooter\";\nimport \"./newboo.css\";\nimport {\n  Tabs,\n  Collapse,\n  message,\n  Modal,\n  Spin,\n  Checkbox,\n  Progress,\n  Alert,\n} from \"antd\";\nimport axios from \"axios\";\nimport { ExclamationCircleOutlined, PlusOutlined } from \"@ant-design/icons\";\nimport Slider from \"react-slick\";\nimport Lightbox from \"react-image-lightbox\";\nimport Apis from \"../constants/Apis\";\nimport moment from \"moment\";\nimport Bridge from \"../constants/Bridge\";\nimport InvestmentMembershipmodal from \"../components/membership/InvestmentMembershipmodal\";\nimport NewWebHeader from \"../common/NewWebHeader\";\nimport { NewWebFooter } from \"../common/NewWebFooter\";\n\nconst { Panel } = Collapse;\nconst { TabPane } = Tabs;\nclass Innoserv extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      deal_id: \"\",\n      investor_id: \"\",\n      interested_id: \"\",\n      deal_name: \"\",\n      created_at: \"\",\n      deal_description: \"\",\n      isPrivate: false,\n      isFunded: false,\n      isBlank: false,\n      tags: [],\n      logo: \"\",\n      youtube_url: \"\",\n      dealenddays: 0,\n      kycstatus: false,\n      bankstatus: false,\n      commaAmount: 0,\n      amount: 0,\n      minamount: 0,\n      captable_threshold_amount: 0,\n      maxamount: 0,\n      captable_multiple_amount: 0,\n      investmentmodal: false,\n      confirmmodalstatus: false,\n      deduct: false,\n      agree: \"\",\n      isInvested: false,\n      name: \"\",\n      email: \"\",\n      mobile: \"\",\n      conveniencefees: 100,\n      gst: 0,\n      amountplusgst: 0,\n      processingfees: 0.0,\n      totalamount: 0.0,\n      tdsstatus: false,\n      legalfee: 0.0,\n      legalplusprocessing: 0.0,\n      label: \"\",\n      percentage: 0,\n      check_membership_type: \"\",\n      tdsdeductedamount: 0,\n      order_token: \"\",\n      pdffile: \"\",\n      pitch_files: \"\",\n      pitch_list: [],\n      walletMoney: 0,\n      gstValue: 0,\n      walletDeductionMoney: 0,\n      checkWallet: false,\n      percentage_raised: 0,\n      documents: [],\n      button_status: true,\n      show_data: \"none\",\n      button_show_status: true,\n      amount_error: \"\",\n      amount_error_status: false,\n      multiples_of: 0,\n      founder_is_investor: 0,\n      user_type: \"\",\n      coming_soon_days: \"\",\n      deal_regular_end_date: \"\",\n      is_deal_visible: true,\n      deal_regular_end_date_status: 0,\n      invest_amt: \"\",\n      escrowact: \"\",\n      escrow_account_ifsc: \"\",\n      agreeCheck: false,\n      Convenience: \"\",\n      deal_service: \"\",\n      images: [\n        \"./assets/images/deals-details/Innoserv/Pitch/Innoserv pitch deck-images-0.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch/Innoserv pitch deck-images-1.jpg\",\n      ],\n      images2: [\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-0.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-1.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-2.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-3.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-4.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-5.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-6.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-7.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-8.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-0.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-10.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-11.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-12.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-13.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-14.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-15.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-16.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-17.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-18.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-19.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-20.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-21.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-22.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-23.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-24.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-25.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-26.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-27.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-28.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-29.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-30.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-31.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-32.jpg\",\n        \"./assets/images/deals-details/Innoserv/Pitch1/Innoserv2.0-images-33.jpg\",\n      ],\n      current: \"\",\n      current2: \"\",\n    };\n  }\n  callback1 = (key) => {};\n  callback2 = (key) => {};\n  callback3 = (key) => {};\n\n  componentWillMount() {\n    document.title = \"Innoserv - Growth91 - Startup Marketplace \";\n  }\n  componentDidMount() {\n    let deal_id = \"131\";\n    this.setState({ deal_id: deal_id }, () => {\n      this.get_pitch_list();\n    });\n\n    if (\n      localStorage.getItem(\"investor_id\") ||\n      localStorage.getItem(\"founder_id\")\n    ) {\n      if (localStorage.getItem(\"investor_id\")) {\n        let investor_id = localStorage.getItem(\"investor_id\");\n        this.setState(\n          { investor_id: investor_id, user_type: \"investor\" },\n          () => {\n            this.getstatusdata();\n            this.getinvestmentdetails();\n            this.check_for_membership_type();\n            this.getwallethistory();\n            this.get_invest_amt();\n          }\n        );\n      } else if (localStorage.getItem(\"founder_id\")) {\n        this.get_founder_details();\n        this.setState({ user_type: \"founder\" });\n      }\n    } else {\n      this.getDeals();\n    }\n    this.getordertoken();\n    this.getGst();\n    this.get_deal_doucments(deal_id);\n    // console.log(\"hello\");\n  }\n  get_founder_details = () => {\n    let params = {\n      founder_id: localStorage.getItem(\"founder_id\"),\n    };\n    Bridge.founder.get_founder_profile_details(params).then((result) => {\n      if (result.status == \"1\") {\n        if (result.data.length > 0) {\n          let investor_id = localStorage.getItem(\"founder_id\");\n          this.setState({ investor_id: investor_id }, () =>\n            this.getwallethistory()\n          );\n          setTimeout(() => {\n            if (result.data[0].is_investor == \"1\") {\n              this.getstatusdata();\n              this.getinvestmentdetails();\n              this.check_for_membership_type();\n              this.setState({ founder_is_investor: \"1\" });\n            } else {\n              this.check_for_membership_type();\n              this.setState({ founder_is_investor: \"0\" });\n            }\n          }, 200);\n        }\n      } else {\n        this.setState({ formloader: false });\n      }\n    });\n  };\n  get_deal_doucments = (deal_id) => {\n    let params = {\n      deal_id: deal_id,\n    };\n    Bridge.get_deal_doucments(params).then((result) => {\n      if (result.status == \"1\") {\n        let arr = [];\n        for (let item of result.data) {\n          item.selected = false;\n          arr = [...arr, item];\n        }\n        this.setState({ documents: arr }, () =>\n          this.get_document_purchased_list()\n        );\n      }\n    });\n  };\n  show_selected_checkbox = (single) => {\n    let arr = [];\n    let docuemnts = this.state.documents;\n    for (let item of docuemnts) {\n      if (item.documentid == single.documentid) {\n        item.selected = item.selected == true ? false : true;\n      }\n      arr = [...arr, item];\n    }\n    this.setState({ docuemnts: arr });\n    let data = [];\n    for (let item2 of arr) {\n      data = [...data, item2.selected];\n    }\n    let status = data.includes(true);\n    this.setState({ button_status: !status });\n  };\n\n  getwallethistory() {\n    if (this.state.investor_id) {\n      let params = {\n        investor_id: this.state.investor_id,\n      };\n      Bridge.investor.get_wallet_history(params).then((result) => {\n        if (result.status == \"1\") {\n          let credit_amount = 0;\n          let debit_amount = 0;\n          for (let item of result.data) {\n            if (item.type == \"credited\") {\n              credit_amount = parseInt(credit_amount) + parseInt(item.amount);\n            }\n            if (item.type == \"debited\") {\n              debit_amount = parseInt(debit_amount) + parseInt(item.amount);\n            }\n          }\n          let total = parseInt(credit_amount - debit_amount);\n          this.setState({ walletMoney: Math.abs(total) });\n        } else {\n        }\n      });\n    }\n  }\n  //for getting gst from admin page\n  getGst = () => {\n    Bridge.admin.settings.getsettings().then((result) => {\n      if (result.status == \"1\") {\n        this.setState({ gst: result.data[0].taxation_percentage });\n      } else {\n        // console.log(\"gst can not be able to fetch\")\n      }\n    });\n  };\n  check_for_membership_type = () => {\n    this.setState({ formloader: true });\n    let params = {\n      investor_id: this.state.investor_id,\n    };\n    Bridge.check_for_membership_type(params).then((result) => {\n      if (result.status == 1) {\n        if (result.data.length > 0) {\n          this.setState({\n            check_membership_type: result.data[0].membership_type,\n          });\n          setTimeout(() => {\n            this.getDeals();\n          }, 500);\n        }\n      } else {\n        this.setState({ formloader: false });\n      }\n    });\n    setTimeout(() => {\n      this.getdealsettings();\n    }, 500);\n  };\n  getordertoken = () => {\n    Bridge.getcashfreetoken().then((result) => {\n      let orderToken = result.order_token;\n      // console.log(orderToken , \"Order Token\")\n      this.setState({ order_token: orderToken });\n    });\n  };\n  // get post list\n  getdealsettings = () => {\n    this.setState({ formloader: true });\n    Bridge.admin.settings.getdealsettings().then((result) => {\n      if (result.status == 1) {\n        // console.log('result',result.data);\n        this.setState({\n          label: result.data[0].label,\n        });\n        if (this.state.check_membership_type == \"premium\") {\n          this.setState({\n            percentage: result.data[0].premium_member_deal_percentage,\n          });\n        } else {\n          this.setState({\n            percentage: result.data[0].regular_member_deal_percentage,\n          });\n        }\n      } else {\n        // message.error(result.message);\n        this.setState({\n          formloader: false,\n        });\n      }\n    });\n  };\n\n  get_pitch_list = () => {\n    this.setState({ loading: true });\n    let params = {\n      deal_id: this.state.deal_id,\n    };\n    Bridge.deal.get_image_list_of_pitch(params).then((result) => {\n      if (result.status == 1) {\n        let arr = [];\n        for (let data of result.data) {\n          let pitchImg =\n            Apis.IMAGEURL +\n            \"deal/pitch_images/\" +\n            data.deal_id +\n            \"/\" +\n            data.image;\n          data.img = pitchImg;\n          arr = [...arr, data];\n        }\n        arr.sort((a, b) =>\n          a.pitch_order > b.pitch_order\n            ? 1\n            : b.pitch_order > a.pitch_order\n            ? -1\n            : 0\n        );\n        // console.log('arr',arr);\n        this.setState({ pitch_list: arr, loading: false });\n      } else {\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  getinvestmentdetails = () => {\n    this.setState({ loading: true });\n    let params = {\n      investor_id: this.state.investor_id,\n      deal_id: this.state.deal_id,\n    };\n    Bridge.investor.getinvestmentdetails(params).then((result) => {\n      if (result.status == 1) {\n        if (result.data != \"\") {\n          this.setState({ isInvested: true });\n        }\n      } else {\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  // get deal list\n  getstatusdata = () => {\n    this.setState({ loading: true });\n    let params = {\n      id: this.state.investor_id,\n    };\n    Bridge.users.getstatusdata(params).then((result) => {\n      if (result.status == 1) {\n        this.setState({\n          kycstatus: result.data[0].kycstatus,\n          bankstatus: result.data[0].ifsc_code ? true : false,\n          loading: false,\n          name: result.data[0].first_name + \" \" + result.data[0].last_name,\n          email: result.data[0].email,\n          mobile: result.data[0].mobile,\n        });\n      } else {\n        message.error(result.message);\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  // get deal list\n  getDeals = () => {\n    this.setState({ loading: true });\n    Bridge.deal.list().then((result) => {\n      // console.log(result.data, \"data\");\n      if (result.status == 1) {\n        this.setState({\n          deals: result.data,\n          loading: false,\n        });\n        let current_date = moment();\n        for (let d of result.data) {\n          // console.log(d.deal_id , \"id\")\n          // console.log(this.state.deal_id , \"sid\")\n          if (d.deal_id == this.state.deal_id) {\n            //  console.log(d.deal_status)\n            let deal_regular_show_date = moment(d.regular_show_date);\n            let deal_premium_show_date = moment(d.premium_show_date);\n            let deal_start_dt_rg = moment(d.deal_st_date);\n            let deal_start_dt_prem = moment(d.deal_start_dt_prem);\n            if (this.state.check_membership_type == \"premium\") {\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_show_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({ show_data: \"block\" });\n              } else if (current_date > deal_premium_show_date) {\n                this.setState({ show_data: \"block\" });\n              } else {\n                this.setState({ show_data: \"none\" });\n                window.location.assign(\"/deals\");\n                return;\n              }\n            } else if (this.state.check_membership_type == \"regular\") {\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_show_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({ show_data: \"block\" });\n              } else if (current_date > deal_regular_show_date) {\n                this.setState({ show_data: \"block\" });\n              } else {\n                this.setState({ show_data: \"none\" });\n                window.location.assign(\"/deals\");\n                return;\n              }\n            }\n          }\n          // else{\n          //   // window.location.href = (\"/deals\")\n          //   // return;\n          //   console.log(d.deal_id , this.state.deal_id);\n          // }\n        }\n        for (let d of result.data) {\n          if (d.deal_id == this.state.deal_id) {\n            if (d.show_status == \"0\") {\n              this.setState({ is_deal_visible: false });\n              // window.location.assign(\"/deals\")\n            } else {\n              this.setState({ is_deal_visible: true });\n            }\n            let investor_id = this.state.investor_id;\n            if (d.deal_t_type == \"Private\") {\n              if (\n                investor_id &&\n                d.invitations.length > 0 &&\n                d.invitations.includes(investor_id)\n              ) {\n              } else {\n                window.location.assign(\"/deals\");\n                return;\n              }\n            }\n            let logourl =\n              Apis.IMAGEURL + \"deal/logo/\" + d.deal_id + \"/\" + d.logo;\n\n            let pdffile = `${process.env.REACT_APP_BASE_URL}api/uploads/deal/pitch/${d.deal_id}/${d.pitch_file}`;\n            let pitchImg =\n              Apis.IMAGEURL +\n              \"deal/pitch_images/\" +\n              d.deal_id +\n              \"/\" +\n              d.pitch_files;\n            let percetage_raised = parseFloat(\n              (d.total_invested_amount / d.deal_fund_requested) * 100 +\n                parseInt(d.raiegap)\n            ).toFixed(0);\n            let deal_premium_start_date = moment(d.deal_start_dt_prem);\n            let deal_regular_start_date = moment(d.deal_st_date);\n            let deal_premium_end_date = moment(d.deal_end_dt_prem);\n            let deal_regular_end_date = moment(d.deal_deal_end_date);\n            this.setState({ deal_regular_end_date: deal_regular_end_date });\n            let button_show_status = false;\n\n            // console.log('this.state.check_membership_type',this.state.check_membership_type);\n            // console.log('deal_regular_start_date',deal_regular_start_date);\n            // console.log('deal_regular_end_date',deal_regular_end_date);\n            // console.log('current_date',current_date);\n            // deal changes\n            let differece = \"\";\n            let dealEndDate = \"\";\n            let currentDate = \"\";\n            this.setState({ coming_soon_days: \"\" });\n            if (this.state.check_membership_type == \"premium\") {\n              dealEndDate = moment(d.deal_end_dt_prem).format(\"YYYY-MM-DD\");\n              currentDate = moment().format(\"YYYY-MM-DD\");\n              let days = this.getDifferenceInDays(currentDate, dealEndDate);\n              differece = days;\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") >\n                  deal_premium_start_date.format(\"YYYY-MM-DD\") &&\n                moment(current_date).format(\"YYYY-MM-DD\") <\n                  moment(deal_premium_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else {\n                button_show_status = false;\n              }\n              //for deal start date\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") <=\n                moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({\n                  coming_soon_days: this.getDifferenceInDays(\n                    moment(current_date).format(\"YYYY-MM-DD\"),\n                    moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n                  ),\n                });\n              }\n            } else if (\n              this.state.check_membership_type == \"regular\" ||\n              this.state.check_membership_type == \"\"\n            ) {\n              dealEndDate = moment(d.deal_end_date).format(\"YYYY-MM-DD\");\n              currentDate = moment().format(\"YYYY-MM-DD\");\n              let days = this.getDifferenceInDays(currentDate, dealEndDate);\n              differece = days;\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") >\n                  deal_regular_start_date.format(\"YYYY-MM-DD\") &&\n                moment(current_date).format(\"YYYY-MM-DD\") <\n                  moment(deal_regular_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else {\n                button_show_status = false;\n              }\n              //for deal start date\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") <=\n                moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({\n                  coming_soon_days: this.getDifferenceInDays(\n                    moment(current_date).format(\"YYYY-MM-DD\"),\n                    moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n                  ),\n                });\n              }\n            }\n            // console.log('button_show_status',this.state.button_show_status);\n            this.setState(\n              {\n                deal_name: d.name,\n                deal_description: d.Muliples_of,\n                // isBlank:d.deal_status == \"Closed\" ? window.location.href = \"/\" : \"/\",\n                isPrivate: d.deal_t_type == \"Private\" ? true : false,\n                isFunded: d.deal_status == \"Closed\" ? true : false,\n                tags: d.deal_category ? JSON.parse(d.deal_category) : [],\n                logo: logourl,\n                youtube_url: d.youtubelink,\n                dealenddays: differece > 0 ? differece : 0,\n                minamount: Number(d.Min_inv_amt),\n                captable_threshold_amount: parseInt(\n                  parseFloat(d.captable_threshold_amount).toFixed(2),\n                  10\n                ),\n                maxamount: d.Max_inv_amt,\n                captable_multiple_amount: parseInt(\n                  parseFloat(d.captable_multiple_amount).toFixed(2),\n                  10\n                ),\n                amount: \"\", //d.Min_inv_amt\n                commaAmount: \"\", //d.Min_inv_amt\n                pdffile: pdffile,\n                pitch_files: pitchImg,\n                percentage_raised: percetage_raised,\n                button_show_status: button_show_status,\n                show_data: \"block\",\n                multiples_of: d.multiples_of,\n                deal_service: d.deal_service,\n              },\n              () => this.calculategst()\n            );\n          }\n        }\n      } else {\n        message.error(result.message);\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  getDifferenceInDays = (date1, date2) => {\n    let diff = Math.floor((Date.parse(date2) - Date.parse(date1)) / 86400000);\n    let final = 0;\n    if (diff < 0) {\n      final = 0;\n      this.setState({\n        deal_regular_end_date_status: 1,\n      });\n    } else {\n      final = diff;\n      this.setState({\n        deal_regular_end_date_status: 0,\n      });\n    }\n    return final;\n  };\n\n  showalertmessage = () => {\n    // message.warning('Please complete your KYC process or bank details to access this deal.');\n  };\n\n  showModal1 = () => {\n    if (this.state.kycstatus == \"admin_rejected\") {\n      message.warning(\n        \"Your KYC is Rejected, Please Contact to contact@Growth91<sup>TM</sup>.com\"\n      );\n      return;\n    }\n    this.setState(\n      {\n        investmentmodal: true,\n      },\n      () => {\n        this.calculategst();\n      }\n    );\n  };\n\n  // post api hit on express\n  getpostData = () => {\n    const formData = new FormData();\n    formData.append(\"deal_id\", this.state.deal_id);\n    formData.append(\"investor_id\", this.state.investor_id);\n    axios\n      .post(\n        `${process.env.REACT_APP_BASE_URL}api/investors/InvestorCommitment/save_investor_interest_deal`,\n        formData,\n        {\n          headers: {\n            \"Content-Type\": \"multipart/form-data\",\n          },\n        }\n      )\n      .then((response) => {\n        this.setState({\n          interested_id: response.data.data,\n        });\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  };\n\n  handleOk1 = () => {\n    this.setState({\n      investmentmodal: false,\n    });\n  };\n\n  handleCancel1 = () => {\n    this.setState({\n      investmentmodal: false,\n    });\n  };\n\n  showModal2 = () => {\n    this.setState({\n      confirmmodalstatus: true,\n    });\n  };\n\n  handleOk2 = () => {\n    this.setState({\n      confirmmodalstatus: false,\n    });\n  };\n\n  handleCancel2 = () => {\n    this.setState({\n      confirmmodalstatus: false,\n    });\n  };\n  onChangeConvenience = (e) => {\n    this.setState({\n      [e.target.name]: e.target.checked,\n      Convenience: e.target.checked,\n    });\n  };\n  onChangeCheckbox = (e) => {\n    this.setState({\n      [e.target.name]: e.target.checked,\n      agreeCheck: e.target.checked,\n    });\n\n    if (e.target.name == \"deduct\") {\n      if (e.target.checked == true) {\n        let processingfees = parseFloat(\n          (this.state.amount / 100) * parseFloat(this.state.percentage)\n        );\n        let tdsamount = parseFloat(processingfees / 100) * 10;\n        let minusamt = parseFloat(processingfees - tdsamount);\n\n        this.setState({\n          processingfees: minusamt,\n          tdsdeductedamount: tdsamount,\n        });\n      } else {\n        let processingfees = parseFloat(\n          (this.state.amount / 100) * parseFloat(this.state.percentage)\n        );\n        this.setState({\n          processingfees: processingfees,\n          tdsdeductedamount: 0,\n        });\n      }\n    }\n  };\n\n  // investing your money\n  invest = () => {\n    let investor_id = this.state.investor_id;\n    let deal_id = this.state.deal_id;\n    let Investment_amt = this.state.totalamount;\n    let deductstatus = this.state.deduct == true ? \"1\" : \"0\";\n    let agreestatus = this.state.agree == true ? \"1\" : \"0\";\n    let payment_ref = this.state.order_token;\n    let tdsstatus = this.state.tdsstatus == true ? \"1\" : \"0\";\n    let processingfees = this.state.processingfees;\n    let gst = this.state.gst;\n    let legalfees = this.state.legalfee;\n    let order_id = \"order-01\";\n    let walletamt = this.state.walletDeductionMoney\n      ? this.state.walletDeductionMoney\n      : 0;\n\n    let url = `${process.env.REACT_APP_BASE_URL}cashfree/checkout.php?investor_id=${investor_id}&deal_id=${deal_id}&deductstatus=${deductstatus}&agreestatus=${agreestatus}&payment_ref=${payment_ref}&tdsstatus=${tdsstatus}&processingfees=${processingfees}&gst=${gst}&legalfees=${legalfees}&Investment_amt=${Investment_amt}&order_id=${order_id}&wallet=${walletamt}`;\n    // console.log('url',url);\n    window.location.assign(url);\n  };\n\n  loadScript = (src) => {\n    return new Promise((resolve) => {\n      const script = document.createElement(\"script\");\n      script.src = src;\n\n      script.onload = () => {\n        resolve(true);\n      };\n\n      script.onerror = () => {\n        resolve(false);\n      };\n\n      document.body.appendChild(script);\n    });\n  };\n\n  calculategst = () => {\n    let legalfee = parseFloat(\n      (this.state.amount / 100) * parseFloat(this.state.percentage)\n    );\n    let gst = this.state.gst;\n    let amt = parseFloat(this.state.amount);\n    let walletDeductionMoney;\n    if (this.state.checkWallet == false) {\n      walletDeductionMoney = 0;\n    } else {\n      walletDeductionMoney =\n        legalfee.toFixed(0) <= this.state.walletMoney\n          ? legalfee.toFixed(0)\n          : this.state.walletMoney;\n    }\n    let gstValue = ((legalfee.toFixed(0) - walletDeductionMoney) * gst) / 100;\n    this.setState({\n      gst: gst,\n      legalfee: this.state.amount ? legalfee.toFixed(0) : 0,\n      amountplusgst: this.state.amount ? amt.toFixed(0) : 0,\n      processingfees: this.state.amount ? legalfee.toFixed(0) : 0,\n      totalamount: this.state.amount\n        ? (amt + parseFloat(legalfee)).toFixed(0) -\n          walletDeductionMoney +\n          gstValue\n        : 0,\n      walletDeductionMoney: walletDeductionMoney,\n      gstValue: gstValue,\n    });\n    return gst;\n  };\n  documentPay = () => {\n    if (!this.state.investor_id) {\n      message.warning(\"Please login first to invest.\", 5);\n      return;\n    }\n    let documents = this.state.documents;\n    let paying_for_documents = [];\n    let totalamt = 0;\n    for (let item of documents) {\n      if (item.selected == true) {\n        totalamt +=\n          this.state.check_membership_type == \"premium\"\n            ? Number(item.premium_price)\n            : Number(item.regular_price);\n        paying_for_documents = [...paying_for_documents, item.documentid];\n      }\n    }\n    let order_id = \"order-01\";\n    let user_id = this.state.investor_id;\n    let amount = totalamt;\n    let docs = paying_for_documents.join(\"-\").toString();\n    let deal_id = this.state.deal_id;\n    let url = `${process.env.REACT_APP_BASE_URL}cashfree/buy_documents/checkout.php?user_id=${user_id}&order_id=${order_id}&amount=${amount}&docs=${docs}&deal_id=${deal_id}`;\n\n    window.location.href = url;\n  };\n  get_document_purchased_list = () => {\n    if (this.state.investor_id) {\n      let params = {\n        investor_id: this.state.investor_id,\n        deal_id: this.state.deal_id,\n      };\n      Bridge.deal.get_document_purchased_list(params).then((result) => {\n        if (result.status == 1) {\n          let arr = [];\n          let documents = this.state.documents;\n          for (let item of documents) {\n            let status = false;\n            item.user_paid = false;\n            for (let item2 of result.data) {\n              if (item2.document_id == item.documentid || item.paid == \"Free\") {\n                item.user_paid = true;\n              }\n            }\n            arr = [...arr, item];\n          }\n          this.setState({ documents: arr });\n        }\n      });\n    }\n  };\n  check_for_error = () => {\n    let error = \"\";\n    let multiple_of =\n      parseFloat(this.state.amount) / parseFloat(this.state.multiples_of);\n    if (Number(this.state.amount) < Number(this.state.minamount)) {\n      error = `Minimum investment amount is Rs. ${this.state.minamount}`;\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (Number(this.state.amount) > Number(this.state.maxamount)) {\n      error = `Maximum investment amount is Rs. ${this.state.maxamount}`;\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (\n      Number(this.state.amount) <\n        Number(this.state.captable_threshold_amount) &&\n      Number(this.state.amount) % Number(this.state.multiples_of) != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(\n          Number(this.state.amount) / Number(this.state.multiples_of)\n        ) * Number(this.state.multiples_of);\n      const roundedHigherAmount =\n        Math.ceil(Number(this.state.amount) / Number(this.state.multiples_of)) *\n        Number(this.state.multiples_of);\n\n      error = `Please enter an amount in multiples of ${this.state.multiples_of}. You may choose Rs ${roundedLowerAmount}\n      or Rs ${roundedHigherAmount}.`;\n      // If you would like to enter the Captable, commit an amount of Rs. ${this.state.captable_threshold_amount} or more.`;\n\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (\n      Number(this.state.amount) >\n        Number(this.state.captable_threshold_amount) &&\n      Number(this.state.amount) % Number(this.state.captable_multiple_amount) !=\n        0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(\n          Number(this.state.amount) /\n            Number(this.state.captable_multiple_amount)\n        ) * Number(this.state.captable_multiple_amount);\n      const roundedHigherAmount =\n        Math.ceil(\n          Number(this.state.amount) /\n            Number(this.state.captable_multiple_amount)\n        ) * Number(this.state.captable_multiple_amount);\n\n      error = `Please enter an amount in multiples of ${this.state.captable_multiple_amount}. You may choose Rs ${roundedLowerAmount}\n      or Rs ${roundedHigherAmount}.`;\n      // If you would like to enter the Captable, commit an amount of Rs. ${this.state.captable_threshold_amount} or more.`;\n\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else {\n      this.setState({ amount_error: \"\", amount_error_status: false });\n    }\n  };\n  get_invest_amt = () => {\n    axios\n      .get(\n        `${process.env.REACT_APP_BASE_URL}api/investors/InvestorCommitment/get_investor_investment_for_deal`,\n        {\n          params: {\n            deal_id: this.state.deal_id,\n            investor_id: this.state.investor_id,\n          },\n        }\n      )\n      .then((response) => {\n        // console.log(\"invest_amt : \", response.data.data[0].totalamount);\n        this.setState({ invest_amt: response.data.data[0].totalamount });\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  };\n\n  increase_commit = () => {\n    const {\n      amount,\n      captable_threshold_amount,\n      multiples_of,\n      maxamount,\n      captable_multiple_amount,\n      minamount,\n    } = this.state;\n\n    let newAmount = Number(amount);\n    let changeAmount;\n\n    if (\n      newAmount < captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount > captable_threshold_amount &&\n      newAmount % captable_multiple_amount != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(captable_multiple_amount)) *\n        Number(captable_multiple_amount);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (newAmount < Number(captable_threshold_amount)) {\n      changeAmount = Number(multiples_of);\n    } else {\n      changeAmount = Number(captable_multiple_amount);\n    }\n\n    newAmount += changeAmount;\n\n    if (newAmount > maxamount) {\n      newAmount = maxamount;\n    } else if (newAmount < minamount) {\n      newAmount = Number(minamount);\n    }\n\n    this.setState(\n      {\n        amount: newAmount,\n        commaAmount: this.formatNumberWithCommas(newAmount),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  decrease_commit = () => {\n    const {\n      amount,\n      captable_threshold_amount,\n      multiples_of,\n      minamount,\n      captable_multiple_amount,\n    } = this.state;\n\n    let newAmount = Number(amount);\n    let changeAmount;\n\n    if (\n      newAmount == captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount < captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedLowerAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount > captable_threshold_amount &&\n      newAmount % captable_multiple_amount != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(newAmount / Number(captable_multiple_amount)) *\n        Number(captable_multiple_amount);\n      newAmount = roundedLowerAmount;\n      changeAmount = 0;\n    } else if (newAmount <= Number(captable_threshold_amount)) {\n      changeAmount = Number(multiples_of);\n    } else {\n      changeAmount = Number(captable_multiple_amount);\n    }\n\n    newAmount -= changeAmount;\n\n    if (newAmount < minamount) {\n      newAmount = minamount;\n    }\n\n    this.setState(\n      {\n        amount: newAmount,\n        commaAmount: this.formatNumberWithCommas(newAmount),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  handleCommitAmount = (value) => {\n    this.setState(\n      {\n        amount: value.replace(/,/g, \"\"),\n        commaAmount: this.formatNumberWithCommas(value),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  formatNumberWithCommas = (number) => {\n    return number.toLocaleString(\"en-IN\");\n  };\n\n  getSliderSettings() {\n    return {\n      dots: false,\n      infinite: false,\n      speed: 500,\n      slidesToShow: 1,\n      slidesToScroll: 1,\n    };\n  }\n\n  handleClickImage = (image) => {\n    this.setState({\n      current: image,\n    });\n  };\n  handleClickImage2 = (image) => {\n    this.setState({\n      current2: image,\n    });\n  };\n\n  handleCloseModal = () => {\n    this.setState({\n      current: \"\",\n      current2: \"\",\n    });\n  };\n\n  render() {\n    const myStyle = {\n      color: \"white\",\n      fontSize: \"17px\",\n      padding: \"50px\",\n      // justifyItem:\"center\"1\n    };\n    const genExtra = () => (\n      <>\n        {/* <PlusOutlined\n        onClick={event => {\n          If you don't want click extra trigger collapse, you can prevent this:\n          event.stopPropagation();\n        }}\n      /> */}\n      </>\n    );\n    const settings = this.getSliderSettings();\n    const { images, current, current2, images2 } = this.state;\n\n    return (\n      <>\n        {this.state.is_deal_visible == true ? (\n          <div style={{ display: this.state.show_data }}>\n            <NewWebHeader newabout={\"newabout\"} />\n            <section\n              className=\"deals-details-page\"\n              style={{ marginBottom: \"-50px\" }}\n            >\n              <div className=\"container main-section\">\n                <div className=\"row\">\n                  <div className=\"col-lg-5 col-md-5 col-sm-5\">\n                    <Spin spinning={this.state.loading}>\n                      <div className=\"d-flex justify-content-between align-items-center\">\n                        <div className=\"d-flex align-items-center\">\n                          {/* Image is static */}\n                          <img\n                            src=\"./assets/images/deals-details/Innoserv/logo.jpeg\"\n                            alt=\"\"\n                            className=\"img-fluid\"\n                            style={{\n                              marginRight: \"20px\",\n                              width: \"50%\",\n                              objectFit: \"contain\",\n                            }}\n                          />\n                          <h5 className=\"ml-5 mt-4\">Innoserv</h5>\n                          {/* <h5>{this.state.logo}</h5> */}\n                        </div>\n                        {this.state.isPrivate == true && (\n                          <div\n                            className=\"private-tag\"\n                            style={{\n                              height: 38,\n                            }}\n                          >\n                            <span style={{ fontSize: 12 }}>Private</span>{\" \"}\n                          </div>\n                        )}\n                      </div>\n                      <div className=\"d-flex tags\">\n                        {this.state.tags.length > 0 &&\n                          this.state.tags.map((tag, index) => (\n                            <div\n                              className=\"hero-tag\"\n                              key={index}\n                              style={{\n                                background: \"rgb(41 23 111)\",\n                                color: \"#fff\",\n                              }}\n                            >\n                              {tag}\n                            </div>\n                          ))}\n                      </div>\n                      <p style={{ textAlign: \"justify\" }}>\n                        Innoserv is a forward-thinking company specializing in\n                        AI-driven digital marketing and corporate training\n                        solutions. With over 11 years of market presence,\n                        InnoServ operates through its two primary business\n                        units: AiQ Brand Quotient (AiQ BQ), which focuses on\n                        innovative branding strategies that blend human\n                        creativity with advanced AI technology, and iSkillBox,\n                        which delivers personalized, AI-enabled e-learning and\n                        corporate training programs. By leveraging cutting-edge\n                        technologies, InnoServ provides businesses with tailored\n                        marketing and training solutions, enhancing brand\n                        engagement and workforce development. With a strong\n                        global client base and a strategic focus on operational\n                        efficiency, InnoServ is poised for significant growth\n                        and leadership in the rapidly evolving digital\n                        landscape.\n                      </p>{\" \"}\n                      <div className=\" percentage-container\">\n                        <div className=\"percentage-values\">\n                          {this.state.coming_soon_days ? (\n                            <>\n                              <div>\n                                <h3>{this.state.percentage_raised}%</h3>\n                                <span>RAISED</span>\n                              </div>\n                              <div style={{ textAlign: \"right\" }}>\n                                <h3>{this.state.coming_soon_days} Days</h3>\n                                <span>CAMPAIGN START IN</span>\n                              </div>\n                            </>\n                          ) : (\n                            <>\n                              <div>\n                                <h3>{this.state.percentage_raised}%</h3>\n                                <span>RAISED</span>\n                              </div>\n                              <div style={{ textAlign: \"right\" }}>\n                                <h3>{this.state.dealenddays} Days</h3>\n                                <span>CAMPAIGN ENDS IN</span>\n                              </div>\n                            </>\n                          )}\n                        </div>\n                        <Progress\n                          percent={this.state.percentage_raised}\n                          strokeColor={{\n                            \"0%\": \"rgb(255 156 26)\",\n                            \"100%\": \"rgb(255 156 26)\",\n                          }}\n                          showInfo={false}\n                        />\n                      </div>\n                      {!this.state.investor_id ? (\n                        <div className=\"button-group text-center\">\n                          <a className=\"prime-bg\" href=\"/Login\">\n                            Login\n                          </a>\n                          {/* <button className='share-button'>\n                        <i className='bx bxs-share'></i>\n                      </button> */}\n                        </div>\n                      ) : (\n                        <>\n                          {this.state.button_show_status == true ? (\n                            <>\n                              <div className=\"button-group\">\n                                {this.state.isFunded == true ? (\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg text-center\"\n                                  >\n                                    Deal is closed\n                                  </a>\n                                ) : this.state.user_type != \"founder\" &&\n                                  this.state.invest_amt !== null ? (\n                                  <div className=\"button-group\">\n                                    <p>{`You have committed Rs. ${this.state.invest_amt} to this deal so far. (Including platform fees)`}</p>\n                                    <a\n                                      href=\"#!\"\n                                      style={{ padding: \"13px 0\" }}\n                                      onClick={() => {\n                                        this.getpostData();\n                                        this.showModal1();\n                                      }}\n                                      className=\"black-button prime-bg text-center\"\n                                      id=\"btn-invest\"\n                                    >\n                                      Add more\n                                    </a>\n                                  </div>\n                                ) : this.state.isPrivate == true &&\n                                  this.state.user_type != \"founder\" ? (\n                                  <a\n                                    style={{ padding: \"13px 0\" }}\n                                    href=\"#\"\n                                    onClick={() => {\n                                      this.getpostData();\n                                      this.showModal1();\n                                    }}\n                                    className=\"black-button prime-bg text-center\"\n                                  >\n                                    Express Your Interest\n                                  </a>\n                                ) : this.state.user_type == \"founder\" ? (\n                                  <div>\n                                    {this.state.user_type == \"founder\" &&\n                                    this.state.founder_is_investor == \"1\" ? (\n                                      <a\n                                        href=\"#\"\n                                        style={{ padding: \"15px 0\" }}\n                                        className=\"black-button prime-bg text-center\"\n                                        onClick={() => {\n                                          this.getpostData();\n                                          this.showModal1();\n                                        }}\n                                      >\n                                        Express Your Interest\n                                      </a>\n                                    ) : (\n                                      <a\n                                        href=\"/founder-as-investor\"\n                                        className=\"black-button prime-bg text-center\"\n                                      >\n                                        Apply as investor\n                                      </a>\n                                    )}\n                                  </div>\n                                ) : (\n                                  <div>\n                                    {this.state.user_type == \"investor\" &&\n                                    this.state.invest_amt === null ? (\n                                      <a\n                                        href=\"#\"\n                                        className=\"black-button prime-bg text-center\"\n                                        onClick={() => {\n                                          this.getpostData();\n                                          this.showModal1();\n                                        }}\n                                        style={{ padding: \"13px 0\" }}\n                                      >\n                                        Express Your Interest\n                                      </a>\n                                    ) : null}\n                                  </div>\n                                )}\n                                {/* <button className='share-button'>\n                              <i className='bx bxs-share'></i>\n                            </button> */}\n                              </div>\n                            </>\n                          ) : (\n                            // <div className='button-group'>\n                            //   <a href=\"#\" className=\"black-button prime-bg\" style={{cursor:'default'}} >Coming soon..</a>\n                            // </div>\n                            <>\n                              {this.state.deal_regular_end_date_status == 0 ? (\n                                <div className=\"button-group\">\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg\"\n                                    style={{ cursor: \"default\" }}\n                                  >\n                                    Coming soon..\n                                  </a>\n                                </div>\n                              ) : (\n                                <div className=\"button-group\">\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg\"\n                                    style={{ cursor: \"default\" }}\n                                  >\n                                    Deal is closed\n                                  </a>\n                                </div>\n                              )}\n                            </>\n                          )}\n                        </>\n                      )}\n                    </Spin>\n                  </div>\n                  <Modal\n                    title={`Invest in ${this.state.deal_name}`}\n                    visible={this.state.investmentmodal}\n                    onOk={this.handleOk1}\n                    onCancel={this.handleCancel1}\n                    width={600}\n                    footer={false}\n                  >\n                    <div className=\"row modal-body\">\n                      <div className=\"login mt-3\">\n                        <label>\n                          <b>\n                            Amount: <br />\n                            Minimum investment Rs.{\" \"}\n                            {this.formatNumberWithCommas(\n                              this.state.minamount\n                            )}{\" \"}\n                            <br />\n                            Cap Table entry is Rs.\n                            {this.formatNumberWithCommas(\n                              this.state.captable_threshold_amount\n                            )}\n                          </b>\n                        </label>\n                        <input\n                          type=\"text\"\n                          name=\"amount\"\n                          className=\"form-input-field mt-4\"\n                          autofocus={true}\n                          placeholder=\"amount\"\n                          style={{\n                            border:\n                              this.state.amount_error_status == true &&\n                              this.state.amount\n                                ? \"1px solid red\"\n                                : \"1px solid transparent\",\n                          }}\n                          id=\"selected-field\"\n                          value={this.state.commaAmount}\n                          onChange={(e) => {\n                            this.handleCommitAmount(e.target.value);\n                          }}\n                        />\n                        <div className=\"d-flex justify-content-between mb-3\">\n                          <button\n                            className=\"commit-plus\"\n                            onClick={this.decrease_commit}\n                          >\n                            -\n                          </button>\n                          <button\n                            className=\"commit-minus\"\n                            onClick={this.increase_commit}\n                          >\n                            +\n                          </button>\n                        </div>\n                        {this.state.amount_error_status == true && (\n                          <p\n                            className=\"text-danger pb-0\"\n                            style={{ position: \"relative\", top: -19 }}\n                          >\n                            {this.state.amount_error}\n                          </p>\n                        )}\n                      </div>\n\n                      <div class=\"form-group form-check d-flex\">\n                        <Checkbox\n                          checked={this.state.checkWallet}\n                          onChange={(e) => {\n                            this.setState(\n                              { checkWallet: e.target.checked },\n                              () => this.calculategst()\n                            );\n                          }}\n                        >\n                          {\" \"}\n                        </Checkbox>\n                        <label className=\"form-check-label\">\n                          Use Your ₹ {this.state.walletMoney} Growth91\n                          <sup style={{ fontSize: \"0.6rem\" }}>\n                            TM\n                          </sup> Money{\" \"}\n                        </label>\n                      </div>\n                      <div className=\" d-flex justify-content-center modal-table\">\n                        <table\n                          className=\"col-12 m-5 investment-charge-table\"\n                          cellPadding={4}\n                        >\n                          <tr>\n                            <th>\n                              <strong>Particulars</strong>\n                            </th>\n                            <th>\n                              <strong>Amount</strong>\n                            </th>\n                          </tr>\n                          <tr>\n                            <td>Investment Amount</td>\n                            <td lassName=\"text-center\">\n                              ₹{\" \"}\n                              {this.state.amountplusgst\n                                ? this.state.amountplusgst\n                                : \"0\"}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>\n                              Convenience Fees\n                              <br />\n                              <span>{this.state.label}</span>\n                            </td>\n                            <td lassName=\"text-center\">\n                              ₹ {this.state.processingfees}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>Wallet Money</td>\n                            <td lassName=\"text-center\">\n                              - ₹ {this.state.walletDeductionMoney}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>Total</td>\n                            <td>\n                              ₹ {parseFloat(this.state.totalamount).toFixed(0)}\n                            </td>\n                          </tr>\n                        </table>\n                      </div>\n                      {this.state.invest_amt !== null ? (\n                        <div className=\"\">\n                          <Alert\n                            message={`You have committed Rs. ${this.state.invest_amt} to this deal so far. (Including platform fees)`}\n                            type=\"info\"\n                          />\n                        </div>\n                      ) : null}\n                      <div className=\"m-3\">\n                        <label className=\"container-check\">\n                          I Agree to Terms and Conditions and have read the\n                          Privacy Policy. And, I understand that I will be\n                          required to pay the full amount committed after the\n                          deal is closed.\n                          <input\n                            type=\"checkbox\"\n                            name=\"agree\"\n                            onChange={this.onChangeCheckbox}\n                          />\n                          <span className=\"checkmark\"></span>\n                        </label>\n\n                        <label\n                          className=\"container-check\"\n                          style={{ fontSize: \"10px\" }}\n                        >\n                          Convenience Fee of 2% on the investment amount at the\n                          time of investment and 2% on the sale proceeds at the\n                          time of exit is applicable.\n                        </label>\n                      </div>\n\n                      <div className=\"col-12\">\n                        {this.state.amount_error_status == true ? (\n                          <button\n                            type=\"button\"\n                            className=\"login-button text-center\"\n                            style={{\n                              border: \"1px solid #9a9a9a\",\n                              backgroundColor: \"#9a9a9a\",\n                              cursor: \"not-allowed\",\n                              padding: \"0.9em 0 \",\n                            }}\n                          >\n                            Express Your Interest\n                          </button>\n                        ) : (\n                          <InvestmentMembershipmodal\n                            processingfees={this.state.processingfees}\n                            deal_id={this.state.deal_id}\n                            membership_type={this.state.check_membership_type}\n                            invest={this.invest}\n                            amount={this.state.amount}\n                            agreecheck={this.state.agreeCheck}\n                            totalamount={this.state.totalamount}\n                            fee={this.state.legalfee}\n                            minamount={this.state.minamount}\n                            maxamount={this.state.maxamount}\n                            agree={this.state.agree}\n                            error_status={this.state.amount_error_status}\n                            investor_id={this.state.investor_id}\n                            deduct={this.state.deduct}\n                            tdsstatus={this.state.tdsstatus}\n                            gst={this.state.gst}\n                            order_token={this.state.order_token}\n                            legalfee={this.state.legalfee}\n                            walletDeductionMoney={\n                              this.state.walletDeductionMoney\n                            }\n                            user_id={this.state.investor_id}\n                            escrow_account_ifsc={this.state.escrow_account_ifsc}\n                            escrowact={this.state.escrowact}\n                            interested_id={this.state.interested_id}\n                            invest_amt={this.state.invest_amt}\n                          />\n                        )}\n                      </div>\n                    </div>\n                  </Modal>\n                  <Modal\n                    title=\"Deduct TDS\"\n                    visible={this.state.confirmmodalstatus}\n                    onOk={this.handleOk2}\n                    onCancel={this.handleCancel2}\n                    width={700}\n                    footer={false}\n                  >\n                    <div className=\"row\">\n                      <div style={{ width: \"100%\" }}>\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          TDS is applicable according to Section-194j of the\n                          income Tex act, 1961.\n                        </p>\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          Rate: 10%\n                        </p>{\" \"}\n                        <br />\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          <b>Do you want to Deduct TDS?</b>\n                        </p>\n                      </div>\n\n                      <div className=\"col-11\">\n                        <button\n                          type=\"button\"\n                          className=\"login-button bg-primary mt-4 mx-4\"\n                          onClick={() => this.invest()}\n                        >\n                          Yes\n                        </button>\n                        <input\n                          type=\"button\"\n                          value=\"No Thanks\"\n                          onClick={() => this.invest()}\n                          className=\"login-button mx-4 my-3\"\n                        ></input>\n                      </div>\n                    </div>\n                  </Modal>\n                  <div className=\"col-lg-7 deal-banner deals-video-banner liaplus \">\n                    <iframe\n                      style={{\n                        boxShadow: \"0px 0px 2rem -0.5rem rgb(0 0 0 / 40%)\",\n                        borderRadius: 3,\n                        // marginLeft: 65,\n                      }}\n                      width=\"100%\"\n                      height=\"335\"\n                      src=\"https://www.youtube.com/embed/TmBAlWCDF3Q\"\n                      title=\"Co buzz expo video\"\n                      frameborder=\"10\"\n                      allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                      allowfullscreen\n                    ></iframe>\n\n                    <iframe\n                      style={{\n                        boxShadow: \"0px 0px 2rem -0.5rem rgb(0 0 0 / 40%)\",\n                        borderRadius: 3,\n                        // marginLeft: 65,\n                      }}\n                      width=\"100%\"\n                      height=\"335\"\n                      src=\"https://www.youtube.com/embed/cRxaZJ6c0gY\"\n                      title=\"ISKILL BOX SHOWREEL HIGH RES\"\n                      frameborder=\"10\"\n                      allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                      allowfullscreen\n                    ></iframe>\n\n                    {/* {!this.state.youtube_url && (\n                      <>\n                        <img\n                          src=\"./assets/images/deals-details/LiaPlus AI/banner.jpg\"\n                          width=\"100%\"\n                          style={{ height: \"auto\" }}\n                          className=\"sectionliaplus\"\n                        />\n                      </>\n                    )} */}\n                  </div>\n                  {/* Market Overview */}\n                  <div\n                    className=\"container home-decor-section mt-0\"\n                    style={{ marginTop: \"3px !important\" }}\n                  >\n                    <h1\n                      className=\"text-center\"\n                      style={{\n                        marginBottom: \"20px\",\n                        marginTop: \"0px !important\",\n                      }}\n                    >\n                      Market Overview\n                    </h1>\n                    <div className=\"row\">\n                      <div className=\"col-lg-4\">\n                        <div className=\"single text-center h-lg market-boxes\">\n                          {/* <h2 style={{paddingBottom:\"20px\"}}>$1 Tn </h2> */}\n                          <p\n                            style={{\n                              color: \"white\",\n                              fontSize: \"21px\",\n                              padding: \"2px\",\n                              margin: \"48px 0px\",\n                              opacity: \"1\",\n                              lineHeight: \"1.5\",\n                            }}\n                          >\n                            <span\n                              style={{\n                                color: \"white\",\n                                fontSize: \"21px\",\n                                padding: \"2px\",\n                                margin: \"48px 0px\",\n                                opacity: \"1\",\n                                lineHeight: \"1.5\",\n                                fontWeight: \"800\",\n                              }}\n                            >\n                              Rapid Growth in Digital Marketing:{\" \"}\n                            </span>\n                            The global digital marketing market is projected to\n                            grow from $322.5 billion in 2020 to $640.2 billion\n                            by 2027, driven by technological advancements in AI,\n                            big data, and increasing internet penetration. In\n                            India, the market is expected to reach $55.37\n                            billion by 2032, with a CAGR of 30.2%.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-4\">\n                        <div className=\"single text-center h-lg market-boxes\">\n                          {/* <h2 style={{paddingBottom:\"20px\"}}>$200 Bn</h2> */}\n                          <p\n                            style={{\n                              color: \"white\",\n                              fontSize: \"21px\",\n                              padding: \"2px\",\n                              margin: \"48px 0px\",\n                              opacity: \"1\",\n                              lineHeight: \"1.5\",\n                            }}\n                          >\n                            <span\n                              style={{\n                                color: \"white\",\n                                fontSize: \"21px\",\n                                padding: \"2px\",\n                                margin: \"48px 0px\",\n                                opacity: \"1\",\n                                lineHeight: \"1.5\",\n                                fontWeight: \"800\",\n                              }}\n                            >\n                              Expanding Corporate Training Market:\n                            </span>{\" \"}\n                            The global corporate training market is set to\n                            increase from $332.9 billion in 2019 to $487.3\n                            billion by 2027, fueled by the demand for continuous\n                            learning, AI integration, and scalable e-learning\n                            solutions. The AI-driven e-learning market is a key\n                            growth area, with significant potential.\n                          </p>\n                        </div>\n                      </div>\n\n                      <div className=\"col-lg-4\">\n                        <div className=\"single text-center h-lg market-boxes\">\n                          {/* <h2 style={{paddingBottom:\"20px\"}}>$200 Bn</h2> */}\n                          <p\n                            style={{\n                              color: \"white\",\n                              fontSize: \"21px\",\n                              padding: \"2px\",\n                              margin: \"48px 0px\",\n                              opacity: \"1\",\n                              lineHeight: \"1.5\",\n                            }}\n                          >\n                            <span\n                              style={{\n                                color: \"white\",\n                                fontSize: \"21px\",\n                                padding: \"2px\",\n                                margin: \"48px 0px\",\n                                opacity: \"1\",\n                                lineHeight: \"1.5\",\n                                fontWeight: \"800\",\n                              }}\n                            >\n                              Technological Transformation as a Key Driver:\n                            </span>{\" \"}\n                            Both industries are being revolutionized by AI,\n                            machine learning, and immersive technologies (e.g.,\n                            VR, AR), enabling hyper-personalization, improved\n                            engagement, and more effective strategies,\n                            positioning them for sustained growth and\n                            innovation.\n                          </p>{\" \"}\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"text-center fs-4\">\n                      <span style={{ color: \"#000\" }}>Source: </span>\n                      <span style={{ color: \"rgb(127, 119, 118)\" }}>\n                        Multiple publicly available research and survey reports\n                      </span>\n                    </div>\n                    <p className=\"\"> </p>\n                    <div className=\"text-center fluid-container\"></div>\n                  </div>\n                  <div\n                    className=\"container highlight-section\"\n                    style={{\n                      marginBottom: \"-80px !important\",\n                      padding: \"0px !important\",\n                    }}\n                  >\n                    <h1 style={{ fontSize: \"2rem\", marginBottom: \"30px\" }}>\n                      Highlights\n                    </h1>\n\n                    <div className=\"row highlight-rows\">\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single  mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/Petmojo/highlight4.jpg\" />\n                          </div>\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            Innoserv’s advanced use of AI for personalized,\n                            data-driven services in branding, digital marketing,\n                            and corporate training sets gave them revenue of\n                            13.4 Cr. In FY 2023-24\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/Petmojo/highlight01.jpg\" />\n                          </div>\n                          <p style={{ padding: \"1px !important\" }}>\n                            The company provides a full range of services under\n                            one roof, allowing for cohesive and integrated\n                            strategies tailored to client needs.\n                          </p>{\" \"}\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/highlight2.jfif\" />\n                          </div>\n                          <p style={{ padding: \"0px !important\" }}>\n                            Innoserv's dedication to building long-term\n                            partnerships and delivering exceptional service\n                            fosters high client retention and loyalty.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/highlight3.jpg\" />\n                          </div>\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            Continuous investment in research and development\n                            ensures that innoserv remains at the forefront of\n                            industry trends and technologies.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/highlight3.jpg\" />\n                          </div>\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            InnoServ has over 200 global clients with a high\n                            retention rate of 85%, showcasing effective client\n                            management and satisfaction.{\" \"}\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/highlight3.jpg\" />\n                          </div>\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                            InnoServ offers investors a 12% annual return\n                            through a Compulsory Convertible Debenture (CCD)\n                            with monthly payments, plus 50% of the investment\n                            value in bonus shares at maturity over 3 years.{\" \"}\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* media */}\n                </div>\n              </div>\n              <section\n                className=\"deals-details-page\"\n                style={{ marginBottom: \"-50px\", marginTop: \"40px \" }}\n              >\n                <div>\n                  <div>\n                    {/* media */}\n\n                    {/* <div\n                      className=\"container highlight-section\"\n                      style={{\n                        marginBottom: \"-80px !important\",\n                        padding: \"0px !important\",\n                      }}\n                    >\n                      <h1 style={{ fontSize: \"2rem\", marginBottom: \"30px\" }}>\n                        Media Coverage\n                      </h1>\n                      <div className=\"row\">\n                        <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                          <div className=\"single medialink text-left d-flex flex-column  \">\n                            <img src=\"./assets/images/deals-details/Mindler/Articles/1.jpg\" />\n\n                            <p style={{ padding: \"1px !important\" }}>\n                            THIS PLATFORM PROVIDES A ONE-STOP SOLUTION TO EVERY STUDENT’S CAREER GUIDANCE NEEDS\n                              <a\n                                href=\"https://yourstory.com/weekender/this-platform-provides-a-one-stop-solution-to-career-guidance-mindler\"\n                                target=\"_blank\"\n                              >\n                                {\" \"}\n                                Readmore\n                              </a>\n                            </p>\n                          </div>\n                        </div>\n\n                        <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                          <div className=\"single medialink text-left d-flex flex-column  \">\n                            <img src=\"./assets/images/deals-details/Mindler/Articles/2.jpg\" />\n                            <p style={{ padding: \"1px !important\" }}>\n                            Mindler: The platform ‘minds’ your career\n                              <a\n                                href=\"https://economictimes.indiatimes.com/small-biz/startups/mindler-the-platform-minds-your-career/articleshow/54473145.cms?from=mdr\"\n                                target=\"_blank\"\n                              >\n                                {\" \"}\n                                Readmore\n                              </a>\n                            </p>\n                          </div>\n                        </div>\n                        <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                          <div className=\"single medialink text-left d-flex flex-column  \">\n                            <img src=\"./assets/images/deals-details/Mindler/Articles/3.jpg\" />\n                            <p style={{ padding: \"1px !important\" }}>\n                            Comprehensive Analysis of the Career Guidance Landscape in India\n\n                              <a    \n                                href =\"https://www.edtechreview.in/research/comprehensive-analysis-career-guidance-landscape-in-india/\"\n                                target=\"_blank\"\n                              >\n                                Readmore\n                              </a>\n                            </p>\n                          </div>\n                        </div>\n\n                      </div>\n                    </div> */}\n                  </div>\n                </div>\n              </section>\n            </section>\n            <div className=\"deals-page\">\n              <div className=\"tab-wrapper\">\n                <div className=\"container\">\n                  <div className=\"row\">\n                    <div\n                      className=\"col-lg-12 col-md-12 col-sm-12\"\n                      style={{\n                        marginTop: 110,\n                      }}\n                    >\n                      <div className=\"deal-terms-section\">\n                        {/* Investor Presentation */}\n                        <div\n                          className=\"\"\n                          style={{\n                            backgroundColor: \"white\",\n                            marginTop: \"1px !important\",\n                          }}\n                        >\n                          <h1\n                            style={{\n                              fontSize: 32,\n                              marginBottom: 30,\n                              textAlign: \"center\",\n                              marginTop: \"-10px !important\",\n                            }}\n                          >\n                            Investor Presentation\n                          </h1>\n                          <Slider {...settings} className=\"mb-5 pitch-slider\">\n                            {images.map((image, index) => (\n                              <img\n                                key={index}\n                                src={image}\n                                onClick={() => this.handleClickImage(image)}\n                              />\n                            ))}\n                          </Slider>\n                          {current && (\n                            <Lightbox\n                              mainSrc={current}\n                              onCloseRequest={this.handleCloseModal}\n                            />\n                          )}\n                        </div>\n                      </div>\n                      <div className=\"deal-terms-section\">\n                        {/* Investor Presentation */}\n                        <div\n                          className=\"\"\n                          style={{\n                            backgroundColor: \"white\",\n                            marginTop: \"1px !important\",\n                          }}\n                        >\n                          <h1\n                            style={{\n                              fontSize: 32,\n                              marginBottom: 30,\n                              textAlign: \"center\",\n                              marginTop: \"-10px !important\",\n                            }}\n                          >\n                            Investor Presentation\n                          </h1>\n                          <Slider {...settings} className=\"mb-5 pitch-slider\">\n                            {images2.map((image1, index) => (\n                              <img\n                                key={index}\n                                src={image1}\n                                onClick={() => this.handleClickImage2(image1)}\n                              />\n                            ))}\n                          </Slider>\n                          {current2 && (\n                            <Lightbox\n                              mainSrc={current2}\n                              onCloseRequest={this.handleCloseModal}\n                            />\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"deals-page\">\n              <div className=\"tab-wrapper\">\n                <div className=\"container\">\n                  <div className=\"row\">\n                    <div\n                      className=\"col-lg-12 col-md-12 col-sm-12\"\n                      style={{\n                        marginTop: 110,\n                      }}\n                    >\n                      <Tabs\n                        defaultActiveKey=\"1\"\n                        centered\n                        style={{ marginBottom: \"30px !important\" }}\n                      >\n                        <TabPane tab=\"Details\" key=\"2\">\n                          <div className=\"deal-terms-section\">\n                            <div\n                              className=\"container\"\n                              style={{ marginTop: \"1px !important\" }}\n                            >\n                              <div className=\"row\">\n                                <div className=\"col-lg-10 m-auto\">\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"-30px !important\",\n                                      marginTop: \"30px\",\n                                    }}\n                                  >\n                                    Deal Terms\n                                  </h1>\n                                  <div\n                                    className=\"\"\n                                    style={{ marginTop: \"0px !important\" }}\n                                  >\n                                    <div className=\"container\">\n                                      <div className=\"row\">\n                                        <div className=\"col-lg-12\">\n                                          <div className=\"info\">\n                                            <span>End Date</span>\n                                            <h4\n                                              style={{\n                                                textTransform: \"Capitalize\",\n                                              }}\n                                            >\n                                              {this.state.deal_regular_end_date\n                                                ? moment(\n                                                    this.state\n                                                      .deal_regular_end_date\n                                                  ).format(\"MMM DD, YYYY\")\n                                                : \"\"}\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span> Min Investment</span>\n                                            <h4>\n                                              ₹{\" \"}\n                                              {this.formatNumberWithCommas(\n                                                this.state.minamount\n                                              )}{\" \"}\n                                              for {this.state.deal_service}\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Valuation</span>\n                                            <h4>51 Cr. Pre Money</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Interest on CCD</span>\n                                            <h4>\n                                              12% per annum, paid monthly and\n                                              conversion to equity with 50%\n                                              bonus share after three years\n                                            </h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"0px\",\n                                      marginTop: \"20px\",\n                                    }}\n                                  >\n                                    Company Details\n                                  </h1>\n                                  <section\n                                    className=\"deal-about-artment-section\"\n                                    style={{ marginTop: \"50px\" }}\n                                  >\n                                    <div className=\"container\">\n                                      <div className=\"row\">\n                                        <div className=\"col-lg-12\">\n                                          <div className=\"info\">\n                                            <span>Legal Name</span>\n                                            <h4>\n                                              Innoserv Solutions Pvt. Ltd.\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Founded</span>\n                                            <h4>4/3/2013</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Status</span>\n                                            <h4>Private Limited Company</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Employees</span>\n                                            <h4>86</h4>\n                                          </div>\n                                          {/* <div className=\"info\">\n                                            <span>Website</span>\n                                            <h4>\n                                              <a\n                                                style={{\n                                                  color: \"rgb(7, 211, 252)\",\n                                                }}\n                                                href=\"https://edept.co/\"\n                                                target=\"_blank\"\n                                              >\n                                                edept.co\n                                              </a>\n                                            </h4>\n                                          </div> */}\n                                          <div className=\"info\">\n                                            <span>Social Links</span>\n                                            <div className=\"social-icons\">\n                                              <a href=\"https://www.facebook.com/share/gZMnLfVh7y1DZwjB/?mibextid=qi2Omg\">\n                                                <i className=\"bx bxl-facebook fs-19\"></i>\n                                              </a>\n                                              <a href=\"https://www.linkedin.com/company/aiqbq/\">\n                                                <i className=\"bx bxl-linkedin fs-19\"></i>\n                                              </a>\n                                              <a href=\"https://www.instagram.com/aiq_brandquotient?igsh=emhnajhjbXB3M3ly\">\n                                                <i className=\"bx bxl-instagram fs-19\"></i>\n                                              </a>\n\n                                              {/* <a href=\"https://www.youtube.com/channel/UCO1UvNI1Tg3Ese7YZ_Gc2gA\">\n                                                <i className=\"bx bxl-youtube fs-19\"></i>\n                                              </a> */}\n                                            </div>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Address</span>\n                                            <h4>\n                                              A-24, Harileela Society, Balewadi\n                                              Phata, Baner Road, Pune{\" \"}\n                                            </h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </section>\n                                </div>\n                              </div>\n                            </div>\n\n                            {/* Investor Presentation */}\n                          </div>\n                          {/* start */}\n\n                          <div\n                            className=\"deals-page\"\n                            style={{\n                              marginTop: \"50px !important\",\n                            }}\n                          >\n                            <div className=\"deal-terms-section\">\n                              <div\n                                className=\"container\"\n                                style={{ marginTop: \"1px !important\" }}\n                              >\n                                <div className=\"row\">\n                                  <div className=\"col-lg-10 m-auto\">\n                                    <h1>Documents</h1>\n                                    <div className=\"row document-section\">\n                                      <div className=\"col-lg-2\"></div>\n                                      <div className=\"col-lg-8\">\n                                        <div\n                                          className=\"download-section\"\n                                          style={{\n                                            backgroundColor: \"white\",\n                                            padding: \"4rem 19px\",\n                                          }}\n                                        >\n                                          <>\n                                            <div>\n                                              <table\n                                                className=\"download-document-table\"\n                                                style={{ width: \"100%\" }}\n                                              >\n                                                <tr\n                                                  style={{\n                                                    background: \"#29176f\",\n                                                    color: \"#fff\",\n                                                  }}\n                                                >\n                                                  <th>Sr no</th>\n                                                  <th>Document</th>\n                                                  <th>Type</th>\n                                                  <th>Download</th>\n                                                </tr>\n                                                {this.state.documents.length >\n                                                  0 &&\n                                                  this.state.documents.map(\n                                                    (item, index) => {\n                                                      // console.log(\n                                                      //   this.state.documents\n                                                      //     .length\n                                                      // );\n                                                      let documentlink = `${process.env.REACT_APP_BASE_URL}api/uploads/docs/${item.documentid}/${item.document}`;\n                                                      return (\n                                                        <tr\n                                                          key={index}\n                                                          style={{ height: 70 }}\n                                                        >\n                                                          {/* <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {item.paid ==\n                                                            \"Paid\" && (\n                                                            <>\n                                                              {this.state\n                                                                .check_membership_type ==\n                                                                \"premium\" &&\n                                                              item.premium_price !=\n                                                                \"0\" &&\n                                                              item.premium_price !=\n                                                                \"\" ? (\n                                                                <>\n                                                                  {item.user_paid ==\n                                                                  false ? (\n                                                                    <Checkbox\n                                                                      onChange={() =>\n                                                                        this.show_selected_checkbox(\n                                                                          item\n                                                                        )\n                                                                      }\n                                                                      value={\n                                                                        item.selected\n                                                                      }\n                                                                    ></Checkbox>\n                                                                  ) : (\n                                                                    <>\n                                                                      {item.user_paid ==\n                                                                        true && (\n                                                                        <img\n                                                                          src=\"./paid.png\"\n                                                                          style={{\n                                                                            maxWidth: 20,\n                                                                          }}\n                                                                        />\n                                                                      )}\n                                                                    </>\n                                                                  )}\n                                                                </>\n                                                              ) : (\n                                                                <>\n                                                                  {this.state\n                                                                    .check_membership_type ==\n                                                                    \"regular\" &&\n                                                                    item.regular_price !=\n                                                                      \"0\" &&\n                                                                    item.regular_price !=\n                                                                      \"\" &&\n                                                                    item.user_paid ==\n                                                                      false && (\n                                                                      <Checkbox\n                                                                        onChange={() =>\n                                                                          this.show_selected_checkbox(\n                                                                            item\n                                                                          )\n                                                                        }\n                                                                        value={\n                                                                          item.selected\n                                                                        }\n                                                                      ></Checkbox>\n                                                                    )}\n                                                                </>\n                                                              )}\n                                                            </>\n                                                          )}\n                                                        </td> */}\n                                                          <td\n                                                            style={{\n                                                              width: 40,\n                                                            }}\n                                                          >\n                                                            {index + 1}\n                                                          </td>\n                                                          <td\n                                                            style={{\n                                                              width: 140,\n                                                            }}\n                                                          >\n                                                            {item.docname}\n                                                          </td>\n                                                          <td\n                                                            style={{\n                                                              width: 40,\n                                                            }}\n                                                          >\n                                                            {item.paid == \"Paid\"\n                                                              ? this.state\n                                                                  .check_membership_type ==\n                                                                \"premium\"\n                                                                ? item.premium_price ==\n                                                                  \"0\"\n                                                                  ? \"Free\"\n                                                                  : \"₹\" +\n                                                                    item.premium_price\n                                                                : item.regular_price ==\n                                                                  \"0\"\n                                                                ? \"Free\"\n                                                                : \"₹\" +\n                                                                  item.regular_price\n                                                              : \"Free\"}\n                                                          </td>\n                                                          <td\n                                                            style={{\n                                                              width: 50,\n                                                            }}\n                                                          >\n                                                            {this.state\n                                                              .investor_id && (\n                                                              <center>\n                                                                {(item.user_paid ==\n                                                                  true ||\n                                                                  item.paid ==\n                                                                    \"Free\") && (\n                                                                  <a\n                                                                    href={\n                                                                      documentlink\n                                                                    }\n                                                                    target=\"_blank\"\n                                                                    style={{\n                                                                      width: 80,\n                                                                    }}\n                                                                  >\n                                                                    <img\n                                                                      src=\"./download.ico\"\n                                                                      style={{\n                                                                        maxWidth: 50,\n                                                                      }}\n                                                                    />\n                                                                  </a>\n                                                                )}\n                                                                {item.paid ==\n                                                                  \"Paid\" &&\n                                                                  this.state\n                                                                    .check_membership_type ==\n                                                                    \"premium\" &&\n                                                                  (item.premium_price ==\n                                                                  \"0\" ? (\n                                                                    <a\n                                                                      href={\n                                                                        documentlink\n                                                                      }\n                                                                      target=\"_blank\"\n                                                                      style={{\n                                                                        width: 80,\n                                                                      }}\n                                                                    >\n                                                                      <img\n                                                                        src=\"./download.ico\"\n                                                                        style={{\n                                                                          maxWidth: 50,\n                                                                        }}\n                                                                      />\n                                                                    </a>\n                                                                  ) : (\n                                                                    \"\"\n                                                                  ))}\n                                                              </center>\n                                                            )}\n                                                          </td>\n                                                        </tr>\n                                                      );\n                                                    }\n                                                  )}\n                                              </table>\n                                            </div>\n                                          </>\n                                          {this.state.button_status ==\n                                            false && (\n                                            <button\n                                              className=\"download-button\"\n                                              onClick={() => this.documentPay()}\n                                            >\n                                              Pay\n                                            </button>\n                                          )}\n                                          {!this.state.investor_id && (\n                                            <>\n                                              <button\n                                                className=\"download-button\"\n                                                style={{\n                                                  background: \"rgb(41 23 111)\",\n                                                }}\n                                                onClick={() =>\n                                                  window.location.assign(\n                                                    \"/login\"\n                                                  )\n                                                }\n                                              >\n                                                Login to View\n                                              </button>\n                                              {/* <em\n                                            style={{\n                                              fontSize: 14,\n                                              fontWeight: \"700\",\n                                            }}\n                                          >\n                                            Become Growth91\n                                            <sup style={{ fontSize: \"0.6rem\" }}>\n                                              TM\n                                            </sup>{\" \"}\n                                            member to access the document{\" \"}\n                                          </em> */}\n                                            </>\n                                          )}\n                                        </div>\n                                      </div>\n                                      <div className=\"col-lg-2\"></div>\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                            <div className=\"tab-wrapper\">\n                              <div className=\"container\">\n                                <div className=\"row\">\n                                  <div className=\"col-lg-12\">\n                                    <Tabs defaultActiveKey=\"1\" centered>\n                                      <TabPane tab=\"FAQ\" key=\"1\">\n                                        <section\n                                          className=\"faq-section\"\n                                          style={{\n                                            margin: \"0px\",\n                                            padding: \"0px\",\n                                            background: \"none\",\n                                          }}\n                                        >\n                                          <div className=\"\">\n                                            <div className=\"row\">\n                                              <div className=\"col-lg-12 col-md-12 col-sm-12 m-auto\">\n                                                <h1 className=\"text-center mb-4\">\n                                                  About {this.state.deal_name}\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['1']}\n                                                  onChange={this.callback1}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"Are you focused on product or service?\"\n                                                    key=\"1\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                          textAlign: \"justify\",\n                                                        }}\n                                                      >\n                                                        Innoserv is primarily\n                                                        focused on delivering\n                                                        services rather than\n                                                        physical products. The\n                                                        company’s core offerings\n                                                        revolve around AI-driven\n                                                        branding, digital\n                                                        marketing, and corporate\n                                                        training solutions.\n                                                        These services include\n                                                        personalized branding\n                                                        strategies, digital\n                                                        marketing campaigns,\n                                                        corporate training\n                                                        programs, and AI-enabled\n                                                        learning platforms.\n                                                        innoserv’s approach\n                                                        emphasizes the\n                                                        integrating\n                                                        technologoes,\n                                                        particularly AI, with\n                                                        human creativity to\n                                                        provide customized and\n                                                        impactful services that\n                                                        address specific client\n                                                        needs. By focusing on\n                                                        service, the company\n                                                        delivers tailored\n                                                        solutions that help\n                                                        businesses grow, improve\n                                                        their brand presence,\n                                                        and enhance their\n                                                        workforce capabilities\n                                                        While innoserv may\n                                                        develop digital assets\n                                                        or learning modules as\n                                                        part of its service\n                                                        offerings, the primary\n                                                        emphasis is on providing\n                                                        comprehensive,\n                                                        technology-enhanced\n                                                        services that drive\n                                                        clients' success.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What are the challenges for scale up and how these will be managed?\"\n                                                    key=\"2\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                          textAlign: \"justify\",\n                                                        }}\n                                                      >\n                                                        Scaling up presents\n                                                        challenges, but innoserv\n                                                        has strategies in place\n                                                        to manage them\n                                                        effectively. To maintain\n                                                        service quality, the\n                                                        company plans to invest\n                                                        in team training,\n                                                        automate routine tasks,\n                                                        and use AI tools for\n                                                        consistency and\n                                                        efficiency. Resource\n                                                        allocation will be\n                                                        carefully managed by\n                                                        hiring the right talent,\n                                                        investing in scalable\n                                                        technologies, and\n                                                        forming strategic\n                                                        partnerships. innoserv\n                                                        will ensure client and\n                                                        market diversification\n                                                        aligns with core\n                                                        competencies through\n                                                        thorough market research\n                                                        and gradual expansion.\n                                                        Operational efficiency\n                                                        will be maintained by\n                                                        continuously refining\n                                                        processes and leveraging\n                                                        technology. To preserve\n                                                        organizational culture\n                                                        during growth, innoserv\n                                                        will reinforce company\n                                                        values, maintain clear\n                                                        communication, and\n                                                        engage employees\n                                                        regularly. Financial\n                                                        health will be managed\n                                                        through strong working\n                                                        capital management,\n                                                        strategic financing, and\n                                                        careful monitoring of\n                                                        financial metrics. By\n                                                        addressing these\n                                                        challenges with\n                                                        proactive strategies,\n                                                        innoserv is confident in\n                                                        its ability to scale\n                                                        effectively and\n                                                        sustainably.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"Are you targeting new untapped market? Justify\"\n                                                    key=\"7\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                          textAlign: \"justify\",\n                                                        }}\n                                                      >\n                                                        Yes, InnoServ Group is\n                                                        targeting new, untapped\n                                                        markets through its\n                                                        innovative AI-driven\n                                                        solutions in branding,\n                                                        digital marketing, and\n                                                        corporate training. By\n                                                        integrating AI with\n                                                        human creativity,\n                                                        InnoServ addresses the\n                                                        increasing demand for\n                                                        personalized,\n                                                        data-driven strategies\n                                                        that go beyond\n                                                        traditional methods,\n                                                        appealing to businesses\n                                                        looking to stay\n                                                        competitive in the\n                                                        digital age. In the\n                                                        corporate training\n                                                        sector, InnoServ's\n                                                        subsidiary, iSkillBox,\n                                                        offers a unique\n                                                        AI-enabled B2B2C blended\n                                                        learning platform. This\n                                                        platform targets the\n                                                        skills gap in the\n                                                        workforce by providing\n                                                        personalized training\n                                                        solutions, tapping into\n                                                        a market that is\n                                                        underserved by\n                                                        conventional training\n                                                        approaches. Furthermore,\n                                                        InnoServ's strategic\n                                                        focus on AI-based\n                                                        learning platforms and\n                                                        plans for international\n                                                        expansion in the digital\n                                                        and skilling sectors\n                                                        allow them to enter\n                                                        emerging markets where\n                                                        advanced,\n                                                        technology-driven\n                                                        services are not yet\n                                                        widely available. This\n                                                        positions InnoServ as a\n                                                        leader in markets that\n                                                        are poised for\n                                                        significant growth,\n                                                        particularly in regions\n                                                        with a growing need for\n                                                        sophisticated digital\n                                                        and learning solutions.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What are your moats?\"\n                                                    key=\"4\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                          textAlign: \"justify\",\n                                                        }}\n                                                      >\n                                                        Innoserv maintains a\n                                                        strong market position\n                                                        through its AI-driven\n                                                        solutions, offering\n                                                        personalized,\n                                                        data-driven services in\n                                                        branding, digital\n                                                        marketing, and corporate\n                                                        training that set it\n                                                        apart from competitors.\n                                                        By providing a\n                                                        comprehensive range of\n                                                        services under one roof,\n                                                        innoserv delivers\n                                                        cohesive strategies\n                                                        tailored to client\n                                                        needs. The company’s\n                                                        strong client\n                                                        relationships, rooted in\n                                                        exceptional service and\n                                                        long-term partnerships,\n                                                        ensure high retention\n                                                        and loyalty. Led by an\n                                                        experienced team of\n                                                        industry veterans,\n                                                        innoserv leverages\n                                                        strategic insights to\n                                                        navigate market\n                                                        challenges. Continuous\n                                                        innovation and\n                                                        adaptability keep the\n                                                        company at the forefront\n                                                        of industry trends,\n                                                        while its reputation for\n                                                        delivering high-quality\n                                                        services further\n                                                        solidifies its market\n                                                        credibility and success.\n                                                      </p>{\" \"}\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                                <h1 className=\"text-center mb-2 mt-4\">\n                                                  Growth91 Investment FAQ\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['10']}\n                                                  onChange={this.callback3}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"What is the due diligence process followed by Growth91\"\n                                                    key=\"11\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      At Growth91, we follow\n                                                      stringent due-diligence\n                                                      process. We ask for\n                                                      detailed information about\n                                                      start-up and their team.\n                                                      After the scrutiny and if\n                                                      deemed fit, start-up would\n                                                      be listed on Growth91\n                                                      platform. Independent\n                                                      investment opinion and\n                                                      due-diligence report\n                                                      prepared by external\n                                                      qualified experts are made\n                                                      available for investors.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"Do you offer any guarantee on returns?\"\n                                                    key=\"12\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      No, we do not guarantee\n                                                      any returns. The startup\n                                                      which is raising the money\n                                                      is also not guaranteeing\n                                                      any specific returns. In\n                                                      principle, it is not\n                                                      legally correct for the\n                                                      company to provide any\n                                                      guarantee about returns on\n                                                      equity linked securities.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the refund process in case I don’t receive any allocation?\"\n                                                    key=\"13\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      If an investor doesn’t\n                                                      receive the allocation,\n                                                      the investment amount will\n                                                      be refunded to the bank\n                                                      account from which the\n                                                      investment has been made.\n                                                      As per Growth91 policy,\n                                                      there will be no interest\n                                                      or compensation on these\n                                                      returned funds.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the exit mechanism available for the investors\"\n                                                    key=\"14\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      The Company and the\n                                                      Promoters shall make all\n                                                      reasonable endeavours to\n                                                      provide exit to the\n                                                      Investors by any of the\n                                                      following ways: 1. Initial\n                                                      Public Offer (IPO) 2.\n                                                      Merger or Acquisition\n                                                      Event 3. Buyout Event 3.\n                                                      Compulsory Call Option\n                                                      with minimum assured\n                                                      returns. (Please refer to\n                                                      investor agreement for\n                                                      more details)\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"In which account Investor’s money are transferred\"\n                                                    key=\"15\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      Money invested by the\n                                                      investor in all public\n                                                      deals are automatically\n                                                      transferred to separate\n                                                      and dedicated escrow\n                                                      account created for\n                                                      respective Startup. The\n                                                      escrow account is managed\n                                                      by authorized trustee.\n                                                      After the funding/deal and\n                                                      documentation formalities\n                                                      are completed, the fund\n                                                      will be transferred to\n                                                      respective startup bank\n                                                      account.\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"I have more questions; how do I contact Growth91?\"\n                                                    key=\"16\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      You can always send your\n                                                      queries to{\" \"}\n                                                      <a href=\"mailto:contact@growth91.com\">\n                                                        contact@growth91.com\n                                                      </a>\n                                                      , we will respond to your\n                                                      queries in shortest\n                                                      possible time.\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                              </div>\n                                            </div>\n                                          </div>\n                                        </section>\n                                      </TabPane>\n                                    </Tabs>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          {/* stop */}\n                        </TabPane>\n                        <TabPane tab=\"Team\" key=\"3\">\n                          <div\n                            className=\"container meet-the-team-section\"\n                            style={{ maxWidth: 921 }}\n                          >\n                            <h2 className=\"text-center\">Meet the Team</h2>\n                            <div className=\"row elefantteam\">\n                              <div className=\"col-lg-6\">\n                                <div\n                                  className=\"single\"\n                                  style={{ paddingBottom: \"0px !important\" }}\n                                  // style={{  marginBottom: 0px !important}}\n                                >\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Innoserv/Ritesh image.jpeg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Ritesh D</h3>\n                                      <span>Co-Founder & CEO</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/ritesh-d-15b7a215/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                        {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                        <i className=\"bx bxl-gmail\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <ul>\n                                    <li>\n                                      <a>\n                                        As the CEO, Ritesh D is responsible for\n                                        the overall strategic direction and\n                                        leadership of the company. He focuses on\n                                        driving growth, making high-level\n                                        decisions, and overseeing the execution\n                                        of the company's vision. Ritesh also\n                                        plays a key role in building\n                                        relationships with clients, investors,\n                                        and partners.\n                                      </a>\n                                    </li>\n                                  </ul>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div\n                                  className=\"single\"\n                                  style={{ paddingBottom: \"0px !important\" }}\n                                  // style={{  marginBottom: 0px !important}}\n                                >\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Innoserv/Nimil page.jpeg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Nimil Tiwari</h3>\n                                      <span> Co-Founder & CSO</span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/nimil-tiwari-13677318/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                        {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                        <i className=\"bx bxl-gmail\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <ul>\n                                    <li>\n                                      <a>\n                                        Nimil Tiwari, as the Chief Strategy\n                                        Officer, is responsible for formulating\n                                        and implementing the company’s strategic\n                                        initiatives. He works closely with the\n                                        CEO to align the company's goals with\n                                        market opportunities and oversees\n                                        business development, ensuring that the\n                                        company’s services meet the evolving\n                                        needs of the market.\n                                      </a>\n                                    </li>\n                                  </ul>\n                                </div>\n                              </div>\n\n                              <div className=\"col-lg-6\">\n                                <div\n                                  className=\"single\"\n                                  style={{ paddingBottom: \"0px !important\" }}\n                                  // style={{  marginBottom: 0px !important}}\n                                >\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Innoserv/Rahul image.jpeg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Rahul Jain</h3>\n                                      <span>Managing Director </span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/jainrahul2211/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                        {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                        <i className=\"bx bxl-gmail\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <ul>\n                                    <li>\n                                      <a>\n                                        Rahul Jain, as the Managing Director, is\n                                        responsible for overseeing the company’s\n                                        financial performance, operational\n                                        efficiency, and overall business health.\n                                        He ensures that the company’s strategic\n                                        goals are met and plays a critical role\n                                        in decision-making and policy\n                                        formulation.\n                                      </a>\n                                    </li>\n                                  </ul>\n                                </div>\n                              </div>\n\n                              {/* \n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/IndusUno/team/Kushal Gupta.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Kushal Gupta</h3>\n                                      <span>\n                                        Head Engineering and Technology\n                                      </span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/logical-kushal-gupta/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    M.Tech (Computer Science)\n                                    <br />\n                                    10+ Years Experience\n                                  </p>\n                                </div>\n                              </div> */}\n                            </div>\n                          </div>\n                        </TabPane>\n                      </Tabs>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <NewWebFooter />\n          </div>\n        ) : (\n          window.location.assign(\"/Deals\")\n        )}\n      </>\n    );\n  }\n}\n\nexport default Innoserv;\n","/home/akc01/Desktop/projects/Growth91/apps/client/src/app/deal-pages/Petmojo(Pre Series A).jsx",["9126","9127","9128","9129","9130","9131","9132","9133","9134","9135","9136","9137","9138","9139","9140","9141","9142","9143","9144","9145","9146","9147","9148","9149","9150","9151","9152","9153","9154","9155","9156","9157","9158","9159","9160","9161","9162","9163","9164","9165","9166","9167","9168","9169","9170","9171","9172","9173","9174","9175","9176","9177","9178","9179","9180","9181","9182","9183","9184","9185","9186","9187","9188","9189","9190","9191","9192","9193","9194","9195","9196","9197","9198","9199","9200","9201","9202","9203","9204","9205","9206","9207","9208","9209","9210","9211","9212","9213","9214","9215","9216","9217","9218","9219","9220","9221","9222","9223","9224","9225","9226","9227","9228","9229","9230","9231","9232","9233","9234","9235","9236","9237","9238","9239","9240","9241","9242","9243"],[],"import React, { Component } from \"react\";\nimport WebHeader from \"../common/WebHeader\";\nimport WebFooter from \"../common/WebFooter\";\nimport \"./newboo.css\";\nimport {\n  Tabs,\n  Collapse,\n  message,\n  Modal,\n  Spin,\n  Checkbox,\n  Progress,\n  Alert,\n} from \"antd\";\nimport axios from \"axios\";\nimport { ExclamationCircleOutlined, PlusOutlined } from \"@ant-design/icons\";\nimport Slider from \"react-slick\";\nimport Lightbox from \"react-image-lightbox\";\nimport Apis from \"../constants/Apis\";\nimport moment from \"moment\";\nimport Bridge from \"../constants/Bridge\";\nimport InvestmentMembershipmodal from \"../components/membership/InvestmentMembershipmodal\";\nimport NewWebHeader from \"../common/NewWebHeader\";\nimport { NewWebFooter } from \"../common/NewWebFooter\";\n\nconst { Panel } = Collapse;\nconst { TabPane } = Tabs;\nclass Petmojo extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      deal_id: \"\",\n      investor_id: \"\",\n      interested_id: \"\",\n      deal_name: \"\",\n      created_at: \"\",\n      deal_description: \"\",\n      isPrivate: false,\n      isFunded: false,\n      isBlank: false,\n      tags: [],\n      logo: \"\",\n      youtube_url: \"\",\n      dealenddays: 0,\n      kycstatus: false,\n      bankstatus: false,\n      commaAmount: 0,\n      amount: 0,\n      minamount: 0,\n      captable_threshold_amount: 0,\n      maxamount: 0,\n      captable_multiple_amount: 0,\n      investmentmodal: false,\n      confirmmodalstatus: false,\n      deduct: false,\n      agree: \"\",\n      isInvested: false,\n      name: \"\",\n      email: \"\",\n      mobile: \"\",\n      conveniencefees: 100,\n      gst: 0,\n      amountplusgst: 0,\n      processingfees: 0.0,\n      totalamount: 0.0,\n      tdsstatus: false,\n      legalfee: 0.0,\n      legalplusprocessing: 0.0,\n      label: \"\",\n      percentage: 0,\n      check_membership_type: \"\",\n      tdsdeductedamount: 0,\n      order_token: \"\",\n      pdffile: \"\",\n      pitch_files: \"\",\n      pitch_list: [],\n      walletMoney: 0,\n      gstValue: 0,\n      walletDeductionMoney: 0,\n      checkWallet: false,\n      percentage_raised: 0,\n      documents: [],\n      button_status: true,\n      show_data: \"none\",\n      button_show_status: true,\n      amount_error: \"\",\n      amount_error_status: false,\n      multiples_of: 0,\n      founder_is_investor: 0,\n      user_type: \"\",\n      coming_soon_days: \"\",\n      deal_regular_end_date: \"\",\n      is_deal_visible: true,\n      deal_regular_end_date_status: 0,\n      invest_amt: \"\",\n      escrowact: \"\",\n      escrow_account_ifsc: \"\",\n      agreeCheck: false,\n      Convenience: \"\",\n      deal_service: \"\",\n      images: [\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-0.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-1.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-2.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-3.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-4.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-5.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-6.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-7.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-8.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-9.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-10.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-11.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-12.jpg\",\n        \"./assets/images/deals-details/Petmojo A/Pitch/PETMOJO_PITCHDECK_13082024-images-13.jpg\",\n      ],\n      current: \"\",\n    };\n  }\n  callback1 = (key) => {};\n  callback2 = (key) => {};\n  callback3 = (key) => {};\n\n  componentWillMount() {\n    document.title = \"Petmojo - Growth91 - Startup Marketplace \";\n  }\n  componentDidMount() {\n    let deal_id = \"37\";\n    this.setState({ deal_id: deal_id }, () => {\n      this.get_pitch_list();\n    });\n\n    if (\n      localStorage.getItem(\"investor_id\") ||\n      localStorage.getItem(\"founder_id\")\n    ) {\n      if (localStorage.getItem(\"investor_id\")) {\n        let investor_id = localStorage.getItem(\"investor_id\");\n        this.setState(\n          { investor_id: investor_id, user_type: \"investor\" },\n          () => {\n            this.getstatusdata();\n            this.getinvestmentdetails();\n            this.check_for_membership_type();\n            this.getwallethistory();\n            this.get_invest_amt();\n          }\n        );\n      } else if (localStorage.getItem(\"founder_id\")) {\n        this.get_founder_details();\n        this.setState({ user_type: \"founder\" });\n      }\n    } else {\n      this.getDeals();\n    }\n    this.getordertoken();\n    this.getGst();\n    this.get_deal_doucments(deal_id);\n    // console.log(\"hello\");\n  }\n  get_founder_details = () => {\n    let params = {\n      founder_id: localStorage.getItem(\"founder_id\"),\n    };\n    Bridge.founder.get_founder_profile_details(params).then((result) => {\n      if (result.status == \"1\") {\n        if (result.data.length > 0) {\n          let investor_id = localStorage.getItem(\"founder_id\");\n          this.setState({ investor_id: investor_id }, () =>\n            this.getwallethistory()\n          );\n          setTimeout(() => {\n            if (result.data[0].is_investor == \"1\") {\n              this.getstatusdata();\n              this.getinvestmentdetails();\n              this.check_for_membership_type();\n              this.setState({ founder_is_investor: \"1\" });\n            } else {\n              this.check_for_membership_type();\n              this.setState({ founder_is_investor: \"0\" });\n            }\n          }, 200);\n        }\n      } else {\n        this.setState({ formloader: false });\n      }\n    });\n  };\n  get_deal_doucments = (deal_id) => {\n    let params = {\n      deal_id: deal_id,\n    };\n    Bridge.get_deal_doucments(params).then((result) => {\n      if (result.status == \"1\") {\n        let arr = [];\n        for (let item of result.data) {\n          item.selected = false;\n          arr = [...arr, item];\n        }\n        this.setState({ documents: arr }, () =>\n          this.get_document_purchased_list()\n        );\n      }\n    });\n  };\n  show_selected_checkbox = (single) => {\n    let arr = [];\n    let docuemnts = this.state.documents;\n    for (let item of docuemnts) {\n      if (item.documentid == single.documentid) {\n        item.selected = item.selected == true ? false : true;\n      }\n      arr = [...arr, item];\n    }\n    this.setState({ docuemnts: arr });\n    let data = [];\n    for (let item2 of arr) {\n      data = [...data, item2.selected];\n    }\n    let status = data.includes(true);\n    this.setState({ button_status: !status });\n  };\n\n  getwallethistory() {\n    if (this.state.investor_id) {\n      let params = {\n        investor_id: this.state.investor_id,\n      };\n      Bridge.investor.get_wallet_history(params).then((result) => {\n        if (result.status == \"1\") {\n          let credit_amount = 0;\n          let debit_amount = 0;\n          for (let item of result.data) {\n            if (item.type == \"credited\") {\n              credit_amount = parseInt(credit_amount) + parseInt(item.amount);\n            }\n            if (item.type == \"debited\") {\n              debit_amount = parseInt(debit_amount) + parseInt(item.amount);\n            }\n          }\n          let total = parseInt(credit_amount - debit_amount);\n          this.setState({ walletMoney: Math.abs(total) });\n        } else {\n        }\n      });\n    }\n  }\n  //for getting gst from admin page\n  getGst = () => {\n    Bridge.admin.settings.getsettings().then((result) => {\n      if (result.status == \"1\") {\n        this.setState({ gst: result.data[0].taxation_percentage });\n      } else {\n        // console.log(\"gst can not be able to fetch\")\n      }\n    });\n  };\n  check_for_membership_type = () => {\n    this.setState({ formloader: true });\n    let params = {\n      investor_id: this.state.investor_id,\n    };\n    Bridge.check_for_membership_type(params).then((result) => {\n      if (result.status == 1) {\n        if (result.data.length > 0) {\n          this.setState({\n            check_membership_type: result.data[0].membership_type,\n          });\n          setTimeout(() => {\n            this.getDeals();\n          }, 500);\n        }\n      } else {\n        this.setState({ formloader: false });\n      }\n    });\n    setTimeout(() => {\n      this.getdealsettings();\n    }, 500);\n  };\n  getordertoken = () => {\n    Bridge.getcashfreetoken().then((result) => {\n      let orderToken = result.order_token;\n      // console.log(orderToken , \"Order Token\")\n      this.setState({ order_token: orderToken });\n    });\n  };\n  // get post list\n  getdealsettings = () => {\n    this.setState({ formloader: true });\n    Bridge.admin.settings.getdealsettings().then((result) => {\n      if (result.status == 1) {\n        // console.log('result',result.data);\n        this.setState({\n          label: result.data[0].label,\n        });\n        if (this.state.check_membership_type == \"premium\") {\n          this.setState({\n            percentage: result.data[0].premium_member_deal_percentage,\n          });\n        } else {\n          this.setState({\n            percentage: result.data[0].regular_member_deal_percentage,\n          });\n        }\n      } else {\n        // message.error(result.message);\n        this.setState({\n          formloader: false,\n        });\n      }\n    });\n  };\n\n  get_pitch_list = () => {\n    this.setState({ loading: true });\n    let params = {\n      deal_id: this.state.deal_id,\n    };\n    Bridge.deal.get_image_list_of_pitch(params).then((result) => {\n      if (result.status == 1) {\n        let arr = [];\n        for (let data of result.data) {\n          let pitchImg =\n            Apis.IMAGEURL +\n            \"deal/pitch_images/\" +\n            data.deal_id +\n            \"/\" +\n            data.image;\n          data.img = pitchImg;\n          arr = [...arr, data];\n        }\n        arr.sort((a, b) =>\n          a.pitch_order > b.pitch_order\n            ? 1\n            : b.pitch_order > a.pitch_order\n            ? -1\n            : 0\n        );\n        // console.log('arr',arr);\n        this.setState({ pitch_list: arr, loading: false });\n      } else {\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  getinvestmentdetails = () => {\n    this.setState({ loading: true });\n    let params = {\n      investor_id: this.state.investor_id,\n      deal_id: this.state.deal_id,\n    };\n    Bridge.investor.getinvestmentdetails(params).then((result) => {\n      if (result.status == 1) {\n        if (result.data != \"\") {\n          this.setState({ isInvested: true });\n        }\n      } else {\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  // get deal list\n  getstatusdata = () => {\n    this.setState({ loading: true });\n    let params = {\n      id: this.state.investor_id,\n    };\n    Bridge.users.getstatusdata(params).then((result) => {\n      if (result.status == 1) {\n        this.setState({\n          kycstatus: result.data[0].kycstatus,\n          bankstatus: result.data[0].ifsc_code ? true : false,\n          loading: false,\n          name: result.data[0].first_name + \" \" + result.data[0].last_name,\n          email: result.data[0].email,\n          mobile: result.data[0].mobile,\n        });\n      } else {\n        message.error(result.message);\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  // get deal list\n  getDeals = () => {\n    this.setState({ loading: true });\n    Bridge.deal.list().then((result) => {\n      // console.log(result.data, \"data\");\n      if (result.status == 1) {\n        this.setState({\n          deals: result.data,\n          loading: false,\n        });\n        let current_date = moment();\n        for (let d of result.data) {\n          // console.log(d.deal_id , \"id\")\n          // console.log(this.state.deal_id , \"sid\")\n          if (d.deal_id == this.state.deal_id) {\n            //  console.log(d.deal_status)\n            let deal_regular_show_date = moment(d.regular_show_date);\n            let deal_premium_show_date = moment(d.premium_show_date);\n            let deal_start_dt_rg = moment(d.deal_st_date);\n            let deal_start_dt_prem = moment(d.deal_start_dt_prem);\n            if (this.state.check_membership_type == \"premium\") {\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_show_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({ show_data: \"block\" });\n              } else if (current_date > deal_premium_show_date) {\n                this.setState({ show_data: \"block\" });\n              } else {\n                this.setState({ show_data: \"none\" });\n                window.location.assign(\"/deals\");\n                return;\n              }\n            } else if (this.state.check_membership_type == \"regular\") {\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_show_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({ show_data: \"block\" });\n              } else if (current_date > deal_regular_show_date) {\n                this.setState({ show_data: \"block\" });\n              } else {\n                this.setState({ show_data: \"none\" });\n                window.location.assign(\"/deals\");\n                return;\n              }\n            }\n          }\n          // else{\n          //   // window.location.href = (\"/deals\")\n          //   // return;\n          //   console.log(d.deal_id , this.state.deal_id);\n          // }\n        }\n        for (let d of result.data) {\n          if (d.deal_id == this.state.deal_id) {\n            if (d.show_status == \"0\") {\n              this.setState({ is_deal_visible: false });\n              // window.location.assign(\"/deals\")\n            } else {\n              this.setState({ is_deal_visible: true });\n            }\n            let investor_id = this.state.investor_id;\n            if (d.deal_t_type == \"Private\") {\n              if (\n                investor_id &&\n                d.invitations.length > 0 &&\n                d.invitations.includes(investor_id)\n              ) {\n              } else {\n                window.location.assign(\"/deals\");\n                return;\n              }\n            }\n            let logourl =\n              Apis.IMAGEURL + \"deal/logo/\" + d.deal_id + \"/\" + d.logo;\n\n            let pdffile = `${process.env.REACT_APP_BASE_URL}api/uploads/deal/pitch/${d.deal_id}/${d.pitch_file}`;\n            let pitchImg =\n              Apis.IMAGEURL +\n              \"deal/pitch_images/\" +\n              d.deal_id +\n              \"/\" +\n              d.pitch_files;\n            let percetage_raised = parseFloat(\n              (d.total_invested_amount / d.deal_fund_requested) * 100 +\n                parseInt(d.raiegap)\n            ).toFixed(0);\n            let deal_premium_start_date = moment(d.deal_start_dt_prem);\n            let deal_regular_start_date = moment(d.deal_st_date);\n            let deal_premium_end_date = moment(d.deal_end_dt_prem);\n            let deal_regular_end_date = moment(d.deal_deal_end_date);\n            this.setState({ deal_regular_end_date: deal_regular_end_date });\n            let button_show_status = false;\n\n            // console.log('this.state.check_membership_type',this.state.check_membership_type);\n            // console.log('deal_regular_start_date',deal_regular_start_date);\n            // console.log('deal_regular_end_date',deal_regular_end_date);\n            // console.log('current_date',current_date);\n            // deal changes\n            let differece = \"\";\n            let dealEndDate = \"\";\n            let currentDate = \"\";\n            this.setState({ coming_soon_days: \"\" });\n            if (this.state.check_membership_type == \"premium\") {\n              dealEndDate = moment(d.deal_end_dt_prem).format(\"YYYY-MM-DD\");\n              currentDate = moment().format(\"YYYY-MM-DD\");\n              let days = this.getDifferenceInDays(currentDate, dealEndDate);\n              differece = days;\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") >\n                  deal_premium_start_date.format(\"YYYY-MM-DD\") &&\n                moment(current_date).format(\"YYYY-MM-DD\") <\n                  moment(deal_premium_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_premium_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else {\n                button_show_status = false;\n              }\n              //for deal start date\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") <=\n                moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({\n                  coming_soon_days: this.getDifferenceInDays(\n                    moment(current_date).format(\"YYYY-MM-DD\"),\n                    moment(deal_premium_start_date).format(\"YYYY-MM-DD\")\n                  ),\n                });\n              }\n            } else if (\n              this.state.check_membership_type == \"regular\" ||\n              this.state.check_membership_type == \"\"\n            ) {\n              dealEndDate = moment(d.deal_end_date).format(\"YYYY-MM-DD\");\n              currentDate = moment().format(\"YYYY-MM-DD\");\n              let days = this.getDifferenceInDays(currentDate, dealEndDate);\n              differece = days;\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") >\n                  deal_regular_start_date.format(\"YYYY-MM-DD\") &&\n                moment(current_date).format(\"YYYY-MM-DD\") <\n                  moment(deal_regular_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else if (\n                moment(current_date).format(\"YYYY-MM-DD\") ==\n                moment(deal_regular_end_date).format(\"YYYY-MM-DD\")\n              ) {\n                button_show_status = true;\n              } else {\n                button_show_status = false;\n              }\n              //for deal start date\n              if (\n                moment(current_date).format(\"YYYY-MM-DD\") <=\n                moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n              ) {\n                this.setState({\n                  coming_soon_days: this.getDifferenceInDays(\n                    moment(current_date).format(\"YYYY-MM-DD\"),\n                    moment(deal_regular_start_date).format(\"YYYY-MM-DD\")\n                  ),\n                });\n              }\n            }\n            // console.log('button_show_status',this.state.button_show_status);\n            this.setState(\n              {\n                deal_name: d.name,\n                deal_description: d.Muliples_of,\n                // isBlank:d.deal_status == \"Closed\" ? window.location.href = \"/\" : \"/\",\n                isPrivate: d.deal_t_type == \"Private\" ? true : false,\n                isFunded: d.deal_status == \"Closed\" ? true : false,\n                tags: d.deal_category ? JSON.parse(d.deal_category) : [],\n                logo: logourl,\n                youtube_url: d.youtubelink,\n                dealenddays: differece > 0 ? differece : 0,\n                minamount: Number(d.Min_inv_amt),\n                captable_threshold_amount: parseInt(\n                  parseFloat(d.captable_threshold_amount).toFixed(2),\n                  10\n                ),\n                maxamount: d.Max_inv_amt,\n                captable_multiple_amount: parseInt(\n                  parseFloat(d.captable_multiple_amount).toFixed(2),\n                  10\n                ),\n                amount: \"\", //d.Min_inv_amt\n                commaAmount: \"\", //d.Min_inv_amt\n                pdffile: pdffile,\n                pitch_files: pitchImg,\n                percentage_raised: percetage_raised,\n                button_show_status: button_show_status,\n                show_data: \"block\",\n                multiples_of: d.multiples_of,\n                deal_service: d.deal_service,\n              },\n              () => this.calculategst()\n            );\n          }\n        }\n      } else {\n        message.error(result.message);\n        this.setState({\n          loading: false,\n        });\n      }\n    });\n  };\n\n  getDifferenceInDays = (date1, date2) => {\n    let diff = Math.floor((Date.parse(date2) - Date.parse(date1)) / 86400000);\n    let final = 0;\n    if (diff < 0) {\n      final = 0;\n      this.setState({\n        deal_regular_end_date_status: 1,\n      });\n    } else {\n      final = diff;\n      this.setState({\n        deal_regular_end_date_status: 0,\n      });\n    }\n    return final;\n  };\n\n  showalertmessage = () => {\n    // message.warning('Please complete your KYC process or bank details to access this deal.');\n  };\n\n  showModal1 = () => {\n    if (this.state.kycstatus == \"admin_rejected\") {\n      message.warning(\n        \"Your KYC is Rejected, Please Contact to contact@Growth91<sup>TM</sup>.com\"\n      );\n      return;\n    }\n    this.setState(\n      {\n        investmentmodal: true,\n      },\n      () => {\n        this.calculategst();\n      }\n    );\n  };\n\n  // post api hit on express\n  getpostData = () => {\n    const formData = new FormData();\n    formData.append(\"deal_id\", this.state.deal_id);\n    formData.append(\"investor_id\", this.state.investor_id);\n    axios\n      .post(\n        `${process.env.REACT_APP_BASE_URL}api/investors/InvestorCommitment/save_investor_interest_deal`,\n        formData,\n        {\n          headers: {\n            \"Content-Type\": \"multipart/form-data\",\n          },\n        }\n      )\n      .then((response) => {\n        this.setState({\n          interested_id: response.data.data,\n        });\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  };\n\n  handleOk1 = () => {\n    this.setState({\n      investmentmodal: false,\n    });\n  };\n\n  handleCancel1 = () => {\n    this.setState({\n      investmentmodal: false,\n    });\n  };\n\n  showModal2 = () => {\n    this.setState({\n      confirmmodalstatus: true,\n    });\n  };\n\n  handleOk2 = () => {\n    this.setState({\n      confirmmodalstatus: false,\n    });\n  };\n\n  handleCancel2 = () => {\n    this.setState({\n      confirmmodalstatus: false,\n    });\n  };\n  onChangeConvenience = (e) => {\n    this.setState({\n      [e.target.name]: e.target.checked,\n      Convenience: e.target.checked,\n    });\n  };\n  onChangeCheckbox = (e) => {\n    this.setState({\n      [e.target.name]: e.target.checked,\n      agreeCheck: e.target.checked,\n    });\n\n    if (e.target.name == \"deduct\") {\n      if (e.target.checked == true) {\n        let processingfees = parseFloat(\n          (this.state.amount / 100) * parseFloat(this.state.percentage)\n        );\n        let tdsamount = parseFloat(processingfees / 100) * 10;\n        let minusamt = parseFloat(processingfees - tdsamount);\n\n        this.setState({\n          processingfees: minusamt,\n          tdsdeductedamount: tdsamount,\n        });\n      } else {\n        let processingfees = parseFloat(\n          (this.state.amount / 100) * parseFloat(this.state.percentage)\n        );\n        this.setState({\n          processingfees: processingfees,\n          tdsdeductedamount: 0,\n        });\n      }\n    }\n  };\n\n  // investing your money\n  invest = () => {\n    let investor_id = this.state.investor_id;\n    let deal_id = this.state.deal_id;\n    let Investment_amt = this.state.totalamount;\n    let deductstatus = this.state.deduct == true ? \"1\" : \"0\";\n    let agreestatus = this.state.agree == true ? \"1\" : \"0\";\n    let payment_ref = this.state.order_token;\n    let tdsstatus = this.state.tdsstatus == true ? \"1\" : \"0\";\n    let processingfees = this.state.processingfees;\n    let gst = this.state.gst;\n    let legalfees = this.state.legalfee;\n    let order_id = \"order-01\";\n    let walletamt = this.state.walletDeductionMoney\n      ? this.state.walletDeductionMoney\n      : 0;\n\n    let url = `${process.env.REACT_APP_BASE_URL}cashfree/checkout.php?investor_id=${investor_id}&deal_id=${deal_id}&deductstatus=${deductstatus}&agreestatus=${agreestatus}&payment_ref=${payment_ref}&tdsstatus=${tdsstatus}&processingfees=${processingfees}&gst=${gst}&legalfees=${legalfees}&Investment_amt=${Investment_amt}&order_id=${order_id}&wallet=${walletamt}`;\n    // console.log('url',url);\n    window.location.assign(url);\n  };\n\n  loadScript = (src) => {\n    return new Promise((resolve) => {\n      const script = document.createElement(\"script\");\n      script.src = src;\n\n      script.onload = () => {\n        resolve(true);\n      };\n\n      script.onerror = () => {\n        resolve(false);\n      };\n\n      document.body.appendChild(script);\n    });\n  };\n\n  calculategst = () => {\n    let legalfee = parseFloat(\n      (this.state.amount / 100) * parseFloat(this.state.percentage)\n    );\n    let gst = this.state.gst;\n    let amt = parseFloat(this.state.amount);\n    let walletDeductionMoney;\n    if (this.state.checkWallet == false) {\n      walletDeductionMoney = 0;\n    } else {\n      walletDeductionMoney =\n        legalfee.toFixed(0) <= this.state.walletMoney\n          ? legalfee.toFixed(0)\n          : this.state.walletMoney;\n    }\n    let gstValue = ((legalfee.toFixed(0) - walletDeductionMoney) * gst) / 100;\n    this.setState({\n      gst: gst,\n      legalfee: this.state.amount ? legalfee.toFixed(0) : 0,\n      amountplusgst: this.state.amount ? amt.toFixed(0) : 0,\n      processingfees: this.state.amount ? legalfee.toFixed(0) : 0,\n      totalamount: this.state.amount\n        ? (amt + parseFloat(legalfee)).toFixed(0) -\n          walletDeductionMoney +\n          gstValue\n        : 0,\n      walletDeductionMoney: walletDeductionMoney,\n      gstValue: gstValue,\n    });\n    return gst;\n  };\n  documentPay = () => {\n    if (!this.state.investor_id) {\n      message.warning(\"Please login first to invest.\", 5);\n      return;\n    }\n    let documents = this.state.documents;\n    let paying_for_documents = [];\n    let totalamt = 0;\n    for (let item of documents) {\n      if (item.selected == true) {\n        totalamt +=\n          this.state.check_membership_type == \"premium\"\n            ? Number(item.premium_price)\n            : Number(item.regular_price);\n        paying_for_documents = [...paying_for_documents, item.documentid];\n      }\n    }\n    let order_id = \"order-01\";\n    let user_id = this.state.investor_id;\n    let amount = totalamt;\n    let docs = paying_for_documents.join(\"-\").toString();\n    let deal_id = this.state.deal_id;\n    let url = `${process.env.REACT_APP_BASE_URL}cashfree/buy_documents/checkout.php?user_id=${user_id}&order_id=${order_id}&amount=${amount}&docs=${docs}&deal_id=${deal_id}`;\n\n    window.location.href = url;\n  };\n  get_document_purchased_list = () => {\n    if (this.state.investor_id) {\n      let params = {\n        investor_id: this.state.investor_id,\n        deal_id: this.state.deal_id,\n      };\n      Bridge.deal.get_document_purchased_list(params).then((result) => {\n        if (result.status == 1) {\n          let arr = [];\n          let documents = this.state.documents;\n          for (let item of documents) {\n            let status = false;\n            item.user_paid = false;\n            for (let item2 of result.data) {\n              if (item2.document_id == item.documentid || item.paid == \"Free\") {\n                item.user_paid = true;\n              }\n            }\n            arr = [...arr, item];\n          }\n          this.setState({ documents: arr });\n        }\n      });\n    }\n  };\n  check_for_error = () => {\n    let error = \"\";\n    let multiple_of =\n      parseFloat(this.state.amount) / parseFloat(this.state.multiples_of);\n    if (Number(this.state.amount) < Number(this.state.minamount)) {\n      error = `Minimum investment amount is Rs. ${this.state.minamount}`;\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (Number(this.state.amount) > Number(this.state.maxamount)) {\n      error = `Maximum investment amount is Rs. ${this.state.maxamount}`;\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (\n      Number(this.state.amount) <\n        Number(this.state.captable_threshold_amount) &&\n      Number(this.state.amount) % Number(this.state.multiples_of) != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(\n          Number(this.state.amount) / Number(this.state.multiples_of)\n        ) * Number(this.state.multiples_of);\n      const roundedHigherAmount =\n        Math.ceil(Number(this.state.amount) / Number(this.state.multiples_of)) *\n        Number(this.state.multiples_of);\n\n      error = `Please enter an amount in multiples of ${this.state.multiples_of}. You may choose Rs ${roundedLowerAmount}\n      or Rs ${roundedHigherAmount}.`;\n      // If you would like to enter the Captable, commit an amount of Rs. ${this.state.captable_threshold_amount} or more.`;\n\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else if (\n      Number(this.state.amount) >\n        Number(this.state.captable_threshold_amount) &&\n      Number(this.state.amount) % Number(this.state.captable_multiple_amount) !=\n        0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(\n          Number(this.state.amount) /\n            Number(this.state.captable_multiple_amount)\n        ) * Number(this.state.captable_multiple_amount);\n      const roundedHigherAmount =\n        Math.ceil(\n          Number(this.state.amount) /\n            Number(this.state.captable_multiple_amount)\n        ) * Number(this.state.captable_multiple_amount);\n\n      error = `Please enter an amount in multiples of ${this.state.captable_multiple_amount}. You may choose Rs ${roundedLowerAmount}\n      or Rs ${roundedHigherAmount}.`;\n      // If you would like to enter the Captable, commit an amount of Rs. ${this.state.captable_threshold_amount} or more.`;\n\n      this.setState({ amount_error: error, amount_error_status: true });\n    } else {\n      this.setState({ amount_error: \"\", amount_error_status: false });\n    }\n  };\n  get_invest_amt = () => {\n    axios\n      .get(\n        `${process.env.REACT_APP_BASE_URL}api/investors/InvestorCommitment/get_investor_investment_for_deal`,\n        {\n          params: {\n            deal_id: this.state.deal_id,\n            investor_id: this.state.investor_id,\n          },\n        }\n      )\n      .then((response) => {\n        // console.log(\"invest_amt : \", response.data.data[0].totalamount);\n        this.setState({ invest_amt: response.data.data[0].totalamount });\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  };\n\n  increase_commit = () => {\n    const {\n      amount,\n      captable_threshold_amount,\n      multiples_of,\n      maxamount,\n      captable_multiple_amount,\n      minamount,\n    } = this.state;\n\n    let newAmount = Number(amount);\n    let changeAmount;\n\n    if (\n      newAmount < captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount > captable_threshold_amount &&\n      newAmount % captable_multiple_amount != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(captable_multiple_amount)) *\n        Number(captable_multiple_amount);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (newAmount < Number(captable_threshold_amount)) {\n      changeAmount = Number(multiples_of);\n    } else {\n      changeAmount = Number(captable_multiple_amount);\n    }\n\n    newAmount += changeAmount;\n\n    if (newAmount > maxamount) {\n      newAmount = maxamount;\n    } else if (newAmount < minamount) {\n      newAmount = Number(minamount);\n    }\n\n    this.setState(\n      {\n        amount: newAmount,\n        commaAmount: this.formatNumberWithCommas(newAmount),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  decrease_commit = () => {\n    const {\n      amount,\n      captable_threshold_amount,\n      multiples_of,\n      minamount,\n      captable_multiple_amount,\n    } = this.state;\n\n    let newAmount = Number(amount);\n    let changeAmount;\n\n    if (\n      newAmount == captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedHigherAmount =\n        Math.ceil(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedHigherAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount < captable_threshold_amount &&\n      newAmount % multiples_of != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(newAmount / Number(multiples_of)) * Number(multiples_of);\n      newAmount = roundedLowerAmount;\n      changeAmount = 0;\n    } else if (\n      newAmount > captable_threshold_amount &&\n      newAmount % captable_multiple_amount != 0\n    ) {\n      const roundedLowerAmount =\n        Math.floor(newAmount / Number(captable_multiple_amount)) *\n        Number(captable_multiple_amount);\n      newAmount = roundedLowerAmount;\n      changeAmount = 0;\n    } else if (newAmount <= Number(captable_threshold_amount)) {\n      changeAmount = Number(multiples_of);\n    } else {\n      changeAmount = Number(captable_multiple_amount);\n    }\n\n    newAmount -= changeAmount;\n\n    if (newAmount < minamount) {\n      newAmount = minamount;\n    }\n\n    this.setState(\n      {\n        amount: newAmount,\n        commaAmount: this.formatNumberWithCommas(newAmount),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  handleCommitAmount = (value) => {\n    this.setState(\n      {\n        amount: value.replace(/,/g, \"\"),\n        commaAmount: this.formatNumberWithCommas(value),\n      },\n      () => {\n        this.calculategst();\n        this.check_for_error();\n      }\n    );\n  };\n\n  formatNumberWithCommas = (number) => {\n    return number.toLocaleString(\"en-IN\");\n  };\n\n  getSliderSettings() {\n    return {\n      dots: false,\n      infinite: false,\n      speed: 500,\n      slidesToShow: 1,\n      slidesToScroll: 1,\n    };\n  }\n\n  handleClickImage = (image) => {\n    this.setState({\n      current: image,\n    });\n  };\n\n  handleCloseModal = () => {\n    this.setState({\n      current: \"\",\n    });\n  };\n\n  render() {\n    const myStyle = {\n      color: \"white\",\n      fontSize: \"17px\",\n      padding: \"50px\",\n      // justifyItem:\"center\"1\n    };\n    const genExtra = () => (\n      <>\n        {/* <PlusOutlined\n        onClick={event => {\n          If you don't want click extra trigger collapse, you can prevent this:\n          event.stopPropagation();\n        }}\n      /> */}\n      </>\n    );\n    const settings = this.getSliderSettings();\n    const { images, current } = this.state;\n\n    return (\n      <>\n        {this.state.is_deal_visible == true ? (\n          <div style={{ display: this.state.show_data }}>\n            <NewWebHeader newabout={\"newabout\"} />\n            <section\n              className=\"deals-details-page\"\n              style={{ marginBottom: \"-50px\" }}\n            >\n              <div className=\"container main-section\">\n                <div className=\"row\">\n                  <div className=\"col-lg-5 col-md-5 col-sm-5\">\n                    <Spin spinning={this.state.loading}>\n                      <div className=\"d-flex justify-content-between align-items-center\">\n                        <div className=\"d-flex align-items-center\">\n                          {/* Image is static */}\n                          <img\n                            src=\"./assets/images/deals-details/Petmojo A/Petmojo logo image.jpg\"\n                            alt=\"\"\n                            className=\"img-fluid\"\n                            style={{\n                              marginRight: \"20px\",\n                              width: \"50%\",\n                              objectFit: \"contain\",\n                            }}\n                          />\n                          <h5 className=\"ml-5 mt-4\">Petmojo</h5>\n                          {/* <h5>{this.state.logo}</h5> */}\n                        </div>\n                        {this.state.isPrivate == true && (\n                          <div\n                            className=\"private-tag\"\n                            style={{\n                              height: 38,\n                            }}\n                          >\n                            <span style={{ fontSize: 12 }}>Private</span>{\" \"}\n                          </div>\n                        )}\n                      </div>\n                      <div className=\"d-flex tags\">\n                        {this.state.tags.length > 0 &&\n                          this.state.tags.map((tag, index) => (\n                            <div\n                              className=\"hero-tag\"\n                              key={index}\n                              style={{\n                                background: \"rgb(41 23 111)\",\n                                color: \"#fff\",\n                              }}\n                            >\n                              {tag}\n                            </div>\n                          ))}\n                      </div>\n                      <p style={{ textAlign: \"justify\" }}>\n                      Petmojo is one of India’s leading and fastest-growing PetCare Service Aggregators Platform. It provides a wide range of services, such as grooming, walking, training, boarding, and veterinary  all available at the customer's doorstep with just a few clicks. They have developed a curriculum with internationally acclaimed techniques to understand pet behavior to match the needs of India’s pet parents, fostering a strong and healthy relationship between the parent and their pet for life which also makes pet care more accessible and hassle-free, positioning itself as a leader in the growing D2C pet care sector.                      </p>{\" \"}\n                      <div className=\" percentage-container\">\n                        <div className=\"percentage-values\">\n                          {this.state.coming_soon_days ? (\n                            <>\n                              <div>\n                                <h3>{this.state.percentage_raised}%</h3>\n                                <span>RAISED</span>\n                              </div>\n                              <div style={{ textAlign: \"right\" }}>\n                                <h3>{this.state.coming_soon_days} Days</h3>\n                                <span>CAMPAIGN START IN</span>\n                              </div>\n                            </>\n                          ) : (\n                            <>\n                              <div>\n                                <h3>{this.state.percentage_raised}%</h3>\n                                <span>RAISED</span>\n                              </div>\n                              <div style={{ textAlign: \"right\" }}>\n                                <h3>{this.state.dealenddays} Days</h3>\n                                <span>CAMPAIGN ENDS IN</span>\n                              </div>\n                            </>\n                          )}\n                        </div>\n                        <Progress\n                          percent={this.state.percentage_raised}\n                          strokeColor={{\n                            \"0%\": \"rgb(255 156 26)\",\n                            \"100%\": \"rgb(255 156 26)\",\n                          }}\n                          showInfo={false}\n                        />\n                      </div>\n                      {!this.state.investor_id ? (\n                        <div className=\"button-group text-center\">\n                          <a className=\"prime-bg\" href=\"/Login\">\n                            Login\n                          </a>\n                          {/* <button className='share-button'>\n                        <i className='bx bxs-share'></i>\n                      </button> */}\n                        </div>\n                      ) : (\n                        <>\n                          {this.state.button_show_status == true ? (\n                            <>\n                              <div className=\"button-group\">\n                                {this.state.isFunded == true ? (\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg text-center\"\n                                  >\n                                    Deal is closed\n                                  </a>\n                                ) : this.state.user_type != \"founder\" &&\n                                  this.state.invest_amt !== null ? (\n                                  <div className=\"button-group\">\n                                    <p>{`You have committed Rs. ${this.state.invest_amt} to this deal so far. (Including platform fees)`}</p>\n                                    <a\n                                      href=\"#!\"\n                                      style={{ padding: \"13px 0\" }}\n                                      onClick={() => {\n                                        this.getpostData();\n                                        this.showModal1();\n                                      }}\n                                      className=\"black-button prime-bg text-center\"\n                                      id=\"btn-invest\"\n                                    >\n                                      Add more\n                                    </a>\n                                  </div>\n                                ) : this.state.isPrivate == true &&\n                                  this.state.user_type != \"founder\" ? (\n                                  <a\n                                    style={{ padding: \"13px 0\" }}\n                                    href=\"#\"\n                                    onClick={() => {\n                                      this.getpostData();\n                                      this.showModal1();\n                                    }}\n                                    className=\"black-button prime-bg text-center\"\n                                  >\n                                    Express Your Interest\n                                  </a>\n                                ) : this.state.user_type == \"founder\" ? (\n                                  <div>\n                                    {this.state.user_type == \"founder\" &&\n                                    this.state.founder_is_investor == \"1\" ? (\n                                      <a\n                                        href=\"#\"\n                                        style={{ padding: \"15px 0\" }}\n                                        className=\"black-button prime-bg text-center\"\n                                        onClick={() => {\n                                          this.getpostData();\n                                          this.showModal1();\n                                        }}\n                                      >\n                                        Express Your Interest\n                                      </a>\n                                    ) : (\n                                      <a\n                                        href=\"/founder-as-investor\"\n                                        className=\"black-button prime-bg text-center\"\n                                      >\n                                        Apply as investor\n                                      </a>\n                                    )}\n                                  </div>\n                                ) : (\n                                  <div>\n                                    {this.state.user_type == \"investor\" &&\n                                    this.state.invest_amt === null ? (\n                                      <a\n                                        href=\"#\"\n                                        className=\"black-button prime-bg text-center\"\n                                        onClick={() => {\n                                          this.getpostData();\n                                          this.showModal1();\n                                        }}\n                                        style={{ padding: \"13px 0\" }}\n                                      >\n                                        Express Your Interest\n                                      </a>\n                                    ) : null}\n                                  </div>\n                                )}\n                                {/* <button className='share-button'>\n                              <i className='bx bxs-share'></i>\n                            </button> */}\n                              </div>\n                            </>\n                          ) : (\n                            // <div className='button-group'>\n                            //   <a href=\"#\" className=\"black-button prime-bg\" style={{cursor:'default'}} >Coming soon..</a>\n                            // </div>\n                            <>\n                              {this.state.deal_regular_end_date_status == 0 ? (\n                                <div className=\"button-group\">\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg\"\n                                    style={{ cursor: \"default\" }}\n                                  >\n                                    Coming soon..\n                                  </a>\n                                </div>\n                              ) : (\n                                <div className=\"button-group\">\n                                  <a\n                                    href=\"#\"\n                                    className=\"black-button prime-bg\"\n                                    style={{ cursor: \"default\" }}\n                                  >\n                                    Deal is closed\n                                  </a>\n                                </div>\n                              )}\n                            </>\n                          )}\n                        </>\n                      )}\n                    </Spin>\n                  </div>\n                  <Modal\n                    title={`Invest in ${this.state.deal_name}`}\n                    visible={this.state.investmentmodal}\n                    onOk={this.handleOk1}\n                    onCancel={this.handleCancel1}\n                    width={600}\n                    footer={false}\n                  >\n                    <div className=\"row modal-body\">\n                      <div className=\"login mt-3\">\n                        <label>\n                          <b>\n                            Amount: <br />\n                            Minimum investment Rs.{\" \"}\n                            {this.formatNumberWithCommas(\n                              this.state.minamount\n                            )}{\" \"}\n                            <br />\n                            Cap Table entry is Rs.\n                            {this.formatNumberWithCommas(\n                              this.state.captable_threshold_amount\n                            )}\n                          </b>\n                        </label>\n                        <input\n                          type=\"text\"\n                          name=\"amount\"\n                          className=\"form-input-field mt-4\"\n                          autofocus={true}\n                          placeholder=\"amount\"\n                          style={{\n                            border:\n                              this.state.amount_error_status == true &&\n                              this.state.amount\n                                ? \"1px solid red\"\n                                : \"1px solid transparent\",\n                          }}\n                          id=\"selected-field\"\n                          value={this.state.commaAmount}\n                          onChange={(e) => {\n                            this.handleCommitAmount(e.target.value);\n                          }}\n                        />\n                        <div className=\"d-flex justify-content-between mb-3\">\n                          <button\n                            className=\"commit-plus\"\n                            onClick={this.decrease_commit}\n                          >\n                            -\n                          </button>\n                          <button\n                            className=\"commit-minus\"\n                            onClick={this.increase_commit}\n                          >\n                            +\n                          </button>\n                        </div>\n                        {this.state.amount_error_status == true && (\n                          <p\n                            className=\"text-danger pb-0\"\n                            style={{ position: \"relative\", top: -19 }}\n                          >\n                            {this.state.amount_error}\n                          </p>\n                        )}\n                      </div>\n\n                      <div class=\"form-group form-check d-flex\">\n                        <Checkbox\n                          checked={this.state.checkWallet}\n                          onChange={(e) => {\n                            this.setState(\n                              { checkWallet: e.target.checked },\n                              () => this.calculategst()\n                            );\n                          }}\n                        >\n                          {\" \"}\n                        </Checkbox>\n                        <label className=\"form-check-label\">\n                          Use Your ₹ {this.state.walletMoney} Growth91\n                          <sup style={{ fontSize: \"0.6rem\" }}>\n                            TM\n                          </sup> Money{\" \"}\n                        </label>\n                      </div>\n                      <div className=\" d-flex justify-content-center modal-table\">\n                        <table\n                          className=\"col-12 m-5 investment-charge-table\"\n                          cellPadding={4}\n                        >\n                          <tr>\n                            <th>\n                              <strong>Particulars</strong>\n                            </th>\n                            <th>\n                              <strong>Amount</strong>\n                            </th>\n                          </tr>\n                          <tr>\n                            <td>Investment Amount</td>\n                            <td lassName=\"text-center\">\n                              ₹{\" \"}\n                              {this.state.amountplusgst\n                                ? this.state.amountplusgst\n                                : \"0\"}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>\n                              Convenience Fees\n                              <br />\n                              <span>{this.state.label}</span>\n                            </td>\n                            <td lassName=\"text-center\">\n                              ₹ {this.state.processingfees}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>Wallet Money</td>\n                            <td lassName=\"text-center\">\n                              - ₹ {this.state.walletDeductionMoney}\n                            </td>\n                          </tr>\n                          <tr>\n                            <td>Total</td>\n                            <td>\n                              ₹ {parseFloat(this.state.totalamount).toFixed(0)}\n                            </td>\n                          </tr>\n                        </table>\n                      </div>\n                      {this.state.invest_amt !== null ? (\n                        <div className=\"\">\n                          <Alert\n                            message={`You have committed Rs. ${this.state.invest_amt} to this deal so far. (Including platform fees)`}\n                            type=\"info\"\n                          />\n                        </div>\n                      ) : null}\n                      <div className=\"m-3\">\n                        <label className=\"container-check\">\n                          I Agree to Terms and Conditions and have read the\n                          Privacy Policy. And, I understand that I will be\n                          required to pay the full amount committed after the\n                          deal is closed.\n                          <input\n                            type=\"checkbox\"\n                            name=\"agree\"\n                            onChange={this.onChangeCheckbox}\n                          />\n                          <span className=\"checkmark\"></span>\n                        </label>\n\n                        <label\n                          className=\"container-check\"\n                          style={{ fontSize: \"10px\" }}\n                        >\n                          Convenience Fee of 2% on the investment amount at the\n                          time of investment and 2% on the sale proceeds at the\n                          time of exit is applicable.\n                        </label>\n                      </div>\n\n                      <div className=\"col-12\">\n                        {this.state.amount_error_status == true ? (\n                          <button\n                            type=\"button\"\n                            className=\"login-button text-center\"\n                            style={{\n                              border: \"1px solid #9a9a9a\",\n                              backgroundColor: \"#9a9a9a\",\n                              cursor: \"not-allowed\",\n                              padding: \"0.9em 0 \",\n                            }}\n                          >\n                            Express Your Interest\n                          </button>\n                        ) : (\n                          <InvestmentMembershipmodal\n                            processingfees={this.state.processingfees}\n                            deal_id={this.state.deal_id}\n                            membership_type={this.state.check_membership_type}\n                            invest={this.invest}\n                            amount={this.state.amount}\n                            agreecheck={this.state.agreeCheck}\n                            totalamount={this.state.totalamount}\n                            fee={this.state.legalfee}\n                            minamount={this.state.minamount}\n                            maxamount={this.state.maxamount}\n                            agree={this.state.agree}\n                            error_status={this.state.amount_error_status}\n                            investor_id={this.state.investor_id}\n                            deduct={this.state.deduct}\n                            tdsstatus={this.state.tdsstatus}\n                            gst={this.state.gst}\n                            order_token={this.state.order_token}\n                            legalfee={this.state.legalfee}\n                            walletDeductionMoney={\n                              this.state.walletDeductionMoney\n                            }\n                            user_id={this.state.investor_id}\n                            escrow_account_ifsc={this.state.escrow_account_ifsc}\n                            escrowact={this.state.escrowact}\n                            interested_id={this.state.interested_id}\n                            invest_amt={this.state.invest_amt}\n                          />\n                        )}\n                      </div>\n                    </div>\n                  </Modal>\n                  <Modal\n                    title=\"Deduct TDS\"\n                    visible={this.state.confirmmodalstatus}\n                    onOk={this.handleOk2}\n                    onCancel={this.handleCancel2}\n                    width={700}\n                    footer={false}\n                  >\n                    <div className=\"row\">\n                      <div style={{ width: \"100%\" }}>\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          TDS is applicable according to Section-194j of the\n                          income Tex act, 1961.\n                        </p>\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          Rate: 10%\n                        </p>{\" \"}\n                        <br />\n                        <p style={{ margin: \"10px\", maxWidth: \"100%\" }}>\n                          <b>Do you want to Deduct TDS?</b>\n                        </p>\n                      </div>\n\n                      <div className=\"col-11\">\n                        <button\n                          type=\"button\"\n                          className=\"login-button bg-primary mt-4 mx-4\"\n                          onClick={() => this.invest()}\n                        >\n                          Yes\n                        </button>\n                        <input\n                          type=\"button\"\n                          value=\"No Thanks\"\n                          onClick={() => this.invest()}\n                          className=\"login-button mx-4 my-3\"\n                        ></input>\n                      </div>\n                    </div>\n                  </Modal>\n                  <div className=\"col-lg-7 deal-banner deals-video-banner liaplus \">\n                                        \n                 <iframe\n                      style={{\n                        boxShadow: \"0px 0px 2rem -0.5rem rgb(0 0 0 / 40%)\",\n                        borderRadius: 3,\n                        // marginLeft: 65,\n                      }}\n                      width=\"100%\"\n                      height=\"335\"\n                     src=\"https://www.youtube.com/embed/-Mt9yz89GlU\" title=\"Petmojo Product video 1\"   allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                      allowfullscreen\n                    ></iframe> \n                 <iframe\n                      style={{\n                        boxShadow: \"0px 0px 2rem -0.5rem rgb(0 0 0 / 40%)\",\n                        borderRadius: 3,\n                        // marginLeft: 65,\n                      }}\n                      width=\"100%\"\n                      height=\"335\"\n                      src=\"https://www.youtube.com/embed/YnzsCj6f89Q\" title=\"Petmojo Product Video 2\"  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                      allowfullscreen\n                    ></iframe> \n\n\n                    {/* {!this.state.youtube_url && (\n                      <>\n                        <img\n                          src=\"./assets/images/deals-details/LiaPlus AI/banner.jpg\"\n                          width=\"100%\"\n                          style={{ height: \"auto\" }}\n                          className=\"sectionliaplus\"\n                        />\n                      </>\n                    )} */}\n                  </div>\n                  {/* Market Overview */}\n                  <div\n                    className=\"container home-decor-section mt-0\"\n                    style={{ marginTop: \"3px !important\" }}\n                  >\n                    <h1\n                      className=\"text-center\"\n                      style={{\n                        marginBottom: \"20px\",\n                        marginTop: \"0px !important\",\n                      }}\n                    >\n                      Market Overview\n                    </h1>\n                    <div className=\"row\">\n                      <div className=\"col-lg-4\">\n                        <div className=\"single text-center h-lg market-boxes\">\n                          {/* <h2 style={{paddingBottom:\"20px\"}}>$1 Tn </h2> */}\n                          <p\n                            style={{\n                              color: \"white\",\n                              fontSize: \"21px\",\n                              padding: \"2px\",\n                              margin: \"48px 0px\",\n                              opacity: \"1\",\n                              lineHeight: \"1.5\",\n                            }}\n                          >\n                            <span\n                              style={{\n                                color: \"white\",\n                                fontSize: \"21px\",\n                                padding: \"2px\",\n                                margin: \"48px 0px\",\n                                opacity: \"1\",\n                                lineHeight: \"1.5\",\n                                fontWeight: \"800\",\n                              }}\n                            >\n                              {/* India's Higher Education Market: */}\n                            </span>{\" \"}\n                            The Indian pet care market is poised for substantial growth, driven by increasing pet ownership and rising disposable incomes. With a projected compound annual growth rate (CAGR) of 20%, the market size is expected to expand from $1.6 billion in 2024 to $10.2 billion by 2033. By then, 15-20% of Indian households will have pets. This surge in pet adoption, coupled with a greater willingness among pet owners to spend on high-quality care and services, presents a vast opportunity for businesses operating in this sector.\n                            </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-4\">\n                        <div className=\"single text-center h-lg market-boxes\">\n                          {/* <h2 style={{paddingBottom:\"20px\"}}>$200 Bn</h2> */}\n                          <p\n                            style={{\n                              color: \"white\",\n                              fontSize: \"21px\",\n                              padding: \"2px\",\n                              margin: \"48px 0px\",\n                              opacity: \"1\",\n                              lineHeight: \"1.5\",\n                            }}\n                          >\n                            <span\n                              style={{\n                                color: \"white\",\n                                fontSize: \"21px\",\n                                padding: \"2px\",\n                                margin: \"48px 0px\",\n                                opacity: \"1\",\n                                lineHeight: \"1.5\",\n                                fontWeight: \"800\",\n                              }}\n                            >\n                              {/* International Education and Skill Shortages: */}\n                            </span>{\" \"}\n                            Despite its potential, the market remains highly fragmented, with 95% of services provided by local, often undigitized players needing more standardization in quality, trust, and reliability. This fragmentation offers a significant opportunity for technology-driven platforms to consolidate the market. By providing reliable, consistent, and easily accessible services, these platforms can address the prevailing trust issues and capture a substantial share of the market. Companies that effectively leverage technology to offer standardized services stand to benefit from early mover advantages in a market ripe for disruption.\n                          </p>\n                        </div>\n                      </div>\n\n                      <div className=\"col-lg-4\">\n                        <div className=\"single text-center h-lg market-boxes\">\n                          {/* <h2 style={{paddingBottom:\"20px\"}}>$200 Bn</h2> */}\n                          <p\n                            style={{\n                              color: \"white\",\n                              fontSize: \"21px\",\n                              padding: \"2px\",\n                              margin: \"48px 0px\",\n                              opacity: \"1\",\n                              lineHeight: \"1.5\",\n                            }}\n                          >\n                            <span\n                              style={{\n                                color: \"white\",\n                                fontSize: \"21px\",\n                                padding: \"2px\",\n                                margin: \"48px 0px\",\n                                opacity: \"1\",\n                                lineHeight: \"1.5\",\n                                fontWeight: \"800\",\n                              }}\n                            >\n                              {/* Government Focus on Upskilling: */}\n                            </span>{\" \"}\n                            The ongoing digital transformation in India, characterized by the widespread adoption of smartphones and increasing internet penetration, is another critical factor contributing to the growth of the pet care market. Digital platforms offering a range of pet care services, such as grooming, training, veterinary care, and boarding, are becoming increasingly popular among tech-savvy pet owners. As the market continues to evolve, companies that expand geographically and diversify their service offerings will be better positioned to meet the growing and varied demands of pet owners across different regions. This expansion strategy will not only enhance market reach but also help in building customer loyalty through comprehensive service delivery​\n                          </p>{\" \"}\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"text-center fs-4\">\n                      <span style={{ color: \"#000\" }}>Source: </span>\n                      <span style={{ color: \"rgb(127, 119, 118)\" }}>\n                        Multiple publicly available research and survey reports\n                      </span>\n                    </div>\n                    <p className=\"\"> </p>\n                    <div className=\"text-center fluid-container\"></div>\n                  </div>\n                  <div\n                    className=\"container highlight-section\"\n                    style={{\n                      marginBottom: \"-80px !important\",\n                      padding: \"0px !important\",\n                    }}\n                  >\n                    <h1 style={{ fontSize: \"2rem\", marginBottom: \"30px\" }}>\n                      Highlights\n                    </h1>\n\n                    <div className=\"row highlight-rows\">\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single  mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/Petmojo/highlight4.jpg\" />\n                          </div>\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                          PETMOJO’s successful expansion from Delhi/NCR to Mumbai, with plans to enter other major Indian cities like Pune, Hyderabad, Kolkata, Bangalore, and Chennai, demonstrates a strategic approach to market penetration.  Also, Deepinder Goyal Founder of Zomato has given 6 months training of their personal dog through Petmojo.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/Petmojo/highlight01.jpg\" />\n                          </div>\n                          <p style={{ padding: \"1px !important\" }}>\n                          PETMOJO utilizes a scalable tech stack with features like live GPS tracking, easy bookings, service ratings, and in-app customer support, which supports its geographical expansion while minimizing additional tech costs. The platform’s high customer satisfaction, reflected in average ratings of 4.7 and 4.9, demonstrates strong trust and reliability, sustaining the growth in the competitive pet care market.\n                          </p>{\" \"}\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/highlight2.jfif\" />\n                          </div>\n                          <p style={{ padding: \"0px !important\" }}>\n                          PETMOJO has shown robust performance with over 2,10,000 sessions delivered and more than 25,000 paid customers, reflecting a strong demand for its services. The company has achieved a current Annual Recurring Revenue (ARR) of over ₹10.5 crores, indicating solid financial health and growth potential. Additionally, PETMOJO’s consistent month-on-month revenue growth with minimal cash burn underscores its scalable business model and effective financial management.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-lg-6 col-md-12 col-sm-12 col-12 col-xl-6\">\n                        <div\n                          className=\"single mindlerhighlight text-left\"\n                          style={{}}\n                        >\n                          <div className=\"hightlights-images\">\n                            <img src=\"./assets/images/deals-details/highlight3.jpg\" />\n                          </div>\n                          <p style={{ paddingLeft: \"0px !important\" }}>\n                          The company’s ability to secure ₹3.5 crore in previous funding and attract commitments for 50% of its current ₹10 crore investment round showcases strong investor confidence in its business model and growth strategy. These funds will support further brand marketing, geographic expansion, talent acquisition, and diversification of service offerings, positioning PETMOJO for continued success in the burgeoning Indian pet care market.\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* media */}\n                </div>\n              </div>\n              <section\n                className=\"deals-details-page\"\n                style={{ marginBottom: \"-50px\", marginTop: \"40px \" }}\n              >\n                <div>\n                  <div>\n                    {/* media */}\n\n                    \n                     <div\n                      className=\"container highlight-section\"\n                      style={{\n                        marginBottom: \"-80px !important\",\n                        padding: \"0px !important\",\n                      }}\n                    >\n                      <h1 style={{ fontSize: \"2rem\", marginBottom: \"30px\" }}>\n                        Media Coverage\n                      </h1>\n                      <div className=\"row\">\n                        <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                          <div className=\"single medialink text-left d-flex flex-column  \">\n                            <img src=\"./assets/images/deals-details/Petmojo A/Media/636210323022105842-Mojo-Jojo.webp\" />\n\n                            <p style={{ padding: \"1px !important\" }}>\n                            Petmojo: One of India's Leading & Fastest Growing Pet Care Platform                            <a\n                                href=\"https://startup.siliconindia.com/vendor/petmojo-one-of-india-s-leading-fastest-growing-pet-care-platform-cid-20094.html\"\n                                target=\"_blank\"\n                              >\n                                {\" \"}\n                                Readmore\n                              </a>\n                            </p>\n                          </div>\n                        </div>\n\n                        <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                          <div className=\"single medialink text-left d-flex flex-column  \">\n                            <img src=\"./assets/images/deals-details/Petmojo A/Media/PetMojo-One-Stop-Destination-For-Pet-Services-at-Your-Doorstep-1024x576.webp\" />\n                            <p style={{ padding: \"1px !important\" }}>\n                            PetMojo: One-Stop Destination For Pet Services at Your Doorstep\n\n                              <a\n                                href=\"https://businessconnectindia.in/petmojo-one-stop-destination-for-pet/\"\n                                target=\"_blank\"\n                              >\n                                {\" \"}\n                                Readmore\n                              </a>\n                            </p>\n                          </div>\n                        </div>\n                        <div className=\"col-lg-6 col-md-6 col-sm-6\">\n                          <div className=\"single medialink text-left d-flex flex-column  \">\n                            <img src=\"./assets/images/deals-details/Petmojo A/Media/feature-6-760x570.png\" />\n                            <p style={{ padding: \"1px !important\" }}>\n                            GSF Invests In 5 Early-Stage Startups From GSF Founders Academy’s Cohort\n                              <a    \n                                href =\"https://inc42.com/buzz/gsf-invests-in-5-early-stage-startups-from-gsf-founders-academy/\"\n                                target=\"_blank\"\n                              >\n                                Readmore\n                              </a>\n                            </p>\n                          </div>\n                        </div>\n\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </section>\n            </section>\n            <div className=\"deals-page\">\n              <div className=\"tab-wrapper\">\n                <div className=\"container\">\n                  <div className=\"row\">\n                    <div\n                      className=\"col-lg-12 col-md-12 col-sm-12\"\n                      style={{\n                        marginTop: 110,\n                      }}\n                    >\n                      <div className=\"deal-terms-section\">\n                        {/* Investor Presentation */}\n                        <div\n                          className=\"\"\n                          style={{\n                            backgroundColor: \"white\",\n                            marginTop: \"1px !important\",\n                          }}\n                        >\n                          <h1\n                            style={{\n                              fontSize: 32,\n                              marginBottom: 30,\n                              textAlign: \"center\",\n                              marginTop: \"-10px !important\",\n                            }}\n                          >\n                            Investor Presentation\n                          </h1>\n                          <Slider {...settings} className=\"mb-5 pitch-slider\">\n                            {images.map((image, index) => (\n                              <img\n                                key={index}\n                                src={image}\n                                onClick={() => this.handleClickImage(image)}\n                              />\n                            ))}\n                          </Slider>\n                          {current && (\n                            <Lightbox\n                              mainSrc={current}\n                              onCloseRequest={this.handleCloseModal}\n                            />\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"deals-page\">\n              <div className=\"tab-wrapper\">\n                <div className=\"container\">\n                  <div className=\"row\">\n                    <div\n                      className=\"col-lg-12 col-md-12 col-sm-12\"\n                      style={{\n                        marginTop: 110,\n                      }}\n                    >\n                      <Tabs\n                        defaultActiveKey=\"1\"\n                        centered\n                        style={{ marginBottom: \"30px !important\" }}\n                      >\n                        <TabPane tab=\"Details\" key=\"2\">\n                          <div className=\"deal-terms-section\">\n                            <div\n                              className=\"container\"\n                              style={{ marginTop: \"1px !important\" }}\n                            >\n                              <div className=\"row\">\n                                <div className=\"col-lg-10 m-auto\">\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"-30px !important\",\n                                      marginTop: \"30px\",\n                                    }}\n                                  >\n                                    Deal Terms\n                                  </h1>\n                                  <div\n                                    className=\"\"\n                                    style={{ marginTop: \"0px !important\" }}\n                                  >\n                                    <div className=\"container\">\n                                      <div className=\"row\">\n                                        <div className=\"col-lg-12\">\n                                          <div className=\"info\">\n                                            <span>End Date</span>\n                                            <h4\n                                              style={{\n                                                textTransform: \"Capitalize\",\n                                              }}\n                                            >\n                                              {this.state.deal_regular_end_date\n                                                ? moment(\n                                                    this.state\n                                                      .deal_regular_end_date\n                                                  ).format(\"MMM DD, YYYY\")\n                                                : \"\"}\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span> Min Investment</span>\n                                            <h4>\n                                              ₹{\" \"}\n                                              {this.formatNumberWithCommas(\n                                                this.state.minamount\n                                              )}{\" \"}\n                                              for {this.state.deal_service}\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Valuation</span>\n                                            <h4>50 cr pre money</h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <h1\n                                    style={{\n                                      paddingBottom: \"0px\",\n                                      marginTop: \"20px\",\n                                    }}\n                                  >\n                                    Company Details\n                                  </h1>\n                                  <section\n                                    className=\"deal-about-artment-section\"\n                                    style={{ marginTop: \"50px\" }}\n                                  >\n                                    <div className=\"container\">\n                                      <div className=\"row\">\n                                        <div className=\"col-lg-12\">\n                                          <div className=\"info\">\n                                            <span>Legal Name</span>\n                                            <h4>Mangopaw Technologies and Solutions PVT LTD</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Founded</span>\n                                            <h4>1/04/2022\n</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Status</span>\n                                            <h4>Private Limited Company</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Employees</span>\n                                            <h4>60</h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Website</span>\n                                            <h4>\n                                              <a\n                                                style={{\n                                                  color: \"rgb(7, 211, 252)\",\n                                                }}\n                                                href=\"https://petmojo.care/\"\n                                                target=\"_blank\"\n                                              >\n                                                 petmojo.care\n                                              </a>\n                                            </h4>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Social Links</span>\n                                            <div className=\"social-icons\">\n                                              <a href=\"https://www.facebook.com/petmojo.in\">\n                                                <i className=\"bx bxl-facebook fs-19\"></i>\n                                              </a>\n                                              <a href=\"https://www.linkedin.com/company/petmojo/\">\n                                                <i className=\"bx bxl-linkedin fs-19\"></i>\n                                              </a>\n                                              <a href=\"https://www.instagram.com/petmojo.care\">\n                                                <i className=\"bx bxl-instagram fs-19\"></i>\n                                              </a>\n\n                                              <a href=\"https://www.youtube.com/@petmojo1319\">\n                                                <i className=\"bx bxl-youtube fs-19\"></i>\n                                              </a>\n                                            </div>\n                                          </div>\n                                          <div className=\"info\">\n                                            <span>Address</span>\n                                            <h4>\n                                            UU182 Pitampura\n                                            </h4>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </div>\n                                  </section>\n                                </div>\n                              </div>\n                            </div>\n\n                            {/* Investor Presentation */}\n                          </div>\n                          {/* start */}\n\n                          <div\n                            className=\"deals-page\"\n                            style={{\n                              marginTop: \"50px !important\",\n                            }}\n                          >\n                            <div className=\"deal-terms-section\">\n                              <div\n                                className=\"container\"\n                                style={{ marginTop: \"1px !important\" }}\n                              >\n                                <div className=\"row\">\n                                  <div className=\"col-lg-10 m-auto\">\n                                    <h1>Documents</h1>\n                                    <div className=\"row document-section\">\n                                      <div className=\"col-lg-2\"></div>\n                                      <div className=\"col-lg-8\">\n                                        <div\n                                          className=\"download-section\"\n                                          style={{\n                                            backgroundColor: \"white\",\n                                            padding: \"4rem 19px\",\n                                          }}\n                                        >\n                                          <>\n                                            <div>\n                                              <table\n                                                className=\"download-document-table\"\n                                                style={{ width: \"100%\" }}\n                                              >\n                                                <tr\n                                                  style={{\n                                                    background: \"#29176f\",\n                                                    color: \"#fff\",\n                                                  }}\n                                                >\n                                                  <th>Sr no</th>\n                                                  <th>Document</th>\n                                                  <th>Type</th>\n                                                  <th>Download</th>\n                                                </tr>\n                                                {this.state.documents.length >\n                                                  0 &&\n                                                  this.state.documents.map(\n                                                    (item, index) => {\n                                                      // console.log(\n                                                      //   this.state.documents\n                                                      //     .length\n                                                      // );\n                                                      let documentlink = `${process.env.REACT_APP_BASE_URL}api/uploads/docs/${item.documentid}/${item.document}`;\n                                                      return (\n                                                        <tr\n                                                          key={index}\n                                                          style={{ height: 70 }}\n                                                        >\n                                                          {/* <td\n                                                          style={{ width: 40 }}\n                                                        >\n                                                          {item.paid ==\n                                                            \"Paid\" && (\n                                                            <>\n                                                              {this.state\n                                                                .check_membership_type ==\n                                                                \"premium\" &&\n                                                              item.premium_price !=\n                                                                \"0\" &&\n                                                              item.premium_price !=\n                                                                \"\" ? (\n                                                                <>\n                                                                  {item.user_paid ==\n                                                                  false ? (\n                                                                    <Checkbox\n                                                                      onChange={() =>\n                                                                        this.show_selected_checkbox(\n                                                                          item\n                                                                        )\n                                                                      }\n                                                                      value={\n                                                                        item.selected\n                                                                      }\n                                                                    ></Checkbox>\n                                                                  ) : (\n                                                                    <>\n                                                                      {item.user_paid ==\n                                                                        true && (\n                                                                        <img\n                                                                          src=\"./paid.png\"\n                                                                          style={{\n                                                                            maxWidth: 20,\n                                                                          }}\n                                                                        />\n                                                                      )}\n                                                                    </>\n                                                                  )}\n                                                                </>\n                                                              ) : (\n                                                                <>\n                                                                  {this.state\n                                                                    .check_membership_type ==\n                                                                    \"regular\" &&\n                                                                    item.regular_price !=\n                                                                      \"0\" &&\n                                                                    item.regular_price !=\n                                                                      \"\" &&\n                                                                    item.user_paid ==\n                                                                      false && (\n                                                                      <Checkbox\n                                                                        onChange={() =>\n                                                                          this.show_selected_checkbox(\n                                                                            item\n                                                                          )\n                                                                        }\n                                                                        value={\n                                                                          item.selected\n                                                                        }\n                                                                      ></Checkbox>\n                                                                    )}\n                                                                </>\n                                                              )}\n                                                            </>\n                                                          )}\n                                                        </td> */}\n                                                          <td\n                                                            style={{\n                                                              width: 40,\n                                                            }}\n                                                          >\n                                                            {index + 1}\n                                                          </td>\n                                                          <td\n                                                            style={{\n                                                              width: 140,\n                                                            }}\n                                                          >\n                                                            {item.docname}\n                                                          </td>\n                                                          <td\n                                                            style={{\n                                                              width: 40,\n                                                            }}\n                                                          >\n                                                            {item.paid == \"Paid\"\n                                                              ? this.state\n                                                                  .check_membership_type ==\n                                                                \"premium\"\n                                                                ? item.premium_price ==\n                                                                  \"0\"\n                                                                  ? \"Free\"\n                                                                  : \"₹\" +\n                                                                    item.premium_price\n                                                                : item.regular_price ==\n                                                                  \"0\"\n                                                                ? \"Free\"\n                                                                : \"₹\" +\n                                                                  item.regular_price\n                                                              : \"Free\"}\n                                                          </td>\n                                                          <td\n                                                            style={{\n                                                              width: 50,\n                                                            }}\n                                                          >\n                                                            {this.state\n                                                              .investor_id && (\n                                                              <center>\n                                                                {(item.user_paid ==\n                                                                  true ||\n                                                                  item.paid ==\n                                                                    \"Free\") && (\n                                                                  <a\n                                                                    href={\n                                                                      documentlink\n                                                                    }\n                                                                    target=\"_blank\"\n                                                                    style={{\n                                                                      width: 80,\n                                                                    }}\n                                                                  >\n                                                                    <img\n                                                                      src=\"./download.ico\"\n                                                                      style={{\n                                                                        maxWidth: 50,\n                                                                      }}\n                                                                    />\n                                                                  </a>\n                                                                )}\n                                                                {item.paid ==\n                                                                  \"Paid\" &&\n                                                                  this.state\n                                                                    .check_membership_type ==\n                                                                    \"premium\" &&\n                                                                  (item.premium_price ==\n                                                                  \"0\" ? (\n                                                                    <a\n                                                                      href={\n                                                                        documentlink\n                                                                      }\n                                                                      target=\"_blank\"\n                                                                      style={{\n                                                                        width: 80,\n                                                                      }}\n                                                                    >\n                                                                      <img\n                                                                        src=\"./download.ico\"\n                                                                        style={{\n                                                                          maxWidth: 50,\n                                                                        }}\n                                                                      />\n                                                                    </a>\n                                                                  ) : (\n                                                                    \"\"\n                                                                  ))}\n                                                              </center>\n                                                            )}\n                                                          </td>\n                                                        </tr>\n                                                      );\n                                                    }\n                                                  )}\n                                              </table>\n                                            </div>\n                                          </>\n                                          {this.state.button_status ==\n                                            false && (\n                                            <button\n                                              className=\"download-button\"\n                                              onClick={() => this.documentPay()}\n                                            >\n                                              Pay\n                                            </button>\n                                          )}\n                                          {!this.state.investor_id && (\n                                            <>\n                                              <button\n                                                className=\"download-button\"\n                                                style={{\n                                                  background: \"rgb(41 23 111)\",\n                                                }}\n                                                onClick={() =>\n                                                  window.location.assign(\n                                                    \"/login\"\n                                                  )\n                                                }\n                                              >\n                                                Login to View\n                                              </button>\n                                              {/* <em\n                                            style={{\n                                              fontSize: 14,\n                                              fontWeight: \"700\",\n                                            }}\n                                          >\n                                            Become Growth91\n                                            <sup style={{ fontSize: \"0.6rem\" }}>\n                                              TM\n                                            </sup>{\" \"}\n                                            member to access the document{\" \"}\n                                          </em> */}\n                                            </>\n                                          )}\n                                        </div>\n                                      </div>\n                                      <div className=\"col-lg-2\"></div>\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                            <div className=\"tab-wrapper\">\n                              <div className=\"container\">\n                                <div className=\"row\">\n                                  <div className=\"col-lg-12\">\n                                    <Tabs defaultActiveKey=\"1\" centered>\n                                      <TabPane tab=\"FAQ\" key=\"1\">\n                                        <section\n                                          className=\"faq-section\"\n                                          style={{\n                                            margin: \"0px\",\n                                            padding: \"0px\",\n                                            background: \"none\",\n                                          }}\n                                        >\n                                          <div className=\"\">\n                                            <div className=\"row\">\n                                              <div className=\"col-lg-12 col-md-12 col-sm-12 m-auto\">\n                                                <h1 className=\"text-center mb-4\">\n                                                  About Petmojo \n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['1']}\n                                                  onChange={this.callback1}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"Are you focused on product or service?\"\n                                                    key=\"1\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                          textAlign: \"justify\",\n                                                        }}\n                                                      >\n                                                      The company is focused on delivering high-quality pet care services rather than products. By offering a range of services like grooming, pet sitting, and veterinary care through a convenient, on-demand platform, the company addresses a significant gap in the fragmented pet services market. This focus on services allows the company to provide reliable, hassle-free solutions that build trust and loyalty among pet owners.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What are the challenges for scale up and how these will be managed?\"\n                                                    key=\"2\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                          textAlign: \"justify\",\n                                                        }}\n                                                      >\n                                                      The primary challenge for scaling up is the limited supply of quality service providers, while demand continues to grow. To address this, the company plans to invest ₹1,00,00,000 from its fundraise into the recruitment, training, and upskilling of partners. This investment will help ensure a consistent supply of quality service providers as the company expands into new geographies.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"Are you targeting new untapped market? Justify\"\n                                                    key=\"7\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                          textAlign: \"justify\",\n                                                        }}\n                                                      >\n                                                        Yes, Petmojo is targeting a new untapped market. While the pet care sector is split between products and services, the services sector is highly fragmented with no single comprehensive platform for all pet-related services. Existing players are fragmented, difficult to locate, geographically limited, and face issues related to trust, quality, and reliability. By consolidating these services on a single platform, the company addresses these gaps, tapping into a market that has yet to be fully explored or standardized.\n                                                      </p>\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What are your moats?\"\n                                                    key=\"4\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      <p\n                                                        style={{\n                                                          color: \"#7f7776\",\n                                                          textAlign: \"justify\",\n                                                        }}\n                                                      >\n                                                       High Earnings for Top Partners: The top 30% of partners earn more than ₹50,000 per month, which is 2.5 times the average blue-collar wage in India.\nJob Stability: Top partners have job orders lined up for the next 6 months due to subscription models, providing stability unmatched by other gig economy platforms.\nLow Churn Rate: The churn rate for top-rated partners is approximately 0%, and the overall partner churn rate is only 35% up to month 6. This ensures a reliable supply of high-quality service providers.\nHigh Order Fulfillment Rate: With a fulfillment rate of 99%+ in its operating geographies, customers trust the brand for consistency and reliability.\nBarriers for New Entrants: Entering the pet care market requires sensitivity, pet-focused brand values, and niche expertise, creating friction for other marketplaces like UrbanClap (UC) to enter this space.\n                                                      </p>{\" \"}\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                                <h1 className=\"text-center mb-2 mt-4\">\n                                                  Growth91 Investment FAQ\n                                                </h1>\n                                                <Collapse\n                                                  // defaultActiveKey={['10']}\n                                                  onChange={this.callback3}\n                                                  expandIconPosition=\"left\"\n                                                  accordion\n                                                >\n                                                  <Panel\n                                                    header=\"What is the due diligence process followed by Growth91\"\n                                                    key=\"11\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      At Growth91, we follow\n                                                      stringent due-diligence\n                                                      process. We ask for\n                                                      detailed information about\n                                                      start-up and their team.\n                                                      After the scrutiny and if\n                                                      deemed fit, start-up would\n                                                      be listed on Growth91\n                                                      platform. Independent\n                                                      investment opinion and\n                                                      due-diligence report\n                                                      prepared by external\n                                                      qualified experts are made\n                                                      available for investors.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"Do you offer any guarantee on returns?\"\n                                                    key=\"12\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      No, we do not guarantee\n                                                      any returns. The startup\n                                                      which is raising the money\n                                                      is also not guaranteeing\n                                                      any specific returns. In\n                                                      principle, it is not\n                                                      legally correct for the\n                                                      company to provide any\n                                                      guarantee about returns on\n                                                      equity linked securities.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the refund process in case I don’t receive any allocation?\"\n                                                    key=\"13\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      If an investor doesn’t\n                                                      receive the allocation,\n                                                      the investment amount will\n                                                      be refunded to the bank\n                                                      account from which the\n                                                      investment has been made.\n                                                      As per Growth91 policy,\n                                                      there will be no interest\n                                                      or compensation on these\n                                                      returned funds.\n                                                    </div>\n                                                  </Panel>\n                                                  <Panel\n                                                    header=\"What is the exit mechanism available for the investors\"\n                                                    key=\"14\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      The Company and the\n                                                      Promoters shall make all\n                                                      reasonable endeavours to\n                                                      provide exit to the\n                                                      Investors by any of the\n                                                      following ways: 1. Initial\n                                                      Public Offer (IPO) 2.\n                                                      Merger or Acquisition\n                                                      Event 3. Buyout Event 3.\n                                                      Compulsory Call Option\n                                                      with minimum assured\n                                                      returns. (Please refer to\n                                                      investor agreement for\n                                                      more details)\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"In which account Investor’s money are transferred\"\n                                                    key=\"15\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      Money invested by the\n                                                      investor in all public\n                                                      deals are automatically\n                                                      transferred to separate\n                                                      and dedicated escrow\n                                                      account created for\n                                                      respective Startup. The\n                                                      escrow account is managed\n                                                      by authorized trustee.\n                                                      After the funding/deal and\n                                                      documentation formalities\n                                                      are completed, the fund\n                                                      will be transferred to\n                                                      respective startup bank\n                                                      account.\n                                                    </div>\n                                                  </Panel>\n\n                                                  <Panel\n                                                    header=\"I have more questions; how do I contact Growth91?\"\n                                                    key=\"16\"\n                                                    extra={genExtra()}\n                                                  >\n                                                    <div\n                                                      style={{\n                                                        color: \"#7f7776\",\n                                                      }}\n                                                    >\n                                                      You can always send your\n                                                      queries to{\" \"}\n                                                      <a href=\"mailto:contact@growth91.com\">\n                                                        contact@growth91.com\n                                                      </a>\n                                                      , we will respond to your\n                                                      queries in shortest\n                                                      possible time.\n                                                    </div>\n                                                  </Panel>\n                                                </Collapse>\n                                              </div>\n                                            </div>\n                                          </div>\n                                        </section>\n                                      </TabPane>\n                                    </Tabs>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          {/* stop */}\n                        </TabPane>\n                        <TabPane tab=\"Team\" key=\"3\">\n                          <div\n                            className=\"container meet-the-team-section\"\n                            style={{ maxWidth: 921 }}\n                          >\n                            <h2 className=\"text-center\">Meet the Team</h2>\n                            <div className=\"row elefantteam\">\n                              <div className=\"col-lg-6\">\n                                <div\n                                  className=\"single\"\n                                  style={{ paddingBottom: \"0px !important\" }}\n                                  // style={{  marginBottom: 0px !important}}\n                                >\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Petmojo A/jiten image.jpeg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Jiten Kakar </h3>\n                                      <span>\n                                      Co-Founder & CEO \n                                      </span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/jitenkakar/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                        {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                        <i className=\"bx bxl-gmail\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <ul>\n                                    <li>\n                                      <a>\n                                      B.Tech Delhi college of Engineering DC, MBA (MDI, Gurgaon)\n\n                                      </a>\n                                    </li>\n                                    <li>\n                                      <a>\n                                      8+ years of Corporate Experience\n\n                                      </a>\n                                    </li>\n                                    <li>\n                                      <a>Handles Marketting and Sales in Petmojo</a>\n                                    </li>\n                                  </ul>\n                                </div>\n                              </div>\n                              <div className=\"col-lg-6\">\n                                <div\n                                  className=\"single\"\n                                  style={{ paddingBottom: \"0px !important\" }}\n                                  // style={{  marginBottom: 0px !important}}\n                                >\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/Petmojo A/ishaan khare.jpeg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Ishaan Khare </h3>\n                                      <span>Co-Founder & CTO </span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/ishaan-khare-83a708147/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                        {/* <a href=\"mailto:vaibhav.tambe@transbnk.co.in\">\n                                        <i className=\"bx bxl-gmail\"></i>\n                                        </a> */}\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <ul>\n                                    <li>\n                                      <a>\n                                      B.Tech from BITS Pilani,\n\n                                      </a>\n                                    </li>\n                                    <li>\n                                      <a>\n                                      He was among top 1% in JEE and BITSAT\n\n                                      </a>\n                                    </li>\n                                    <li>\n                                      <a>Handles tech and product development in petmojo </a>\n                                    </li>\n                                  </ul>\n                                </div>\n                              </div>\n\n                          \n\n                              {/* \n                              <div className=\"col-lg-6\">\n                                <div className=\"single\">\n                                  <div className=\"d-flex\">\n                                    <img\n                                      src=\"./assets/images/deals-details/IndusUno/team/Kushal Gupta.jpg\"\n                                      alt=\"\"\n                                    />\n                                    <div className=\"intro\">\n                                      <h3>Kushal Gupta</h3>\n                                      <span>\n                                        Head Engineering and Technology\n                                      </span>\n                                      <div\n                                        className=\"social-icons\"\n                                        style={{\n                                          marginTop: 4,\n                                          marginLeft: -6,\n                                        }}\n                                      >\n                                        <a\n                                          href=\"https://www.linkedin.com/in/logical-kushal-gupta/\"\n                                          target=\"_blank\"\n                                        >\n                                          <i className=\"bx bxl-linkedin\"></i>\n                                        </a>\n                                      </div>\n                                    </div>\n                                  </div>\n                                  <p>\n                                    M.Tech (Computer Science)\n                                    <br />\n                                    10+ Years Experience\n                                  </p>\n                                <