\nimport $ from \"jquery\";\nimport { Link } from 'react-router-dom';\n\nexport const FamilyDashboard = () => {\n    useEffect(() => {\n        window.scrollTo(0, 0)\n    }, [])\n    \n    $(window).scroll(function() {\n        if ($(this).scrollTop() > 30) {\n          $('body').addClass('newClass');\n        } else {\n          $('body').removeClass('newClass');\n        }\n      });\n      function SimpleNextArrow(props) {\n        const { onClick } = props;\n        return (\n          <>\n            <div className=\"nextArrow\" onClick={onClick}>\n              <span class=\"next-arrows slick-arrow\">\n                <i class=\"fa fa-angle-right\" aria-hidden=\"true\"></i>\n              </span>\n            </div>\n          </>\n        );\n      }\n  \n      function SimplePrevArrow(props) {\n        const { onClick } = props;\n        return (\n          <>\n            <div className=\"prevArrow\" onClick={onClick}>\n              <span class=\"prev-arrows slick-arrow\">\n                {\" \"}\n                <i class=\"fa fa-angle-left\" aria-hidden=\"true\"></i>{\" \"}\n              </span>\n            </div>\n          </>\n        );\n      }\n    const sliderSettings={\n        dots: true,\n        infinite: true,\n        arrows: false,\n        speed: 2000,\n        slidesToShow: 1,\n        slidesToScroll: 1,\n        autoplaySpeed: 3000,\n        autoplay: true,\n  \n        prevArrow: <SimplePrevArrow />,\n        nextArrow: <SimpleNextArrow />,\n  \n  \n        responsive: [{\n          breakpoint: 1200,\n          settings: {\n            autoplay: true,\n            slidesToShow: 1,\n            slidesToScroll: 1\n          }\n        }, {\n          breakpoint: 993,\n          settings: {\n            autoplay: true,\n            slidesToShow: 1,\n            slidesToScroll: 1\n          }\n        }, {\n          breakpoint: 600,\n          settings: {\n            autoplay: false,\n            speed: 100,\n            slidesToShow: 1,\n            slidesToScroll: 1\n          }\n        }, {\n          breakpoint: 400,\n          settings: {\n            arrows: false,\n            speed: 100,\n            slidesToShow: 1,\n            slidesToScroll: 1,\n            autoplay: false,\n          }\n        }]\n      }\n      return (\n        <div>\n            <nav class=\"navbar navbar-expand-lg navbar-light fixed-top\">\n                <div class=\"container-fluid\">\n                    <div class=\"d-flex align-items-center\">\n                        <button class=\"navbar-toggler px-1 py-0 mt-1\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" style=\"height: 36px;\"><span class=\"navbar-toggler-icon\"></span></button><a class=\"navbar-brand\" href=\"/deals\"><img src=\"/web/growth91LOGO (4).png\" width=\"120\" class=\"d-inline-block align-top\" alt=\"Growth91\" style=\"position: relative; top: -8px;\" /></a>\n                        <div class=\"d-lg-block d-none\">\n                            <ul class=\"navbar-nav me-auto mb-2 mb-lg-0 \">\n                                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/\">Home</a></li>\n                                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/deals\">Deals</a></li>\n                                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/Founders\">Founders</a></li>\n                                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/resources\">Resources</a></li>\n                                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/Learn\">About us</a></li>\n                                <li class=\"nav-item\"><a class=\"nav-link\" rel=\"noreferrer\" href=\"https://growth91.com/blog/\">Blog</a></li>\n                            </ul>\n                        </div>\n                    </div>\n                    <div cl